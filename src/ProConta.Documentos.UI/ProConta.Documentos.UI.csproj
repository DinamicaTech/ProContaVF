<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pantalla Documentos, diálogo «Vincular a…» y panel Documentos de las fichas (docs/documentos.md, maqueta validada el 2026-11-18). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>ProConta.Documentos.UI</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProConta.UI.Base\ProConta.UI.Base.csproj" />
    <ProjectReference Include="..\ProConta.Documentos\ProConta.Documentos.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Vista previa de los PDF con el visor de WebView2 (el mismo paquete que el visor de compras, aprobado el 2026-11-05). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProConta.Documentos.Tests" />
  </ItemGroup>
</Project>
