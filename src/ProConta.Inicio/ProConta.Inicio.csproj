<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pantalla de inicio (docs/pantalla-de-inicio.md): lecturas y cálculo de los indicadores, sin WPF. Solo lee la BD, salvo el histórico de la salud (HistoricoSalud). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>ProConta.Inicio</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProConta.Nucleo\ProConta.Nucleo.csproj" />
    <ProjectReference Include="..\ProConta.Datos.Persistencia\ProConta.Datos.Persistencia.csproj" />
    <ProjectReference Include="..\ProConta.Contabilidad\ProConta.Contabilidad.csproj" />
    <ProjectReference Include="..\ProConta.Norma43\ProConta.Norma43.csproj" />
    <ProjectReference Include="..\ProConta.Facturacion\ProConta.Facturacion.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProConta.Inicio.Tests" />
  </ItemGroup>
</Project>
