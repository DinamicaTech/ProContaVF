<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pantallas de facturación (docs/facturacion/pantallas.md): Facturas emitidas y editor del borrador, en pestañas del contenedor. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>ProConta.Facturacion.UI</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProConta.UI.Base\ProConta.UI.Base.csproj" />
    <ProjectReference Include="..\ProConta.Facturacion\ProConta.Facturacion.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProConta.Facturacion.Tests" />
  </ItemGroup>
</Project>
