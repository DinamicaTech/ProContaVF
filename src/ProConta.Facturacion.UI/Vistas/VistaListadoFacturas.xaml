<UserControl x:Class="ProConta.Facturacion.UI.Vistas.VistaListadoFacturas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             Background="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Recursos.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding EnfocarBusquedaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera: título, búsqueda y nueva -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Generar programadas" IsEnabled="False" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MotivoProgramadas}" />
          <Button Content="Enviar pendientes a VeriFactu" IsEnabled="False" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MotivoVeriFactu}" />
          <Button Content="Nueva factura" Command="{Binding NuevaCommand}" Style="{StaticResource Boton.Primario}" pc:Iconos.Icono="{StaticResource Icono.plus}"
                  ToolTip="Abre un borrador nuevo sin número en su pestaña" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Facturas emitidas" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <Grid Width="420" VerticalAlignment="Center">
            <TextBox x:Name="CajaBusqueda" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="28,0,6,0"
                     ToolTip="Busca en número, cliente, NIF, descripción, notas y facturas relacionadas (Ctrl+F)" AutomationProperties.Name="Buscar facturas" />
            <Path Style="{StaticResource Icono.Trazo14}" Data="{StaticResource Icono.search}" HorizontalAlignment="Left" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Filtros -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,7">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Boton.Enlace}" Content="Limpiar filtros" Command="{Binding LimpiarFiltrosCommand}" VerticalAlignment="Center"
                Visibility="{Binding HayFiltros, Converter={StaticResource Visible}}" ToolTip="Vacía la búsqueda y quita todos los filtros" />
        <WrapPanel VerticalAlignment="Center">
          <ComboBox Width="190" Margin="0,0,10,0" ItemsSource="{Binding OpcionesEstado}" SelectedItem="{Binding FiltroEstado}" ToolTip="Estado de la factura" />
          <ComboBox Width="170" Margin="0,0,10,0" ItemsSource="{Binding OpcionesVeriFactu}" SelectedItem="{Binding FiltroVeriFactu}" ToolTip="Situación VeriFactu" />
          <ComboBox Width="160" Margin="0,0,10,0" ItemsSource="{Binding OpcionesSerie}" SelectedItem="{Binding FiltroSerie}" ToolTip="Serie de facturación" />
          <ComboBox Width="170" Margin="0,0,14,0" ItemsSource="{Binding OpcionesOrigen}" SelectedItem="{Binding FiltroOrigen}" ToolTip="Manual, programada o rectificativa" />
          <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Texto.Apagado}" />
          <TextBox Width="110" Margin="0,0,10,0" Text="{Binding Desde}" Style="{StaticResource Campo}" ToolTip="Fecha de factura desde (dd/mm/aaaa)" />
          <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Texto.Apagado}" />
          <TextBox Width="110" Margin="0,0,10,0" Text="{Binding Hasta}" Style="{StaticResource Campo}" ToolTip="Fecha de factura hasta (dd/mm/aaaa)" />
          <TextBlock Text="{Binding ErrorFechas}" Foreground="{StaticResource Pincel.RojoError}" VerticalAlignment="Center" />
        </WrapPanel>
      </DockPanel>
    </Border>

    <!-- Programadas: llegan con su desarrollo -->
    <pc:Nota DockPanel.Dock="Top" Tipo="Info" Margin="14,8,14,0">
      <TextBlock TextWrapping="Wrap" Text="Facturas programadas: la sección de programaciones de esta pantalla llega con su propio desarrollo. Hoy se ven y gestionan aquí las facturas emitidas y los borradores." />
    </pc:Nota>

    <!-- Pie -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="Doble clic o Intro abre la factura · la casilla marca para las acciones colectivas" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button Content="Exportar a Excel" pc:Iconos.Icono="{StaticResource Icono.xls}" Command="{Binding ExportarExcelCommand, ElementName=Tabla}" Style="{StaticResource Boton.Pequeno}"
                  ToolTip="Exporta todas las filas de la vista con las columnas visibles, en el mismo orden" />
        </StackPanel>
        <TextBlock Text="{Binding Pie}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="600" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="560" MinWidth="380" />
      </Grid.ColumnDefinitions>

      <!-- Ámbito, acciones y tabla -->
      <DockPanel Grid.Column="0">
        <Border DockPanel.Dock="Top" Padding="14,8" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1">
          <DockPanel>
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="Abrir" Command="{Binding AbrirCommand}" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTip="Abre la factura activa (borrador editable o validada en solo lectura)" />
              <Button Content="Validar…" Command="{Binding ValidarCommand}" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTip="Valida los borradores del ámbito: las marcadas o, si no hay, la activa" />
              <Button Content="Contabilizar" Command="{Binding ContabilizarCommand}" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTip="Genera el asiento de las facturas validadas sin asiento del ámbito" />
              <Button Content="Duplicar" Command="{Binding DuplicarCommand}" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTip="Crea un borrador con el cliente y las líneas de la factura activa" />
              <Button Content="Rectificar…" Command="{Binding RectificarCommand}" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTip="Crea un borrador rectificativo que anula por completo la factura activa" />
              <Button Content="Eliminar borrador" Command="{Binding EliminarCommand}" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTip="Borra el borrador activo; no consume número" />
              <Button Content="PDF" IsEnabled="False" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MotivoPdf}" />
              <Button Content="Enviar" IsEnabled="False" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MotivoEnviar}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding TextoAmbito}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Button Content="Marcar todas" Command="{Binding MarcarTodasCommand}" Style="{StaticResource Boton.Enlace}" Margin="0,0,10,0" ToolTip="Marca todas las facturas que se ven con los filtros actuales" />
              <Button Content="Desmarcar" Command="{Binding DesmarcarCommand}" Style="{StaticResource Boton.Enlace}" ToolTip="Quita todas las marcas: las acciones vuelven a la factura activa" />
            </StackPanel>
          </DockPanel>
        </Border>

        <pc:VistaEstado Estado="{Binding Estado}" Titulo="{Binding TituloEstado}" Mensaje="{Binding MensajeEstado}" TextoAccion="{Binding AccionEstado}" ComandoAccion="{Binding ComandoEstado}">
          <pc:TablaProConta x:Name="Tabla" ItemsSource="{Binding Filas}" SelectedItem="{Binding Activa}" ClavePreferencias="facturacion.emitidas" TituloExportacion="Facturas emitidas"
                            IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="Tabla_MouseDoubleClick" PreviewKeyDown="Tabla_PreviewKeyDown"
                            AutomationProperties.Name="Facturas emitidas">
            <pc:TablaProConta.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="MinHeight" Value="{StaticResource Alto.Fila}" />
                <Setter Property="DetailsVisibility" Value="{Binding Desplegada, Converter={StaticResource Visible}}" />
              </Style>
            </pc:TablaProConta.RowStyle>
            <pc:TablaProConta.RowDetailsTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Pincel.Fondo}" Padding="44,6,12,8">
                  <ItemsControl ItemsSource="{Binding Lineas}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,1">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Descripcion}" />
                          <TextBlock Grid.Column="1" Text="{Binding Cantidad}" Style="{StaticResource Calculado}" />
                          <TextBlock Grid.Column="2" Text="{Binding Precio}" Style="{StaticResource Calculado}" />
                          <TextBlock Grid.Column="3" Text="{Binding Base}" Style="{StaticResource Calculado}" />
                          <TextBlock Grid.Column="4" Text="{Binding Iva}" Style="{StaticResource Calculado}" />
                          <TextBlock Grid.Column="5" Text="{Binding Total}" Style="{StaticResource Calculado}" />
                          <TextBlock Grid.Column="6" Text="{Binding Cuenta}" FontFamily="{StaticResource Fuente.Mono}" Margin="12,0,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </DataTemplate>
            </pc:TablaProConta.RowDetailsTemplate>
            <pc:TablaProConta.Columns>
              <DataGridTemplateColumn Header="" Width="34" pc:TablaProConta.Clave="marca" pc:TablaProConta.SiempreVisible="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Marcada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip="Marca la factura para las acciones colectivas" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="" Width="30" pc:TablaProConta.Clave="desplegar" pc:TablaProConta.SiempreVisible="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ToggleButton IsChecked="{Binding Desplegada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Boton.Desplegar}"
                                  ToolTip="Muestra u oculta las líneas de la factura" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="150" ElementStyle="{StaticResource Texto.Celda.Mono}" pc:TablaProConta.Clave="numero" pc:TablaProConta.SiempreVisible="True" />
              <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" SortMemberPath="FechaOrden" Width="100" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="fecha" />
              <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="300" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="cliente" />
              <DataGridTextColumn Header="NIF" Binding="{Binding Nif}" Width="110" ElementStyle="{StaticResource Texto.Celda.Mono}" pc:TablaProConta.Clave="nif" pc:TablaProConta.OcultaDeFabrica="True" />
              <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" MinWidth="200" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="descripcion" />
              <DataGridTextColumn Header="Base" Binding="{Binding TextoBase}" SortMemberPath="Base" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="base" />
              <DataGridTextColumn Header="Total" Binding="{Binding TextoTotal}" SortMemberPath="Total" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="total" />
              <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="160" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="estado" />
              <DataGridTextColumn Header="VeriFactu" Binding="{Binding VeriFactu}" Width="110" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="verifactu" />
              <DataGridTextColumn Header="Asiento" Binding="{Binding Asiento}" Width="110" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="asiento" />
              <DataGridTextColumn Header="Serie" Binding="{Binding Serie}" Width="90" ElementStyle="{StaticResource Texto.Celda.Mono}" pc:TablaProConta.Clave="serie" pc:TablaProConta.OcultaDeFabrica="True" />
              <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="110" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="origen" pc:TablaProConta.OcultaDeFabrica="True" />
            </pc:TablaProConta.Columns>
          </pc:TablaProConta>
        </pc:VistaEstado>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource Pincel.Linea}" ResizeBehavior="PreviousAndNext"
                    ToolTip="Arrastra para repartir el ancho entre el listado y el detalle" />

      <!-- Detalle de la factura activa -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{StaticResource Pincel.Fondo}">
        <StackPanel Margin="16,14">
          <TextBlock Text="Elige una factura para ver su detalle." Style="{StaticResource Texto.Apagado}" Visibility="{Binding HayDetalle, Converter={StaticResource Visible}, ConverterParameter=invertir}" />
          <StackPanel Visibility="{Binding HayDetalle, Converter={StaticResource Visible}}">
            <WrapPanel>
              <TextBlock Text="{Binding DetalleTitulo}" Style="{StaticResource Texto.Titulo}" Margin="0,0,10,0" />
              <Border Style="{StaticResource Pildora}" Background="{StaticResource Pincel.AcentoSuave}" BorderBrush="{StaticResource Pincel.AcentoBorde}">
                <TextBlock Text="{Binding DetalleEstado}" Style="{StaticResource Texto.Pildora}" />
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding DetalleRelacion}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding DetalleRelacion, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding DetalleFechas}" Style="{StaticResource Texto.Apagado}" Margin="0,4,0,10" />

            <Border Style="{StaticResource Tarjeta.Factura}">
              <StackPanel>
                <TextBlock Text="Cliente" Style="{StaticResource Etiqueta.Campo}" />
                <TextBlock Text="{Binding DetalleCliente}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DetalleNif}" FontFamily="{StaticResource Fuente.Mono}" />
                <TextBlock Text="{Binding DetalleDomicilio}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta.Factura}">
              <StackPanel>
                <TextBlock Text="Descripción" Style="{StaticResource Etiqueta.Campo}" />
                <TextBlock Text="{Binding DetalleDescripcion}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBlock Text="Líneas" Style="{StaticResource Etiqueta.Campo}" />
                <ItemsControl ItemsSource="{Binding DetalleLineas}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Nombre}" TextWrapping="Wrap" />
                          <TextBlock Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}">
                            <Run Text="{Binding Cantidad, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Precio, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Cuenta, Mode=OneWay}" FontFamily="{StaticResource Fuente.Mono}" />
                          </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Iva}" Style="{StaticResource Calculado}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="2" Text="{Binding Total}" Style="{StaticResource Calculado}" VerticalAlignment="Top" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta.Factura}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Base imponible" />
                <TextBlock Grid.Column="1" Text="{Binding DetalleBase}" Style="{StaticResource Texto.Importe}" />
                <TextBlock Grid.Row="1" Text="IVA" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetalleIva}" Style="{StaticResource Texto.Importe}" />
                <TextBlock Grid.Row="2" Text="Retención" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetalleRetencion}" Style="{StaticResource Texto.Importe}" />
                <TextBlock Grid.Row="3" Text="Total a cobrar" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetalleTotal}" Style="{StaticResource Texto.Importe}" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding DetalleAsiento}" Style="{StaticResource Texto.Apagado}" Margin="0,8,0,0" />
              </Grid>
            </Border>

            <Border Style="{StaticResource Tarjeta.Factura}" Visibility="{Binding DetalleNotas, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="Notas internas" Style="{StaticResource Etiqueta.Campo}" />
                <TextBlock Text="{Binding DetalleNotas}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta.Factura}">
              <StackPanel>
                <TextBlock Text="Historial" Style="{StaticResource Etiqueta.Campo}" />
                <ItemsControl ItemsSource="{Binding DetalleHistorial}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontSize="{StaticResource Letra.Pequena}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
