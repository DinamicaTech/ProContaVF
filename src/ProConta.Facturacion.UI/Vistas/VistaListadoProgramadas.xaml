<UserControl x:Class="ProConta.Facturacion.UI.Vistas.VistaListadoProgramadas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             Background="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Recursos.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding EnfocarBusquedaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera: título, búsqueda, generar y nueva -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Generar programadas…" Command="{Binding GenerarCommand}" Margin="0,0,8,0"
                  ToolTip="Elige hasta qué fecha y qué programadas: crea en un lote una factura por cada vencimiento" />
          <Button Content="Nueva programada" Command="{Binding NuevaCommand}" Style="{StaticResource Boton.Primario}" pc:Iconos.Icono="{StaticResource Icono.plus}"
                  ToolTip="Abre una factura programada nueva: la plantilla de la factura y su programación" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Facturas programadas" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <Grid Width="420" VerticalAlignment="Center">
            <TextBox x:Name="CajaBusqueda" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="28,0,6,0"
                     ToolTip="Busca en código, cliente, descripción y notas (Ctrl+F)" AutomationProperties.Name="Buscar facturas programadas" />
            <Path Style="{StaticResource Icono.Trazo14}" Data="{StaticResource Icono.search}" HorizontalAlignment="Left" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
          <ComboBox Width="170" Margin="10,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding OpcionesEstado}" SelectedItem="{Binding FiltroEstado}" ToolTip="Activas, pausadas o finalizadas" />
          <Button Style="{StaticResource Boton.Enlace}" Content="Limpiar filtros" Command="{Binding LimpiarFiltrosCommand}" VerticalAlignment="Center" Margin="10,0,0,0"
                  Visibility="{Binding HayFiltros, Converter={StaticResource Visible}}" ToolTip="Vacía la búsqueda y quita el filtro de estado" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pie -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="Doble clic o Intro abre la programada" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button Content="Exportar a Excel" pc:Iconos.Icono="{StaticResource Icono.xls}" Command="{Binding ExportarExcelCommand, ElementName=Tabla}" Style="{StaticResource Boton.Pequeno}"
                  ToolTip="Exporta todas las filas de la vista con las columnas visibles, en el mismo orden" />
        </StackPanel>
        <TextBlock Text="{Binding Pie}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="600" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="560" MinWidth="380" />
      </Grid.ColumnDefinitions>

      <!-- Acciones y tabla -->
      <DockPanel Grid.Column="0">
        <Border DockPanel.Dock="Top" Padding="14,8" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1">
          <WrapPanel HorizontalAlignment="Right">
            <Button Content="Abrir" Command="{Binding AbrirCommand}" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTip="Abre la programada para verla o cambiarla" />
            <Button Content="Ver sus facturas" Command="{Binding VerFacturasCommand}" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTip="Abre Facturas con las que ha generado esta programada en el ejercicio de trabajo" />
            <Button Content="{Binding TextoPausar}" Command="{Binding PausarCommand}" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTip="{Binding AyudaPausar}" />
            <Button Content="Duplicar" Command="{Binding DuplicarCommand}" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTip="Crea otra programada igual, pausada y sin facturas generadas" />
            <Button Content="Eliminar" Command="{Binding EliminarCommand}" Style="{StaticResource Boton.Pequeno}" Margin="6,0,0,0" ToolTip="Borra la programada si aún no ha generado ninguna factura" />
          </WrapPanel>
        </Border>

        <pc:VistaEstado Estado="{Binding Estado}" Titulo="{Binding TituloEstado}" Mensaje="{Binding MensajeEstado}" TextoAccion="{Binding AccionEstado}" ComandoAccion="{Binding ComandoEstado}">
          <pc:TablaProConta x:Name="Tabla" ItemsSource="{Binding Filas}" SelectedItem="{Binding Activa}" ClavePreferencias="facturacion.programadas" TituloExportacion="Facturas programadas"
                            IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="Tabla_MouseDoubleClick" PreviewKeyDown="Tabla_PreviewKeyDown"
                            AutomationProperties.Name="Facturas programadas">
            <pc:TablaProConta.Columns>
              <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90" ElementStyle="{StaticResource Texto.Celda.Mono}" pc:TablaProConta.Clave="codigo" pc:TablaProConta.SiempreVisible="True" />
              <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="260" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="cliente" />
              <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" MinWidth="200" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="descripcion" />
              <DataGridTextColumn Header="Periodicidad" Binding="{Binding Periodicidad}" Width="110" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="periodicidad" />
              <DataGridTextColumn Header="Próxima" Binding="{Binding Proxima}" SortMemberPath="ProximaOrden" Width="100" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="proxima" />
              <DataGridTextColumn Header="Final" Binding="{Binding Final}" Width="130" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="final" />
              <DataGridTextColumn Header="Generadas" Binding="{Binding TextoGeneradas}" SortMemberPath="Generadas" Width="90" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="generadas" />
              <DataGridTextColumn Header="Total" Binding="{Binding TextoTotal}" SortMemberPath="Total" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="total" />
              <DataGridTextColumn Header="Genera" Binding="{Binding AlGenerar}" Width="80" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="genera" />
              <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="estado" />
            </pc:TablaProConta.Columns>
          </pc:TablaProConta>
        </pc:VistaEstado>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource Pincel.Linea}" ResizeBehavior="PreviousAndNext"
                    ToolTip="Arrastra para repartir el ancho entre el listado y el detalle" />

      <!-- Detalle de la programada activa -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{StaticResource Pincel.Fondo}">
        <StackPanel Margin="16,14">
          <TextBlock Text="Elige una programada para ver su detalle." Style="{StaticResource Texto.Apagado}" Visibility="{Binding HayDetalle, Converter={StaticResource Visible}, ConverterParameter=invertir}" />
          <StackPanel Visibility="{Binding HayDetalle, Converter={StaticResource Visible}}">
            <WrapPanel Margin="0,0,0,10">
              <TextBlock Text="{Binding DetalleTitulo}" Style="{StaticResource Texto.Titulo}" Margin="0,0,10,0" />
              <Border Style="{StaticResource Estado.Marco}" ToolTip="Activa, pausada o finalizada">
                <Border Style="{StaticResource Estado.Segmento}">
                  <TextBlock Text="{Binding DetalleEstado}" Style="{StaticResource Texto.Estado}" />
                </Border>
              </Border>
            </WrapPanel>

            <Border Style="{StaticResource Tarjeta.Factura}">
              <StackPanel>
                <TextBlock Text="Cliente" Style="{StaticResource Etiqueta.Campo}" />
                <TextBlock Text="{Binding DetalleCliente}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DetalleNif}" FontFamily="{StaticResource Fuente.Mono}" />
                <TextBlock Text="{Binding DetalleDomicilio}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta.Factura}">
              <StackPanel>
                <TextBlock Text="Programación" Style="{StaticResource Etiqueta.Campo}" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" /><ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Periodicidad" Style="{StaticResource Texto.Apagado}" />
                  <TextBlock Grid.Column="1" Text="{Binding DetallePeriodicidad}" />
                  <TextBlock Grid.Row="1" Text="Fecha de inicio" Style="{StaticResource Texto.Apagado}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetalleInicio}" />
                  <TextBlock Grid.Row="2" Text="Día de emisión" Style="{StaticResource Texto.Apagado}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetalleDia}" />
                  <TextBlock Grid.Row="3" Text="Final" Style="{StaticResource Texto.Apagado}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetalleFinal}" />
                  <TextBlock Grid.Row="4" Text="Genera" Style="{StaticResource Texto.Apagado}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetalleGenera}" />
                  <TextBlock Grid.Row="5" Text="Envío" Style="{StaticResource Texto.Apagado}" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DetalleEnvio}" />
                </Grid>
                <TextBlock Text="Próximas emisiones" Style="{StaticResource Etiqueta.Campo}" />
                <TextBlock Text="{Binding DetalleProximas}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DetallePeriodo}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding DetalleGeneradas}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta.Factura}">
              <StackPanel>
                <TextBlock Text="Descripción" Style="{StaticResource Etiqueta.Campo}" />
                <TextBlock Text="{Binding DetalleDescripcion}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBlock Text="Líneas" Style="{StaticResource Etiqueta.Campo}" />
                <ItemsControl ItemsSource="{Binding DetalleLineas}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Nombre}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Descripcion}" Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" TextWrapping="Wrap" />
                          <TextBlock Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}">
                            <Run Text="{Binding Cantidad, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Precio, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Cuenta, Mode=OneWay}" FontFamily="{StaticResource Fuente.Mono}" />
                          </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Iva}" Style="{StaticResource Calculado}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="2" Text="{Binding Total}" Style="{StaticResource Calculado}" VerticalAlignment="Top" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta.Factura}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Base imponible" />
                <TextBlock Grid.Column="1" Text="{Binding DetalleBase}" Style="{StaticResource Texto.Importe}" />
                <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding DetalleIvas}" Focusable="False" ToolTip="Cuota de IVA por tipo">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Importe}" Style="{StaticResource Texto.Importe}" />
                        <TextBlock Text="{Binding Texto}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="2" Text="{Binding DetalleTextoRetencion}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetalleRetencion}" Style="{StaticResource Texto.Importe}" />
                <TextBlock Grid.Row="3" Text="Total de cada factura" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetalleTotal}" Style="{StaticResource Texto.Importe}" FontWeight="SemiBold" Margin="0,6,0,0" />
              </Grid>
            </Border>

            <Border Style="{StaticResource Tarjeta.Factura}" Visibility="{Binding DetalleNotas, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="Notas internas" Style="{StaticResource Etiqueta.Campo}" />
                <TextBlock Text="{Binding DetalleNotas}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta.Factura}">
              <StackPanel>
                <TextBlock Text="Historial" Style="{StaticResource Etiqueta.Campo}" />
                <ItemsControl ItemsSource="{Binding DetalleHistorial}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontSize="{StaticResource Letra.Pequena}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
