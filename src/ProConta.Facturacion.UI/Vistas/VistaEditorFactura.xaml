<UserControl x:Class="ProConta.Facturacion.UI.Vistas.VistaEditorFactura"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             xmlns:local="clr-namespace:ProConta.Facturacion.UI.Vistas"
             Background="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Recursos.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:RestaAlturas x:Key="RestaAlturas" />
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F3" Command="{Binding BuscarClienteCommand}" />
    <KeyBinding Key="F2" Command="{Binding AnadirLineaCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera: número o borrador, estado, rectifica a, sin VeriFactu, cliente y fecha -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="18,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding TextoVolver}" Command="{Binding VolverCommand}" Style="{StaticResource Boton.Fantasma}"
                ToolTip="Vuelve al listado sin cerrar esta pestaña" VerticalAlignment="Center" />
        <WrapPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Titulo}" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Border Style="{StaticResource Estado.Marco}" ToolTip="Estado de la factura">
            <Border Style="{StaticResource Estado.Segmento}">
              <TextBlock Text="{Binding TextoEstado}" Style="{StaticResource Texto.Estado}" />
            </Border>
          </Border>
          <Border Style="{StaticResource Pildora}" Visibility="{Binding TextoRectifica, Converter={StaticResource Visible}}"
                  ToolTip="Esta factura rectifica por completo a la original, con los importes en negativo">
            <TextBlock Text="{Binding TextoRectifica}" Style="{StaticResource Texto.Pildora}" />
          </Border>
          <Border Style="{StaticResource Pildora}" Background="{StaticResource Pincel.AvisoSuave}" BorderBrush="{StaticResource Pincel.AvisoBorde}"
                  Visibility="{Binding SinVeriFactu, Converter={StaticResource Visible}}"
                  ToolTip="La validación se ha hecho con el paso provisional: esta factura no se ha enviado a la AEAT. Solo vale en la BD de pruebas.">
            <TextBlock Text="Sin VeriFactu" Style="{StaticResource Texto.Pildora}" />
          </Border>
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="6,0,0,0" />
        </WrapPanel>
      </DockPanel>
    </Border>

    <!-- Pie: acciones -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button Content="{Binding TextoGuardar}" Command="{Binding GuardarCommand}" Style="{StaticResource Boton.Primario}" ToolTip="{Binding AyudaGuardar}" Margin="0,0,8,0" />
          <Button Content="Descartar" Command="{Binding DescartarCommand}" ToolTip="Vuelve a lo último guardado" Margin="0,0,12,0" />
          <TextBlock Text="Cambios sin guardar" FontWeight="SemiBold" Foreground="{StaticResource Pincel.AcentoTexto}" VerticalAlignment="Center"
                     Visibility="{Binding TieneCambios, Converter={StaticResource Visible}}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Duplicar" Command="{Binding DuplicarCommand}" Margin="8,0,0,0" ToolTip="{Binding AyudaDuplicar}" />
          <Button Content="{Binding TextoEliminar}" Command="{Binding EliminarCommand}" Style="{StaticResource Boton.Peligro}" Margin="8,0,0,0"
                  Visibility="{Binding EsBorrador, Converter={StaticResource Visible}}" ToolTip="{Binding AyudaEliminar}" />
          <Button Content="PDF" IsEnabled="False" Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MotivoPdf}"
                  Visibility="{Binding EsValidada, Converter={StaticResource Visible}}" />
          <Button Content="Enviar a VeriFactu" IsEnabled="False" Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MotivoVeriFactu}"
                  Visibility="{Binding EsValidada, Converter={StaticResource Visible}}" />
          <Button Content="Rectificar…" Command="{Binding RectificarCommand}" Style="{StaticResource Boton.Primario}" Margin="8,0,0,0"
                  Visibility="{Binding EsValidada, Converter={StaticResource Visible}}" ToolTip="Crea un borrador rectificativo que anula esta factura por completo" />
          <Button Content="Validar…" Command="{Binding ValidarCommand}" Style="{StaticResource Boton.Primario}" Margin="8,0,0,0"
                  Visibility="{Binding MostrarValidar, Converter={StaticResource Visible}}"
                  ToolTip="Comprueba los datos, asigna el número, copia los datos del cliente y genera el asiento" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid>
      <!-- Error al cargar -->
      <pc:Nota Tipo="Error" Margin="18" VerticalAlignment="Top" Visibility="{Binding ErrorCarga, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding ErrorCarga}" TextWrapping="Wrap" />
      </pc:Nota>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding ErrorCarga, Converter={StaticResource Visible}, ConverterParameter=invertir}">
        <StackPanel Margin="18,14" MinWidth="1180">
          <pc:Nota Tipo="Info" Margin="0,0,0,14" Visibility="{Binding MotivoSoloLectura, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding MotivoSoloLectura}" TextWrapping="Wrap" />
          </pc:Nota>

          <!-- Resumen de errores y avisos -->
          <Border Style="{StaticResource Tarjeta.Factura}" Background="{StaticResource Pincel.RojoSuave}" BorderBrush="{StaticResource Pincel.RojoBorde}"
                  Visibility="{Binding HayIncidencias, Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="{Binding TituloIncidencias}" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding Incidencias}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <WrapPanel Margin="0,2">
                      <TextBlock Text="•  " />
                      <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" MaxWidth="1000" />
                      <Button Content="{Binding TextoAccion}" Command="{Binding Accion}" Style="{StaticResource Boton.Enlace}" Margin="8,0,0,0"
                              Visibility="{Binding TieneAccion, Converter={StaticResource Visible}}" />
                    </WrapPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Arriba: cliente e historial a la izquierda; datos de la factura (y su asiento) a la derecha -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="330" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top">
              <!-- Cliente, compacto -->
              <Border x:Name="TarjetaCliente" Style="{StaticResource Tarjeta.Factura}">
                <StackPanel>
                  <WrapPanel>
                    <TextBlock Text="Cliente" Style="{StaticResource Titulo.Tarjeta}" Margin="0,0,8,6" />
                    <TextBlock Text="{Binding TextoCabeceraCliente}" Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" Margin="0,3,0,6" TextWrapping="Wrap" />
                  </WrapPanel>
                  <StackPanel Visibility="{Binding HayCliente, Converter={StaticResource Visible}}">
                    <DockPanel>
                      <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CuentaClienteCorta}" FontFamily="{StaticResource Fuente.Mono}" ToolTip="{Binding CuentaCliente}" />
                        <Button Content="Asignar…" Command="{Binding AsignarCuentaClienteCommand}" Style="{StaticResource Boton.Enlace}" Margin="6,0,0,0"
                                Visibility="{Binding FaltaCuentaCliente, Converter={StaticResource Visible}}" ToolTip="Asigna o crea la cuenta 430 del cliente en esta sociedad" />
                      </WrapPanel>
                      <TextBlock Text="{Binding NombreCliente}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding NombreCliente}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Texto.Apagado}" Margin="0,2,0,0">
                      <Run Text="{Binding NifCliente, Mode=OneWay}" FontFamily="{StaticResource Fuente.Mono}" /><Run Text="  ·  " /><Run Text="{Binding CodigoCliente, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding DomicilioCliente}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,1,0,0" />
                  </StackPanel>
                  <TextBlock Text="{Binding ErrorCliente}" Foreground="{StaticResource Pincel.RojoError}" TextWrapping="Wrap" Margin="0,4,0,0"
                             Visibility="{Binding ErrorCliente, Converter={StaticResource Visible}}" />
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="{Binding TextoBuscarCliente}" Command="{Binding BuscarClienteCommand}" Style="{StaticResource Boton.Pequeno}" Margin="0,0,12,0"
                            Visibility="{Binding EditableCliente, Converter={StaticResource Visible}}" ToolTip="Busca el cliente por nombre, NIF o Id (F3)" />
                    <Button Content="Ficha del cliente" Command="{Binding AbrirFichaCommand}" Style="{StaticResource Boton.Enlace}" VerticalAlignment="Center"
                            Visibility="{Binding HayCliente, Converter={StaticResource Visible}}" ToolTip="Abre la ficha del tercero en otra pestaña" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- Historial: termina a la altura de «Datos de la factura» y tiene su propio desplazamiento -->
              <Border Style="{StaticResource Tarjeta.Factura}">
                <Border.Height>
                  <MultiBinding Converter="{StaticResource RestaAlturas}" ConverterParameter="14">
                    <Binding ElementName="TarjetaDatos" Path="ActualHeight" />
                    <Binding ElementName="TarjetaCliente" Path="ActualHeight" />
                  </MultiBinding>
                </Border.Height>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Historial" Style="{StaticResource Titulo.Tarjeta}" Margin="0,0,0,6" />
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Historial}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" FontSize="{StaticResource Letra.Pequena}" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </StackPanel>

            <!-- Datos de la factura, con el asiento en otra pestaña -->
            <Border x:Name="TarjetaDatos" Grid.Column="2" Style="{StaticResource Tarjeta.Factura}" VerticalAlignment="Top" Padding="16,4,16,14">
              <TabControl Padding="0,12,0,0" Margin="-12,0,0,0">
                <TabItem Header="Datos de la factura">
                  <StackPanel Margin="12,0,0,0">
                    <CheckBox Content="Periódica" IsChecked="{Binding Periodica}" IsEnabled="{Binding PuedeCambiarPeriodica}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding AyudaPeriodica}"
                              FontWeight="SemiBold" Margin="0,0,0,10" Visibility="{Binding MostrarPeriodica, Converter={StaticResource Visible}}" />
                    <WrapPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}">
                        <TextBlock Text="Serie" Style="{StaticResource Etiqueta.Campo}" />
                        <ComboBox Width="240" ItemsSource="{Binding Series}" SelectedItem="{Binding Serie}" DisplayMemberPath="Rotulo" IsEnabled="{Binding PuedeCambiarSerie}"
                                  ToolTip="Serie con la que se numerará al validar (las rectificativas usan la serie de rectificativas)" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}">
                        <TextBlock Text="Tipo" Style="{StaticResource Etiqueta.Campo}" />
                        <ComboBox Width="240" ItemsSource="{Binding TiposFactura}" SelectedItem="{Binding TipoFactura}" DisplayMemberPath="Rotulo" IsEnabled="{Binding PuedeCambiarSerie}"
                                  ToolTip="Tipo de factura para la AEAT" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}">
                        <TextBlock Text="Número" Style="{StaticResource Etiqueta.Campo}" />
                        <TextBox Width="170" Text="{Binding Numero, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Campo.Mono}" ToolTip="El número lo asigna el programa al validar, nunca a mano" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}" Visibility="{Binding EsFactura, Converter={StaticResource Visible}}">
                        <TextBlock Text="Fecha de factura" Style="{StaticResource Etiqueta.Campo}" />
                        <TextBox Width="110" Text="{Binding FechaFactura, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo}"
                                 ToolTip="Fecha de expedición; si la dejas vacía se pone la de hoy al validar. No puede ser anterior a la última factura de la serie." />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}" Visibility="{Binding EsFactura, Converter={StaticResource Visible}}">
                        <TextBlock Text="Fecha de operación" Style="{StaticResource Etiqueta.Campo}" />
                        <TextBox Width="110" Text="{Binding FechaOperacion, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo}"
                                 ToolTip="Solo si la operación se hizo en una fecha distinta de la de la factura" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}">
                        <TextBlock Text="{Binding EtiquetaPeriodoDesde}" Style="{StaticResource Etiqueta.Campo}" />
                        <TextBox Width="110" Text="{Binding PeriodoDesde, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo}" ToolTip="{Binding AyudaPeriodoDesde}" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}">
                        <TextBlock Text="Hasta" Style="{StaticResource Etiqueta.Campo}" />
                        <TextBox Width="110" Text="{Binding PeriodoHasta, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo}"
                                 ToolTip="{Binding AyudaPeriodoHasta}" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}">
                        <TextBlock Text="Forma de pago" Style="{StaticResource Etiqueta.Campo}" />
                        <ComboBox Width="200" ItemsSource="{Binding FormasPago}" SelectedItem="{Binding FormaPago}" DisplayMemberPath="Descripcion" IsEnabled="{Binding Editable}" ToolTip="Forma de pago pactada" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}">
                        <TextBlock Text="Día de pago" Style="{StaticResource Etiqueta.Campo}" />
                        <TextBox Width="70" Text="{Binding DiaPago, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo.Numero}"
                                 ToolTip="Día del mes previsto para el pago; vacío si no hay día fijo" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}">
                        <TextBlock Text="Retención %" Style="{StaticResource Etiqueta.Campo}" />
                        <TextBox Width="80" Text="{Binding Retencion, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo.Numero}"
                                 ToolTip="Porcentaje de retención IRPF sobre la base (sin suplidos); 0 si no hay" />
                      </StackPanel>
                    </WrapPanel>
                    <StackPanel Style="{StaticResource Bloque.Campo}" Visibility="{Binding EsRectificativa, Converter={StaticResource Visible}}">
                      <TextBlock Text="Motivo de la rectificación" Style="{StaticResource Etiqueta.Campo}" />
                      <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo.Multilinea}"
                               MaxLength="255" ToolTip="Por qué se anula la factura original. Queda en la rectificativa y en el historial de las dos facturas." />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Bloque.Campo}">
                      <TextBlock Text="Descripción general" Style="{StaticResource Etiqueta.Campo}" />
                      <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo.Multilinea}"
                               MinHeight="{StaticResource Alto.Campo}" Padding="6,3" VerticalContentAlignment="Center" MaxLength="500" ToolTip="Qué se factura, en una frase. Va a la AEAT y encabeza el PDF." />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                      <TextBlock Text="Notas internas" Style="{StaticResource Etiqueta.Campo}" />
                      <TextBox Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding NotasSoloLectura}" Style="{StaticResource Campo.Multilinea}" MinHeight="44"
                               ToolTip="Solo para uso interno: no salen en la factura ni van a la AEAT. Se pueden cambiar también en una factura validada." />
                    </StackPanel>
                  </StackPanel>
                </TabItem>
                <TabItem Header="Programación" Visibility="{Binding EsProgramada, Converter={StaticResource Visible}}">
                  <StackPanel Margin="12,0,0,0">
                    <WrapPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}">
                        <TextBlock Text="Periodicidad" Style="{StaticResource Etiqueta.Campo}" />
                        <ComboBox Width="220" ItemsSource="{Binding Periodicidades}" SelectedItem="{Binding PeriodicidadElegida}" DisplayMemberPath="Texto" IsEnabled="{Binding Editable}"
                                  ToolTip="Cada cuánto se emite una factura; «Una sola vez» emite solo la primera" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}">
                        <TextBlock Text="Fecha de inicio" Style="{StaticResource Etiqueta.Campo}" />
                        <TextBox Width="110" Text="{Binding FechaInicioProgramacion, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo}"
                                 ToolTip="Desde esta fecha se emite la primera factura, el primer día de emisión que llegue (dd/mm/aaaa)" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}">
                        <TextBlock Text="Día de emisión" Style="{StaticResource Etiqueta.Campo}" />
                        <TextBox Width="70" Text="{Binding DiaEmision, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo.Numero}"
                                 ToolTip="Día del mes en que se emite (1 a 31). Del 29 al 31 cuentan desde el final del mes: 31 es siempre el último día y 30 el penúltimo. Vacío: el día de la fecha de inicio" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}">
                        <TextBlock Text="Final" Style="{StaticResource Etiqueta.Campo}" />
                        <ComboBox Width="210" ItemsSource="{Binding OpcionesFinal}" SelectedIndex="{Binding TipoFinal}" IsEnabled="{Binding Editable}"
                                  ToolTip="Cuándo deja de emitir: nunca, después de una fecha o tras un número de facturas" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}" Visibility="{Binding FinPorFecha, Converter={StaticResource Visible}}">
                        <TextBlock Text="Última fecha" Style="{StaticResource Etiqueta.Campo}" />
                        <TextBox Width="110" Text="{Binding FechaFinProgramacion, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo}"
                                 ToolTip="No se emite ninguna factura después de esta fecha (dd/mm/aaaa)" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Bloque.Campo}" Visibility="{Binding FinPorRepeticiones, Converter={StaticResource Visible}}">
                        <TextBlock Text="Nº de facturas" Style="{StaticResource Etiqueta.Campo}" />
                        <TextBox Width="70" Text="{Binding Repeticiones, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo.Numero}"
                                 ToolTip="Cuántas facturas emite en total, contando las ya generadas" />
                      </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding TextoProximas}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding TextoPeriodoProximo}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TextoGeneradas}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <TextBlock Text="En cada vencimiento genera" Style="{StaticResource Etiqueta.Campo}" />
                    <WrapPanel Margin="0,0,0,10">
                      <RadioButton Content="Un borrador" IsChecked="{Binding AlGenerarBorrador}" IsEnabled="{Binding Editable}" Margin="0,0,18,0" GroupName="AlGenerar"
                                   ToolTip="La factura queda como borrador sin número, para revisarla y validarla después" />
                      <RadioButton Content="Una factura validada" IsChecked="{Binding AlGenerarValidar}" IsEnabled="{Binding Editable}" GroupName="AlGenerar"
                                   ToolTip="La factura se numera, se valida y se contabiliza al generarla; si algo lo impide, queda como borrador y se avisa" />
                    </WrapPanel>
                    <CheckBox Content="Enviarla por correo al cliente después de validarla" IsChecked="{Binding EnviarPorEmail}" IsEnabled="{Binding Editable}" Margin="0,0,0,2"
                              ToolTip="Preferencia de envío de esta programada: el proceso automático solo envía las que la tienen marcada" />
                    <TextBlock Text="{Binding MotivoEnvio}" Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" TextWrapping="Wrap" Margin="20,0,0,10" />
                    <CheckBox Content="Activa" IsChecked="{Binding Activa}" IsEnabled="{Binding Editable}"
                              ToolTip="Solo las activas generan facturas. Una pausada se puede guardar incompleta; para activarla tiene que estar completa, como para validar una factura" />
                  </StackPanel>
                </TabItem>
                <TabItem Header="Asiento">
                  <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{Binding NumeroAsiento}" Style="{StaticResource Texto.Apagado}" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Cuenta" Style="{StaticResource Cabecera.Linea}" />
                      <TextBlock Grid.Column="1" Text="Concepto" Style="{StaticResource Cabecera.Linea}" />
                      <TextBlock Grid.Column="2" Text="Debe" Style="{StaticResource Cabecera.Linea}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="Haber" Style="{StaticResource Cabecera.Linea}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Asiento}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CuentaApunte" Text="{Binding Cuenta}" FontFamily="{StaticResource Fuente.Mono}" />
                            <TextBlock Grid.Column="1" Text="{Binding Concepto}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Concepto}" Margin="4,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Debe}" Style="{StaticResource Calculado}" />
                            <TextBlock Grid.Column="3" Text="{Binding Haber}" Style="{StaticResource Calculado}" />
                          </Grid>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding FaltaCuenta}" Value="True">
                              <Setter TargetName="CuentaApunte" Property="Foreground" Value="{StaticResource Pincel.RojoError}" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Un asiento por factura, con fecha del día en que se genera. Si la factura se vuelve a contabilizar, se sustituye: nunca se duplica. Las cuentas en rojo faltan."
                               Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" TextWrapping="Wrap" Margin="0,8,0,0" />
                  </StackPanel>
                </TabItem>
              </TabControl>
            </Border>
          </Grid>

          <!-- Líneas, a todo el ancho -->
          <Border Style="{StaticResource Tarjeta.Factura}">
            <StackPanel>
              <pc:Nota Tipo="Info" Margin="0,0,0,10" Visibility="{Binding AvisoRectificativa, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding AvisoRectificativa}" TextWrapping="Wrap" />
              </pc:Nota>
              <TextBlock Text="{Binding ErrorLineas}" Foreground="{StaticResource Pincel.RojoError}" Margin="0,0,0,8" Visibility="{Binding ErrorLineas, Converter={StaticResource Visible}}" />

              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30" /><ColumnDefinition Width="240" /><ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="96" /><ColumnDefinition Width="70" /><ColumnDefinition Width="96" /><ColumnDefinition Width="64" /><ColumnDefinition Width="84" /><ColumnDefinition Width="96" /><ColumnDefinition Width="70" /><ColumnDefinition Width="84" /><ColumnDefinition Width="46" /><ColumnDefinition Width="100" /><ColumnDefinition Width="180" /><ColumnDefinition Width="104" /><ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" Style="{StaticResource Cabecera.Linea}" />
                <TextBlock Grid.Column="1" Text="Concepto" Style="{StaticResource Cabecera.Linea}" />
                <TextBlock Grid.Column="2" Text="Descripción" Style="{StaticResource Cabecera.Linea}" />
                <TextBlock Grid.Column="3" Text="Fecha" Style="{StaticResource Cabecera.Linea}" ToolTip="Fecha de entrega o consumo de la línea (por ejemplo, la entrada de un alquiler turístico); opcional" />
                <TextBlock Grid.Column="4" Text="Cantidad" Style="{StaticResource Cabecera.Linea}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="Precio" Style="{StaticResource Cabecera.Linea}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="6" Text="Dto. %" Style="{StaticResource Cabecera.Linea}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="7" Text="Dto. €" Style="{StaticResource Cabecera.Linea}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="8" Text="Base" Style="{StaticResource Cabecera.Linea}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="9" Text="IVA %" Style="{StaticResource Cabecera.Linea}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="10" Text="Cuota" Style="{StaticResource Cabecera.Linea}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="11" Text="Supl." Style="{StaticResource Cabecera.Linea}" ToolTip="Suplido: fuera de IVA y retención" />
                <TextBlock Grid.Column="12" Text="Cuenta" Style="{StaticResource Cabecera.Linea}" />
                <TextBlock Grid.Column="13" Text="Centro de coste" Style="{StaticResource Cabecera.Linea}" ToolTip="Analítica de la línea: viene del concepto y la puedes cambiar al emitir" />
                <TextBlock Grid.Column="14" Text="Total" Style="{StaticResource Cabecera.Linea}" HorizontalAlignment="Right" ToolTip="Puedes escribir aquí el total con IVA y el programa calcula la base" />
              </Grid>
              <Rectangle Height="1" Fill="{StaticResource Pincel.Linea}" Margin="0,0,0,4" />
              <TextBlock Text="Sin líneas. Añade la primera con «Añadir línea…» (F2)." Style="{StaticResource Texto.Apagado}" HorizontalAlignment="Center" Margin="0,14"
                         Visibility="{Binding SinLineas, Converter={StaticResource Visible}}" />
              <ItemsControl ItemsSource="{Binding Lineas}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.InputBindings>
                        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding DataContext.SubirLineaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding DataContext.BajarLineaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                      </Grid.InputBindings>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" /><ColumnDefinition Width="240" /><ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="96" /><ColumnDefinition Width="70" /><ColumnDefinition Width="96" /><ColumnDefinition Width="64" /><ColumnDefinition Width="84" /><ColumnDefinition Width="96" /><ColumnDefinition Width="70" /><ColumnDefinition Width="84" /><ColumnDefinition Width="46" /><ColumnDefinition Width="100" /><ColumnDefinition Width="180" /><ColumnDefinition Width="104" /><ColumnDefinition Width="86" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Numero}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Top" Margin="4,6,0,0" />
                      <TextBox Grid.Column="1" Margin="2,0" VerticalAlignment="Top" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo}"
                               MaxLength="255" ToolTip="Nombre visible de la línea; se copia del concepto y lo puedes cambiar" />
                      <TextBox Grid.Column="2" Margin="2,0" VerticalAlignment="Top" Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo.Multilinea}" MinHeight="{StaticResource Alto.Campo}" Padding="6,3" VerticalContentAlignment="Center"
                               ToolTip="Descripción ampliada que sale debajo del nombre; crece con el texto" />
                      <TextBox Grid.Column="3" Margin="2,0" VerticalAlignment="Top" Text="{Binding Fecha, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo}"
                               ToolTip="Fecha de entrega o consumo (dd/mm/aaaa); déjala vacía si no corresponde" />
                      <TextBox Grid.Column="4" Margin="2,0" VerticalAlignment="Top" Text="{Binding Cantidad, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo.Numero}" ToolTip="Unidades facturadas" />
                      <TextBox Grid.Column="5" Margin="2,0" VerticalAlignment="Top" Text="{Binding Precio, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo.Numero}" ToolTip="Precio por unidad antes de descuentos (hasta 4 decimales)" />
                      <TextBox Grid.Column="6" Margin="2,0" VerticalAlignment="Top" Text="{Binding DescuentoPorcentaje, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo.Numero}" ToolTip="Descuento en porcentaje; se aplica antes que el descuento fijo" />
                      <TextBox Grid.Column="7" Margin="2,0" VerticalAlignment="Top" Text="{Binding DescuentoImporte, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo.Importe}" ToolTip="Descuento fijo en euros, después del porcentaje" />
                      <TextBlock Grid.Column="8" Text="{Binding Base}" Style="{StaticResource Calculado}" VerticalAlignment="Top" Margin="4,6,4,0" ToolTip="Base imponible de la línea, redondeada a céntimos" />
                      <ComboBox Grid.Column="9" Margin="2,0" VerticalAlignment="Top" ItemsSource="{Binding TiposIva}" SelectedItem="{Binding TipoIva, ValidatesOnNotifyDataErrors=True}" IsEnabled="{Binding PuedeCambiarIva}"
                                ItemStringFormat="0.##" ToolTip="Tipo de IVA de la línea (un suplido no lleva IVA)" />
                      <TextBlock Grid.Column="10" Text="{Binding Cuota}" Style="{StaticResource Calculado}" VerticalAlignment="Top" Margin="4,6,4,0" />
                      <CheckBox Grid.Column="11" IsChecked="{Binding EsSuplido}" IsEnabled="{Binding Editable}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                                ToolTip="Suplido: importe pagado en nombre del cliente; va al total pero no lleva IVA ni retención" />
                      <TextBox Grid.Column="12" Margin="2,0" VerticalAlignment="Top" Text="{Binding Cuenta, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}"
                               Style="{StaticResource Campo.Mono}" ToolTip="Cuenta de ingreso (o de suplidos) de la línea; viene del concepto" />
                      <ComboBox Grid.Column="13" Margin="2,0" VerticalAlignment="Top" ItemsSource="{Binding CentrosCoste}" SelectedItem="{Binding CentroCoste}" DisplayMemberPath="Rotulo" IsEnabled="{Binding Editable}"
                                ToolTip="Centro de coste (analítica) de la línea; viene del concepto y lo puedes cambiar" />
                      <TextBox Grid.Column="14" Margin="2,0" VerticalAlignment="Top" Text="{Binding Total, ValidatesOnNotifyDataErrors=True}" IsReadOnly="{Binding SoloLectura}" Style="{StaticResource Campo.Importe}"
                               ToolTip="Total con IVA. Si lo escribes, se calcula la base y la cuota conservando este total" />
                      <StackPanel Grid.Column="15" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,4,0,0" Visibility="{Binding Editable, Converter={StaticResource Visible}}">
                        <Button Content="↑" Style="{StaticResource Boton.Icono}" Width="22" Height="22" Margin="0,0,2,0"
                                Command="{Binding DataContext.SubirLineaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Sube la línea un puesto (Alt+↑)" />
                        <Button Content="↓" Style="{StaticResource Boton.Icono}" Width="22" Height="22" Margin="0,0,2,0"
                                Command="{Binding DataContext.BajarLineaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Baja la línea un puesto (Alt+↓)" />
                        <Button Style="{StaticResource Boton.Aspa}"
                                Command="{Binding DataContext.QuitarLineaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Quita esta línea" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Añadir línea…" Command="{Binding AnadirLineaCommand}" Style="{StaticResource Boton.Pequeno}" pc:Iconos.Icono="{StaticResource Icono.plus}"
                      HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding EditableLineas, Converter={StaticResource Visible}}"
                      ToolTip="Añade una línea eligiendo un concepto del catálogo de la sociedad (F2)" />
            </StackPanel>
          </Border>

          <!-- Totales, en las columnas de las líneas -->
          <Border Style="{StaticResource Tarjeta.Factura}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" /><ColumnDefinition Width="240" /><ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="96" /><ColumnDefinition Width="70" /><ColumnDefinition Width="96" /><ColumnDefinition Width="64" /><ColumnDefinition Width="84" /><ColumnDefinition Width="96" /><ColumnDefinition Width="70" /><ColumnDefinition Width="84" /><ColumnDefinition Width="46" /><ColumnDefinition Width="100" /><ColumnDefinition Width="180" /><ColumnDefinition Width="104" /><ColumnDefinition Width="86" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.ColumnSpan="2" Text="Totales" Style="{StaticResource Titulo.Tarjeta}" Margin="0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="8" Text="{Binding TotalBase}" Style="{StaticResource Texto.Importe}" Margin="4,0" ToolTip="Base imponible (sin suplidos)" />
              <TextBlock Grid.Column="10" Text="{Binding TotalIva}" Style="{StaticResource Texto.Importe}" Margin="4,0" ToolTip="Cuotas de IVA" />
              <TextBlock Grid.Column="14" Text="{Binding TotalBruto}" Style="{StaticResource Texto.Importe}" Margin="4,0" ToolTip="Base, IVA y suplidos" />

              <!-- Desglose por tipo, solo si hay más de un tipo de IVA -->
              <ItemsControl Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Desglose}" Margin="0,6,0,0"
                            Visibility="{Binding HayVariosIva, Converter={StaticResource Visible}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}">
                      <Run Text="{Binding Tipo, Mode=OneWay, StringFormat=IVA {0}}" /><Run Text=" · base " /><Run Text="{Binding Base, Mode=OneWay}" /><Run Text=" · cuota " /><Run Text="{Binding Cuota, Mode=OneWay}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Grid.Row="1" Grid.Column="8" Grid.ColumnSpan="5" Text="Suplidos (fuera de la base)" Style="{StaticResource Texto.Apagado}" HorizontalAlignment="Right" Margin="0,4,8,0"
                         Visibility="{Binding HaySuplidos, Converter={StaticResource Visible}}" />
              <TextBlock Grid.Row="1" Grid.Column="14" Text="{Binding TotalSuplidos}" Style="{StaticResource Texto.Importe}" Margin="4,4,4,0"
                         Visibility="{Binding HaySuplidos, Converter={StaticResource Visible}}" />
              <TextBlock Grid.Row="2" Grid.Column="8" Grid.ColumnSpan="5" Text="{Binding TextoRetencion}" Style="{StaticResource Texto.Apagado}" HorizontalAlignment="Right" Margin="0,4,8,0"
                         Visibility="{Binding HayRetencion, Converter={StaticResource Visible}}" />
              <TextBlock Grid.Row="2" Grid.Column="14" Text="{Binding TotalRetencion}" Style="{StaticResource Texto.Importe}" Margin="4,4,4,0"
                         Visibility="{Binding HayRetencion, Converter={StaticResource Visible}}" />
              <Border Grid.Row="3" Grid.Column="14" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                <TextBlock Text="{Binding TotalACobrar}" Style="{StaticResource Texto.Importe}" FontWeight="SemiBold" FontSize="{StaticResource Letra.Destacada}" Margin="4,0"
                           ToolTip="Total a cobrar: bruto menos retención" />
              </Border>
              <TextBlock Grid.Row="3" Grid.Column="8" Grid.ColumnSpan="5" Text="Total a cobrar" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,0" />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
