<Window x:Class="ProConta.App.VentanaEntorno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProContaVF · Elige el entorno"
        Style="{StaticResource Ventana.ProConta}"
        Width="960" Height="640" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterScreen" Background="White"
        BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="1"
        MouseLeftButtonDown="Ventana_MouseLeftButtonDown" PreviewKeyDown="Ventana_PreviewKeyDown">
  <Window.Resources>
    <!-- Tarjeta de entorno: botón sin el alto fijo del estilo general, con el color del entorno al estar elegida. -->
    <Style x:Key="Tarjeta.Entorno" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Pincel.Linea}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Halo" CornerRadius="10" Margin="-3" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed" />
              <Border x:Name="Caja" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsDefault" Value="True">
                <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsDefault" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Caja" Property="Background" Value="{StaticResource Pincel.Hover}" />
                <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource Pincel.HoverBorde}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="380" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Franja de marca, la misma que en el acceso, con el resumen del entorno elegido -->
    <Border Grid.Column="0" Background="{StaticResource Pincel.Marino}" Padding="36,36,36,28" ClipToBounds="True">
      <Grid>
        <Canvas IsHitTestVisible="False">
          <Ellipse Canvas.Left="200" Canvas.Top="150" Width="360" Height="360" Stroke="#14FFFFFF" StrokeThickness="1" />
          <Ellipse Canvas.Left="130" Canvas.Top="80" Width="500" Height="500" Stroke="{StaticResource Pincel.Acento}" Opacity="0.22" StrokeThickness="1" />
          <Rectangle x:Name="CuadroColor" Canvas.Left="226" Canvas.Top="314" Width="36" Height="36" RadiusX="9" RadiusY="9" Fill="{StaticResource Pincel.Acento}" Opacity="0.9" />
        </Canvas>
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
              <Border Width="34" Height="34" CornerRadius="8" Background="White">
                <TextBlock Text="pc" FontFamily="{StaticResource Fuente.Titulo}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Pincel.Marino}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="ProConta" Margin="12,0,0,0" FontFamily="{StaticResource Fuente.Titulo}" FontWeight="Bold" FontSize="22" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Contabilidad y facturación" Margin="0,14,0,0" Foreground="#AEB8CC" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="VAS A TRABAJAR EN" FontSize="{StaticResource Letra.Mini}" FontWeight="SemiBold" Foreground="#AEB8CC" Margin="0,0,0,10" />
            <Border CornerRadius="8" Background="#12FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="ENTORNO" FontSize="{StaticResource Letra.Mini}" Foreground="#AEB8CC" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <Ellipse x:Name="PuntoResumen" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock x:Name="ResumenEntorno" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border CornerRadius="8" Background="#12FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="BASE DE DATOS" FontSize="{StaticResource Letra.Mini}" Foreground="#AEB8CC" />
                <TextBlock x:Name="ResumenRuta" Foreground="White" FontFamily="{StaticResource Fuente.Mono}" FontSize="{StaticResource Letra.Pequena}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <TextBlock Text="Operador: sin identificar" Foreground="#AEB8CC" Margin="0,6,0,0" />
            <TextBlock x:Name="TextoVersion" Foreground="#7E8AA3" FontSize="{StaticResource Letra.Mini}" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="Versión del programa (rama, número de cambios y commit)" />
          </StackPanel>
          <Border />
        </DockPanel>
      </Grid>
    </Border>

    <DockPanel Grid.Column="1" Margin="56,56,56,40">
      <Grid DockPanel.Dock="Bottom">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="↑ ↓ o el número para elegir" Foreground="{StaticResource Pincel.Apagado2}"
                   FontSize="{StaticResource Letra.Pequena}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        <Button Grid.Column="1" Content="Salir" MinWidth="90" Click="Salir_Click" ToolTip="Cierra ProContaVF sin entrar (Esc)" />
        <Button x:Name="BotonEntrar" Grid.Column="2" MinWidth="170" Margin="10,0,0,0" Style="{StaticResource Boton.Primario}" Click="Entrar_Click" />
      </Grid>

      <StackPanel>
        <TextBlock Text="Elige el entorno" Style="{StaticResource Texto.TituloPantalla}" />
        <TextBlock Text="Cada entorno es una base de datos distinta. Lo que hagas en uno no aparece en los demás." Margin="0,6,0,0"
                   Foreground="{StaticResource Pincel.Apagado}" TextWrapping="Wrap" />
        <TextBlock Text="ENTORNOS DE ESTE PUESTO" Style="{StaticResource Texto.SeccionAcceso}" Margin="0,30,0,12" />
        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" Padding="3" Margin="-3">
          <StackPanel x:Name="ListaEntornos" />
        </ScrollViewer>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
