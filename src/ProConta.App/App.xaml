<Application x:Class="ProConta.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ProConta.UI.Base;component/Themes/ProConta.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- La biblioteca no trae estilo para PasswordBox: el mismo aspecto que los campos de texto. -->
      <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Pincel.CampoFondo}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pincel.CampoBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Height" Value="{StaticResource Alto.Campo}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}" />
        <Setter Property="FontSize" Value="{StaticResource Letra.Normal}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="PasswordBox">
              <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radio.Campo}">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.Marino}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Borde" Property="Opacity" Value="0.6" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Etiqueta.Campo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Letra.Secundaria}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>

      <Style x:Key="Texto.SeccionAcceso" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Letra.Mini}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
        <Setter Property="Margin" Value="0,18,0,10" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
