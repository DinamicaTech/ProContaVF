<Window x:Class="ProConta.App.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pc="urn:proconta-ui"
        Title="ProContaVF"
        Style="{StaticResource Ventana.ProConta}"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640" WindowState="Maximized">
  <Window.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="M" Modifiers="Ctrl+Shift" Command="{Binding AlternarNavegacionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    <KeyBinding Key="G" Modifiers="Ctrl" Command="{Binding GuardarActivaCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding GuardarActivaCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    <KeyBinding Key="F4" Modifiers="Ctrl" Command="{Binding CerrarActivaCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
  </Window.InputBindings>

  <DockPanel>
    <!-- Cabecera: marca, contexto de trabajo y operador -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Pincel.Marino}" Height="44" Padding="12,0">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource Pincel.Acento}">
            <TextBlock Text="P" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="ProConta" Foreground="White" FontFamily="{StaticResource Fuente.Titulo}" FontWeight="Bold" FontSize="16" Margin="8,0,16,0" VerticalAlignment="Center" />
          <Border CornerRadius="6" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="10,4" VerticalAlignment="Center"
                  ToolTip="Sociedad y ejercicio de trabajo. Cambiarlos sin volver a entrar llegará en una próxima versión.">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icono.Trazo12}" Data="{StaticResource Icono.bank}" Stroke="#AEB8CC" VerticalAlignment="Center" />
              <TextBlock x:Name="TextoSociedad" Foreground="White" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
              <Rectangle Width="1" Fill="#33FFFFFF" Margin="12,2" />
              <Path Style="{StaticResource Icono.Trazo12}" Data="{StaticResource Icono.cal}" Stroke="#AEB8CC" VerticalAlignment="Center" />
              <TextBlock x:Name="TextoEjercicio" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
              <Rectangle Width="1" Fill="#33FFFFFF" Margin="12,2" />
              <!-- Trimestre contable activo (compras/pantallas 2026-11-06 12:10): pulsarlo permite cerrarlo o reactivar el anterior. -->
              <TextBlock x:Name="TextoTrimestre" Foreground="White" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="AlPulsarTrimestre"
                         ToolTip="Trimestre contable activo: el que se está contabilizando. Púlsalo para cerrarlo y activar el siguiente" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
          <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Pincel.Acento}" VerticalAlignment="Center">
            <TextBlock x:Name="TextoIniciales" Foreground="White" FontWeight="Bold" FontSize="{StaticResource Letra.Mini}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="TextoOperador" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Operador con el que has entrado" />
        </StackPanel>
        <Border />
      </DockPanel>
    </Border>

    <!-- Barra de estado: datos, esquema, pantallas abiertas, avisos y versión (siempre visible) -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Pincel.Fondo}" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel>
        <TextBlock x:Name="TextoVersion" DockPanel.Dock="Right" Foreground="{StaticResource Pincel.Apagado}" FontSize="{StaticResource Letra.Pequena}"
                   ToolTip="Versión del programa: rama, número de cambios y commit" />
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Fill="{StaticResource Pincel.Verde}" VerticalAlignment="Center" />
          <TextBlock x:Name="TextoDatos" Margin="6,0,0,0" FontSize="{StaticResource Letra.Pequena}" Foreground="{StaticResource Pincel.Apagado}" />
          <TextBlock x:Name="TextoEsquema" Margin="16,0,0,0" FontSize="{StaticResource Letra.Pequena}" Foreground="{StaticResource Pincel.Apagado}"
                     ToolTip="Versión de la estructura de la base de datos" />
          <Rectangle Width="1" Fill="{StaticResource Pincel.Linea}" Margin="12,2" />
          <TextBlock x:Name="TextoPantallas" FontSize="{StaticResource Letra.Pequena}" Foreground="{StaticResource Pincel.Apagado}"
                     ToolTip="Pantallas abiertas en el área de trabajo y cuántas tienen cambios sin guardar" />
          <Ellipse x:Name="PuntoCambios" Width="7" Height="7" Fill="{StaticResource Pincel.Acento2}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
          <TextBlock x:Name="TextoAviso" Margin="16,0,0,0" FontSize="{StaticResource Letra.Pequena}" Foreground="{StaticResource Pincel.Tinta}" TextTrimming="CharacterEllipsis" MaxWidth="1400" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ColumnaNavegacion" Width="228" MinWidth="0" MaxWidth="420" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Navegación lateral -->
      <Border Grid.Column="0" Background="{StaticResource Pincel.Marino}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="Navegacion" Margin="8,10" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding Comando}" ToolTip="{Binding Ayuda}" Cursor="Hand" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Titulo}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Fila" CornerRadius="6" Padding="10,7" Margin="0,1" Background="Transparent">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fila" Property="Background" Value="#1FFFFFFF" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Fila" Property="Background" Value="#2BFFFFFF" /></Trigger>
                        <DataTrigger Binding="{Binding Activa}" Value="True"><Setter TargetName="Fila" Property="Background" Value="{StaticResource Pincel.Acento}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Disponible}" Value="False"><Setter TargetName="Fila" Property="Opacity" Value="0.55" /></DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                  <StackPanel Orientation="Horizontal" Margin="{Binding Sangria}">
                    <Path Style="{StaticResource Icono.Trazo}" Data="{Binding Icono}" Stroke="#C9D1E0" Width="24" Height="24" Visibility="{Binding Icono, Converter={StaticResource Visible}}">
                      <Path.LayoutTransform><ScaleTransform ScaleX="0.75" ScaleY="0.75" /></Path.LayoutTransform>
                    </Path>
                    <Ellipse Width="5" Height="5" Fill="{StaticResource Pincel.Acento}" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding EsHija, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Titulo}" Foreground="#E6EAF2" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="{Binding Peso}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Separador: se arrastra para cambiar el ancho; doble clic o Ctrl+Mayús+M oculta o muestra el menú -->
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="{StaticResource Pincel.Linea}"
                    MouseDoubleClick="Separador_MouseDoubleClick" Cursor="SizeWE"
                    ToolTip="Arrastra para cambiar el ancho del menú; doble clic o Ctrl+Mayús+M para ocultarlo o mostrarlo" />

      <!-- Área de trabajo con pestañas -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Background="{StaticResource Pincel.Fondo2}" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1">
          <ItemsControl x:Name="TiraPestanas" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Pestana" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,1,0" Background="Transparent" Cursor="Hand" ToolTip="{Binding Ayuda}"
                        MouseLeftButtonUp="Pestana_MouseLeftButtonUp" MouseDown="Pestana_MouseDown">
                  <Grid>
                    <Border x:Name="Marca" Height="2" VerticalAlignment="Top" Background="Transparent" />
                    <StackPanel Orientation="Horizontal" Margin="12,8,8,8">
                      <Path Style="{StaticResource Icono.Trazo12}" Data="{Binding Icono}" VerticalAlignment="Center" Margin="0,0,7,0" />
                      <TextBlock x:Name="Texto" Text="{Binding Titulo}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Pincel.Texto2}" />
                      <Ellipse Width="7" Height="7" Fill="{StaticResource Pincel.Acento2}" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="{Binding ConCambios, Converter={StaticResource Visible}}" />
                      <Path Style="{StaticResource Icono.Trazo12}" Data="{StaticResource Icono.warn}" Margin="6,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{StaticResource Pincel.RojoError}"
                            Visibility="{Binding ConFallo, Converter={StaticResource Visible}}" />
                      <Button Style="{StaticResource Boton.Aspa}" Command="{Binding CerrarCommand}" Margin="6,0,0,0" Visibility="{Binding Cerrable, Converter={StaticResource Visible}}"
                              ToolTip="Cerrar la pestaña (si tiene cambios, pregunta antes)" AutomationProperties.Name="Cerrar pestaña" />
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Activa}" Value="True">
                    <Setter TargetName="Pestana" Property="Background" Value="White" />
                    <Setter TargetName="Marca" Property="Background" Value="{StaticResource Pincel.Acento2}" />
                    <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource Pincel.Marino}" />
                    <Setter TargetName="Texto" Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <Grid x:Name="AreaVistas" Background="White" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
