<Project Sdk="Microsoft.NET.Sdk">
  <!-- Contenedor WPF de ProContaVF (docs/plataforma/contenedor.md): arranque, acceso y ventana principal. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>ProConta.App</RootNamespace>
    <AssemblyName>ProContaVF</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icono del programa (docs/diseno-de-logo-e-iconos.md); fuente en sources/identidad/procontavf-icono.svg. -->
    <ApplicationIcon>Recursos\ProContaVF.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProConta.UI.Base\ProConta.UI.Base.csproj" />
    <ProjectReference Include="..\ProConta.Plataforma.Configuracion\ProConta.Plataforma.Configuracion.csproj" />
    <ProjectReference Include="..\ProConta.Organizacion\ProConta.Organizacion.csproj" />
    <ProjectReference Include="..\ProConta.Seguridad\ProConta.Seguridad.csproj" />
    <ProjectReference Include="..\ProConta.Terceros.UI\ProConta.Terceros.UI.csproj" />
    <ProjectReference Include="..\ProConta.Informes\ProConta.Informes.csproj" />
    <ProjectReference Include="..\ProConta.Facturacion.UI\ProConta.Facturacion.UI.csproj" />
    <ProjectReference Include="..\ProConta.Mantenimiento.UI\ProConta.Mantenimiento.UI.csproj" />
    <ProjectReference Include="..\ProConta.Compras.UI\ProConta.Compras.UI.csproj" />
    <ProjectReference Include="..\ProConta.Implantacion\ProConta.Implantacion.csproj" />
    <ProjectReference Include="..\ProConta.Activos\ProConta.Activos.csproj" />
    <ProjectReference Include="..\ProConta.Correo.UI\ProConta.Correo.UI.csproj" />
    <ProjectReference Include="..\ProConta.Contabilidad.UI\ProConta.Contabilidad.UI.csproj" />
    <ProjectReference Include="..\ProConta.Norma43.UI\ProConta.Norma43.UI.csproj" />
    <ProjectReference Include="..\ProConta.Nominas.UI\ProConta.Nominas.UI.csproj" />
    <ProjectReference Include="..\ProConta.Inicio.UI\ProConta.Inicio.UI.csproj" />
    <!-- Conector de Claude Desktop (plataforma/conector-claude): se compila con el programa y se copia en la subcarpeta Conector. -->
    <ProjectReference Include="..\ProConta.Conector\ProConta.Conector.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopiarConectorClaude" AfterTargets="Build">
    <MSBuild Projects="..\ProConta.Conector\ProConta.Conector.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="SalidaConector" />
    </MSBuild>
    <PropertyGroup>
      <CarpetaConector>@(SalidaConector->'%(RootDir)%(Directory)')</CarpetaConector>
    </PropertyGroup>
    <ItemGroup>
      <ArchivosConector Include="$(CarpetaConector)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ArchivosConector)" DestinationFiles="@(ArchivosConector->'$(OutDir)Conector\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
