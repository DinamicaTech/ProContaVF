<UserControl x:Class="ProConta.App.VistaInicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,32" MaxWidth="1040" HorizontalAlignment="Left" TextElement.FontWeight="Normal">
      <TextBlock x:Name="TextoSaludo" Style="{StaticResource Texto.TituloPantalla}" FontSize="30" />
      <TextBlock x:Name="TextoContexto" Margin="0,8,0,0" TextWrapping="Wrap" />
      <Border x:Name="AvisoCerrado" Margin="0,16,0,0" Padding="12,10" CornerRadius="6" Visibility="Collapsed"
              Background="{StaticResource Pincel.AvisoSuave}" BorderBrush="{StaticResource Pincel.AvisoBorde}" BorderThickness="1">
        <TextBlock TextWrapping="Wrap" Text="Este ejercicio está cerrado: puedes consultarlo, pero no se admiten cambios en sus asientos." />
      </Border>
      <TextBlock Text="En esta versión" Style="{StaticResource Texto.SeccionAcceso}" Margin="0,28,0,10" />
      <Border Style="{StaticResource Tarjeta}" Padding="18,14">
        <TextBlock TextWrapping="Wrap" LineHeight="22">
          Esta entrega contiene <Bold>Terceros</Bold> (Datos maestros › Terceros), la <Bold>facturación de venta</Bold> (Facturación › Facturas:
          borradores, validación numerada, rectificativas y su asiento) y <Bold>Parámetros y tablas</Bold> (Configuración). La validación de facturas es
          provisional, sin VeriFactu: solo vale en la base de datos de pruebas. Las demás áreas (Compras, Contabilidad…) llegarán en las próximas entregas;
          por eso el menú las muestra atenuadas.
        </TextBlock>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
