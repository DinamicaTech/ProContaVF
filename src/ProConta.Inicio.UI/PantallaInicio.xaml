<UserControl x:Class="ProConta.Inicio.UI.PantallaInicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             xmlns:local="clr-namespace:ProConta.Inicio.UI"
             x:Name="Raiz" Background="{StaticResource Pincel.Fondo}">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <local:ColorPincelConverter x:Key="Pincel" />

    <Style x:Key="Tarjeta.Inicio" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10,14,14" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="Titulo.Tarjeta" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style x:Key="Nota.Tarjeta" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Letra.Normal}" />
      <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Subtitulo.Bloque" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Letra.Secundaria}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
      <Setter Property="Margin" Value="0,4,0,8" />
    </Style>
    <Style x:Key="Vacio.Tarjeta" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="16,30" />
    </Style>
    <!-- Variación coloreada: verde si es buena para la sociedad, rojo si es mala. -->
    <Style x:Key="Texto.Variacion" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="Bueno">
          <Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="Malo">
          <Setter Property="Foreground" Value="{StaticResource Pincel.Rojo}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Indicador: tarjeta pulsable solo si tiene pantalla de destino. -->
    <Style x:Key="Boton.Indicador" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Pincel.Linea}" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ToolTipService.ShowDuration" Value="30000" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="F" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13,11,13,8">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Pulsable}" Value="True" />
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="F" Property="BorderBrush" Value="{StaticResource Pincel.HoverBorde}" />
              </MultiDataTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="F" Property="BorderBrush" Value="{StaticResource Pincel.Acento2}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Pulsable}" Value="True">
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Focusable" Value="True" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Estado de un ratio: icono y texto sobre fondo verde, ámbar o rojo. -->
    <Style x:Key="Insignia.Estado" TargetType="Border">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource Pincel.Fondo}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="Bien"><Setter Property="Background" Value="{StaticResource Pincel.VerdeSuave}" /></DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Vigilar"><Setter Property="Background" Value="{StaticResource Pincel.AmbarSuave}" /></DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Mal"><Setter Property="Background" Value="{StaticResource Pincel.RojoSuave}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Texto.Estado" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Letra.Secundaria}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="Bien"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Vigilar"><Setter Property="Foreground" Value="{StaticResource Pincel.Ambar}" /></DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Mal"><Setter Property="Foreground" Value="{StaticResource Pincel.Rojo}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Fila de un ratio: botón plano que abre su ficha. -->
    <Style x:Key="Boton.FilaRatio" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ToolTipService.ShowDuration" Value="30000" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="F" Background="Transparent" CornerRadius="7" Padding="6,4">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="F" Property="Background" Value="{StaticResource Pincel.Fondo}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="F" Property="Background" Value="{StaticResource Pincel.Fondo}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Banco con su saldo (tesorería operativa e inversiones). -->
    <DataTemplate x:Key="Plantilla.Banco" DataType="{x:Type local:BancoVM}">
      <Border BorderBrush="{StaticResource Pincel.Linea2}" BorderThickness="0,0,0,1" Padding="0,4" Background="Transparent" ToolTip="{Binding Ayuda}">
        <Border.InputBindings>
          <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.AbrirBancoCommand, ElementName=Raiz}" CommandParameter="{Binding}" />
        </Border.InputBindings>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Saldo}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" FontSize="{StaticResource Letra.Normal}" />
          <TextBlock Text="{Binding Nombre}" FontSize="{StaticResource Letra.Normal}" Margin="0,0,10,0" />
          <TextBlock Text="{Binding Extracto}" Style="{StaticResource Nota.Tarjeta}" FontSize="{StaticResource Letra.Secundaria}" Margin="0,0,8,0" />
          <Border Background="{StaticResource Pincel.AmbarSuave}" CornerRadius="999" Padding="8,0" HorizontalAlignment="Left" Visibility="{Binding Aviso, Converter={StaticResource Visible}}">
            <TextBlock FontSize="{StaticResource Letra.Pequena}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Ambar}">
              <Run Text="! último extracto " /><Run Text="{Binding Aviso, Mode=OneWay}" />
            </TextBlock>
          </Border>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- Muestra de la leyenda: sólida, rayada (proyección) o a trazos. -->
    <DataTemplate x:Key="Plantilla.Leyenda" DataType="{x:Type local:ElementoLeyenda}">
      <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
        <Border Width="10" Height="10" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" Background="{Binding Color, Converter={StaticResource Pincel}}"
                Visibility="{Binding Solido, Converter={StaticResource Visible}}" />
        <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{Binding Color, Converter={StaticResource Pincel}}"
                Background="{Binding Color, Converter={StaticResource Pincel}, ConverterParameter=rayado}" Visibility="{Binding Rayado, Converter={StaticResource Visible}}" />
        <Line X1="0" X2="14" Y1="0" Y2="0" StrokeThickness="2" StrokeDashArray="2 1.5" Margin="0,0,5,0" VerticalAlignment="Center"
              Stroke="{Binding Color, Converter={StaticResource Pincel}}" Visibility="{Binding Discontinuo, Converter={StaticResource Visible}}" />
        <TextBlock Text="{Binding Texto}" FontSize="{StaticResource Letra.Normal}" Foreground="{StaticResource Pincel.Texto2}" />
      </StackPanel>
    </DataTemplate>

    <!-- Fila con barra horizontal y marca del comparado (actividades y gastos). -->
    <DataTemplate x:Key="Plantilla.FilaBarra" DataType="{x:Type local:FilaBarraVM}">
      <Grid Margin="0,0,0,9" Background="Transparent" ToolTip="{Binding Ayuda}">
        <Grid.InputBindings>
          <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.AbrirGastoCommand, ElementName=Raiz}" CommandParameter="{Binding}" />
        </Grid.InputBindings>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="9" Height="9" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center" Background="{Binding Color, Converter={StaticResource Pincel}}" />
          <TextBlock Text="{Binding Nombre}" FontSize="{StaticResource Letra.Normal}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
          <TextBlock Text="{Binding Valor}" FontSize="{StaticResource Letra.Normal}" Typography.NumeralAlignment="Tabular" />
          <TextBlock Text="{Binding Variacion}" Style="{StaticResource Texto.Variacion}" FontSize="{StaticResource Letra.Secundaria}" Margin="6,0,0,0"
                     Visibility="{Binding Variacion, Converter={StaticResource Visible}}" />
        </StackPanel>
        <pc:BarraReferencia Grid.Row="1" Grid.ColumnSpan="2" Height="8" Margin="0,3,0,0" Valor="{Binding Actual}" Referencia="{Binding Referencia}" Maximo="{Binding Maximo}" Color="{Binding Color}" />
      </Grid>
    </DataTemplate>

    <!-- Salud: icono redondo y colores según la gravedad (siempre con icono y texto, nunca solo color). -->
    <Style x:Key="Icono.Salud" TargetType="Border">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,1,0,0" />
      <Setter Property="Background" Value="{StaticResource Pincel.AzulSuave}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="Grave"><Setter Property="Background" Value="{StaticResource Pincel.RojoSuave}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="Atencion"><Setter Property="Background" Value="{StaticResource Pincel.AmbarSuave}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="Hecho"><Setter Property="Background" Value="{StaticResource Pincel.VerdeSuave}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Texto.Salud" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Pincel.Azul}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="Grave"><Setter Property="Foreground" Value="{StaticResource Pincel.Rojo}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="Atencion"><Setter Property="Foreground" Value="{StaticResource Pincel.Ambar}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="Hecho"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Plazo.Salud" TargetType="Border">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="8,1,0,0" />
      <Setter Property="Background" Value="{StaticResource Pincel.AzulSuave}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding TonoPlazo}" Value="Vencida"><Setter Property="Background" Value="{StaticResource Pincel.RojoSuave}" /></DataTrigger>
        <DataTrigger Binding="{Binding TonoPlazo}" Value="Cerca"><Setter Property="Background" Value="{StaticResource Pincel.AmbarSuave}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TextoPlazo.Salud" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Letra.Pequena}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Pincel.Azul}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding TonoPlazo}" Value="Vencida"><Setter Property="Foreground" Value="{StaticResource Pincel.Rojo}" /></DataTrigger>
        <DataTrigger Binding="{Binding TonoPlazo}" Value="Cerca"><Setter Property="Foreground" Value="{StaticResource Pincel.Ambar}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Celda.Periodo" TargetType="Border">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Background" Value="{StaticResource Pincel.Linea2}" />
      <Setter Property="ToolTipService.ShowDuration" Value="30000" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="Hecho"><Setter Property="Background" Value="{StaticResource Pincel.VerdeSuave}" /></DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Incompleto"><Setter Property="Background" Value="{StaticResource Pincel.AmbarSuave}" /></DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="ConErrores"><Setter Property="Background" Value="{StaticResource Pincel.RojoSuave}" /></DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="EnCurso"><Setter Property="Background" Value="{StaticResource Pincel.AzulSuave}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TextoCelda.Periodo" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Letra.Pequena}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="Hecho"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Incompleto"><Setter Property="Foreground" Value="{StaticResource Pincel.Ambar}" /></DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="ConErrores"><Setter Property="Foreground" Value="{StaticResource Pincel.Rojo}" /></DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="EnCurso"><Setter Property="Foreground" Value="{StaticResource Pincel.Azul}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Seccion.Salud" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Letra.Secundaria}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
      <Setter Property="Margin" Value="6,12,6,4" />
    </Style>
    <CollectionViewSource x:Key="ElementosSalud" Source="{Binding Salud.Elementos}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="NombreSeccion" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </UserControl.Resources>

  <pc:VistaEstado Estado="{Binding Estado}" Titulo="{Binding TituloEstado}" Mensaje="{Binding MensajeEstado}"
                  TextoAccion="Reintentar" AyudaAccion="Vuelve a leer la base de datos y a calcular los indicadores" ComandoAccion="{Binding ReintentarCommand}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Margin="16,16,16,0">

        <!-- Cabecera: título, contexto y acciones generales -->
        <DockPanel Margin="0,0,0,14" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Certificado de la empresa: etiqueta fija con su caducidad (contabilidad/modelos-tributarios/presentacion/aviso-certificado) -->
            <Button x:Name="EtiquetaCertificado" DataContext="{Binding Fase4}" Command="{Binding AbrirCertificadoCommand}" Cursor="Hand" Margin="0,0,14,0" Padding="9,4"
                    Visibility="{Binding HayCertificado, Converter={StaticResource Visible}, FallbackValue=Collapsed}" ToolTip="{Binding Certificado.Ayuda}"
                    MaxWidth="460" AutomationProperties.Name="Certificado de la empresa">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Fondo" Background="{StaticResource Pincel.Fondo}" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="Icono" Text="●" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource Pincel.Apagado}" />
                      <TextBlock Text="Certificado:" FontWeight="SemiBold" Margin="0,0,5,0" VerticalAlignment="Center" />
                      <TextBlock x:Name="Texto" Text="{Binding Certificado.Texto}" FontWeight="Normal" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Certificado.Semaforo}" Value="Verde">
                      <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.VerdeSuave}" />
                      <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.VerdeBorde}" />
                      <Setter TargetName="Icono" Property="Foreground" Value="{StaticResource Pincel.Verde}" />
                      <Setter TargetName="Icono" Property="Text" Value="✓" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Certificado.Semaforo}" Value="Amarillo">
                      <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.AvisoSuave}" />
                      <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.AvisoBorde}" />
                      <Setter TargetName="Icono" Property="Foreground" Value="{StaticResource Pincel.Ambar}" />
                      <Setter TargetName="Icono" Property="Text" Value="!" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Certificado.Semaforo}" Value="Rojo">
                      <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.RojoSuave}" />
                      <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.RojoBorde}" />
                      <Setter TargetName="Icono" Property="Foreground" Value="{StaticResource Pincel.Rojo}" />
                      <Setter TargetName="Icono" Property="Text" Value="✕" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Texto" Property="TextDecorations" Value="Underline" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <TextBlock Text="Comparar con" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding AyudaComparar}" />
            <ComboBox ItemsSource="{Binding Comparables}" SelectedItem="{Binding Comparar}" DisplayMemberPath="Texto" Width="130" Margin="0,0,10,0"
                      ToolTip="{Binding AyudaComparar}" AutomationProperties.Name="Comparar con" />
            <Button Content="Personalizar…" Command="{Binding PersonalizarCommand}" Margin="0,0,8,0" pc:Iconos.Icono="{StaticResource Icono.layout}"
                    ToolTip="Elige qué bloques se ven en Inicio. La elección se guarda para tu operador" />
            <Button Content="Actualizar" Command="{Binding ActualizarCommand}" pc:Iconos.Icono="{StaticResource Icono.refresh}"
                    ToolTip="Vuelve a leer la base de datos, a calcular los indicadores y a revisar la salud de la contabilidad (se hace solo al abrir Inicio; cambiar «Comparar con» no vuelve a leer lo ya leído)" />
          </StackPanel>
          <TextBlock Text="{Binding Titulo}" FontFamily="{StaticResource Fuente.Titulo}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Tinta}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Nota.Tarjeta}" FontSize="13" Margin="12,3,12,0" ToolTip="{Binding Subtitulo}" />
        </DockPanel>

        <Border Visibility="{Binding HayAviso, Converter={StaticResource Visible}}" Background="{StaticResource Pincel.AvisoSuave}" BorderBrush="{StaticResource Pincel.AvisoBorde}"
                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
          <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" />
        </Border>

        <!-- Lo más urgente: el elemento grave más prioritario de la salud -->
        <Border Visibility="{Binding VerUrgente, Converter={StaticResource Visible}}" Background="{StaticResource Pincel.RojoSuave}" BorderBrush="{StaticResource Pincel.RojoBorde}"
                BorderThickness="4,1,1,1" CornerRadius="10" Padding="12,9" Margin="0,0,0,14" AutomationProperties.Name="Lo más urgente">
          <DockPanel DataContext="{Binding Salud.Urgente}">
            <Border DockPanel.Dock="Left" Style="{StaticResource Icono.Salud}" Margin="0,0,10,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Icono}" Style="{StaticResource Texto.Salud}" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Button DockPanel.Dock="Right" Style="{StaticResource Boton.Primario}" Margin="10,0,0,0" VerticalAlignment="Center"
                    Content="{Binding DataContext.Salud.TextoBotonUrgente, ElementName=Raiz}" Command="{Binding DataContext.Salud.AbrirUrgenteCommand, ElementName=Raiz}"
                    ToolTip="{Binding DataContext.Salud.AyudaBotonUrgente, ElementName=Raiz}" ToolTipService.ShowOnDisabled="True" />
            <Border DockPanel.Dock="Right" Style="{StaticResource Plazo.Salud}" VerticalAlignment="Center" ToolTip="{Binding AyudaPlazo}" Visibility="{Binding HayPlazo, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding Plazo}" Style="{StaticResource TextoPlazo.Salud}" />
            </Border>
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13.5" ToolTip="{Binding Ayuda}">
              <Run Text="Lo más urgente:" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Rojo}" /> <Run Text="{Binding Titulo, Mode=OneWay}" />. <Run Text="{Binding Explicacion, Mode=OneWay}" Foreground="{StaticResource Pincel.Texto2}" />
            </TextBlock>
          </DockPanel>
        </Border>
      </StackPanel>

      <Grid Grid.Row="1" x:Name="Columnas">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="ColumnaSalud" Width="400" />
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="Desplazamiento" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,0,16,8">

        <TextBlock Visibility="{Binding TodoOculto, Converter={StaticResource Visible}}" Style="{StaticResource Vacio.Tarjeta}"
                   Text="Has ocultado todos los bloques. Pulsa «Personalizar…» para volver a mostrar los que quieras." />

        <!-- Indicadores -->
        <ItemsControl x:Name="Indicadores" ItemsSource="{Binding Indicadores}" Margin="0,0,0,4" Visibility="{Binding VerIndicadores, Converter={StaticResource Visible}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid x:Name="RejillaIndicadores" Columns="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:IndicadorVM}">
              <Button Style="{StaticResource Boton.Indicador}" Command="{Binding Comando}" ToolTip="{Binding Ayuda}" Margin="0,0,10,10" AutomationProperties.Name="{Binding Titulo}">
                <StackPanel>
                  <TextBlock Text="{Binding Titulo}" FontSize="{StaticResource Letra.Normal}" Foreground="{StaticResource Pincel.Apagado}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Valor}" FontFamily="{StaticResource Fuente.Titulo}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Tinta}"
                             Typography.NumeralAlignment="Tabular" Margin="0,1,0,1" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Visibility="{Binding HayComparado, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Variacion}" Style="{StaticResource Texto.Variacion}" FontSize="{StaticResource Letra.Secundaria}" Margin="0,0,6,0"
                               Visibility="{Binding Variacion, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Comparado}" FontSize="{StaticResource Letra.Secundaria}" Foreground="{StaticResource Pincel.Apagado}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Text="{Binding Proyeccion}" FontSize="{StaticResource Letra.Secundaria}" Foreground="{StaticResource Pincel.Apagado}" FontStyle="Italic"
                             TextTrimming="CharacterEllipsis" Visibility="{Binding HayProyeccion, Converter={StaticResource Visible}}" />
                  <pc:Minigrafico Valores="{Binding Evolucion}" Color="#1D5C8C" Height="30" Margin="0,4,0,0" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Facturación -->
        <Border Style="{StaticResource Tarjeta.Inicio}" Visibility="{Binding VerFacturacion, Converter={StaticResource Visible}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,6">
              <Border DockPanel.Dock="Right" Style="{StaticResource Segmentado}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource Segmento}" Content="Mensual" IsChecked="{Binding VistaMensual}" GroupName="VistaFacturacion" ToolTip="Facturación de cada mes, con la proyección rayada encima" />
                  <RadioButton Style="{StaticResource Segmento}" Content="Acumulada" IsChecked="{Binding VistaAcumulada}" GroupName="VistaFacturacion" ToolTip="Facturación acumulada desde el 1 de enero, con la proyección a trazos" />
                  <RadioButton Style="{StaticResource Segmento}" Content="Tabla" IsChecked="{Binding VistaTabla}" GroupName="VistaFacturacion" ToolTip="Las mismas cifras en una tabla, que se puede exportar a Excel" />
                </StackPanel>
              </Border>
              <TextBlock Text="Facturación" Style="{StaticResource Titulo.Tarjeta}" />
              <TextBlock Text="base imponible por mes" Style="{StaticResource Nota.Tarjeta}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding TextoProyeccion}" Style="{StaticResource Nota.Tarjeta}" Visibility="{Binding TextoProyeccion, Converter={StaticResource Visible}}"
                         ToolTip="Proyección del ejercicio completo (estimación): total del ejercicio comparado × (acumulado actual / acumulado del comparado a la misma fecha)" />
            </DockPanel>
            <TextBlock Text="{Binding AvisoFuente}" Style="{StaticResource Texto.Apagado}" Margin="0,0,0,6" Visibility="{Binding AvisoFuente, Converter={StaticResource Visible}}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="300" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding SinFacturas}" Style="{StaticResource Vacio.Tarjeta}" Visibility="{Binding SinFacturas, Converter={StaticResource Visible}}" />
                <StackPanel Visibility="{Binding SinFacturas, Converter={StaticResource Visible}, ConverterParameter=invertir}">
                  <StackPanel Visibility="{Binding VerGraficoFacturacion, Converter={StaticResource Visible}}">
                    <ItemsControl ItemsSource="{Binding LeyendaFacturacion}" ItemTemplate="{StaticResource Plantilla.Leyenda}" Margin="0,0,0,4">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <pc:GraficoBarras Datos="{Binding DatosFacturacion}" Height="250" Visibility="{Binding FacturacionEnBarras, Converter={StaticResource Visible}}" />
                    <pc:GraficoLineas Datos="{Binding DatosFacturacion}" Height="250" Visibility="{Binding FacturacionEnLineas, Converter={StaticResource Visible}}" />
                  </StackPanel>
                  <pc:TablaProConta ItemsSource="{Binding FilasFacturacion}" Visibility="{Binding VistaTabla, Converter={StaticResource Visible}}" ClavePreferencias="inicio.facturacion"
                                    TituloExportacion="Facturación por mes" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="420" HeadersVisibility="Column">
                    <pc:TablaProConta.Columns>
                      <DataGridTextColumn Header="Mes" Binding="{Binding Mes}" Width="110" pc:TablaProConta.SiempreVisible="True" />
                      <DataGridTextColumn Header="Facturado" Binding="{Binding Facturado}" Width="130" pc:TablaProConta.RutaExportar="ImporteFacturado" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                      <DataGridTextColumn Header="Proyectado" Binding="{Binding Proyectado}" Width="130" pc:TablaProConta.RutaExportar="ImporteProyectado" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                      <DataGridTextColumn Header="Comparado" Binding="{Binding Comparado}" Width="130" pc:TablaProConta.RutaExportar="ImporteComparado" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                      <DataGridTextColumn Header="Variación" Binding="{Binding Variacion}" Width="90" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                      <DataGridTextColumn Header="Acumulado (con proyección)" Binding="{Binding Acumulado}" Width="180" pc:TablaProConta.RutaExportar="ImporteAcumulado" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                      <DataGridTextColumn Header="Acumulado comparado" Binding="{Binding AcumuladoComparado}" Width="160" pc:TablaProConta.RutaExportar="ImporteAcumuladoComparado" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                    </pc:TablaProConta.Columns>
                  </pc:TablaProConta>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Por actividad · acumulado" Style="{StaticResource Subtitulo.Bloque}"
                           ToolTip="Facturación por actividad de IVA del centro de coste de cada línea (la del centro o, si no tiene, la del nodo superior)" />
                <ItemsControl ItemsSource="{Binding Actividades}" ItemTemplate="{StaticResource Plantilla.FilaBarra}" />
                <TextBlock Text="{Binding TextoActividades}" Style="{StaticResource Texto.Apagado}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Ratios -->
        <Border Style="{StaticResource Tarjeta.Inicio}" Visibility="{Binding VerRatios, Converter={StaticResource Visible}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource Pincel.VerdeSuave}" CornerRadius="999" Padding="8,1" Margin="6,0,0,0" Visibility="{Binding HayBien, Converter={StaticResource Visible}}"
                        ToolTip="Ratios dentro de su rango de referencia">
                  <TextBlock Text="{Binding RecuentoBien}" FontSize="{StaticResource Letra.Secundaria}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Verde}" />
                </Border>
                <Border Background="{StaticResource Pincel.AmbarSuave}" CornerRadius="999" Padding="8,1" Margin="6,0,0,0" Visibility="{Binding HayVigilar, Converter={StaticResource Visible}}"
                        ToolTip="Ratios algo por debajo del mínimo o por encima del máximo de su rango">
                  <TextBlock Text="{Binding RecuentoVigilar}" FontSize="{StaticResource Letra.Secundaria}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Ambar}" />
                </Border>
                <Border Background="{StaticResource Pincel.RojoSuave}" CornerRadius="999" Padding="8,1" Margin="6,0,0,0" Visibility="{Binding HayMal, Converter={StaticResource Visible}}"
                        ToolTip="Ratios muy por debajo del mínimo (menos del 80 %) o muy por encima del máximo en los de «menos es mejor» (más de 1,3 veces)">
                  <TextBlock Text="{Binding RecuentoMal}" FontSize="{StaticResource Letra.Secundaria}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Rojo}" />
                </Border>
              </StackPanel>
              <TextBlock Text="Ratios" Style="{StaticResource Titulo.Tarjeta}" />
              <TextBlock Text="{Binding TextoRatios}" Style="{StaticResource Nota.Tarjeta}"
                         ToolTip="Balance a fin del último mes completo (o a 31/12 si el ejercicio está terminado) y resultado de los 12 meses que terminan en esa fecha" />
            </DockPanel>
            <TextBlock Text="{Binding SinRatios}" Style="{StaticResource Vacio.Tarjeta}" Visibility="{Binding SinRatios, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding FamiliasRatios}" Visibility="{Binding SinRatios, Converter={StaticResource Visible}, ConverterParameter=invertir}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:FamiliaRatioVM}">
                  <StackPanel Margin="0,0,28,8">
                    <TextBlock Text="{Binding Nombre}" Style="{StaticResource Subtitulo.Bloque}" Margin="6,2,0,2" />
                    <ItemsControl ItemsSource="{Binding Filas}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:FilaRatioVM}">
                          <Button Style="{StaticResource Boton.FilaRatio}" Command="{Binding Comando}" ToolTip="{Binding Ayuda}" AutomationProperties.Name="{Binding Nombre}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" MinWidth="70" />
                                <ColumnDefinition Width="96" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Nombre}" FontSize="{StaticResource Letra.Normal}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Valor}" FontSize="{StaticResource Letra.Normal}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                         Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="0,0,10,0" />
                              <pc:FranjaRango Grid.Column="2" Height="14" VerticalAlignment="Center" Valor="{Binding Numero}" Referencia="{Binding Comparado}"
                                              Minimo="{Binding Minimo}" Maximo="{Binding Maximo}" MenosEsMejor="{Binding MenosEsMejor}" />
                              <Border Grid.Column="3" Style="{StaticResource Insignia.Estado}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding TextoEstado}" Style="{StaticResource Texto.Estado}" />
                              </Border>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding NotaRatios}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="6,2,0,0" Visibility="{Binding NotaRatios, Converter={StaticResource Visible}}" />
          </StackPanel>
        </Border>

        <!-- Bloques inferiores en dos columnas -->
        <UniformGrid Columns="2">
          <!-- Tesorería -->
          <Border Style="{StaticResource Tarjeta.Inicio}" Margin="0,0,7,14" Visibility="{Binding VerTesoreria, Converter={StaticResource Visible}}">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Tesorería" Style="{StaticResource Titulo.Tarjeta}" />
                <TextBlock Text="operativa (sin las cuentas de inversión), a fin de cada uno de los últimos 12 meses" Style="{StaticResource Nota.Tarjeta}" />
              </DockPanel>
              <pc:GraficoLineas Datos="{Binding DatosTesoreria}" Height="190" />
              <TextBlock Text="{Binding TextoBancos}" Style="{StaticResource Subtitulo.Bloque}" Margin="0,10,0,4" />
              <ItemsControl ItemsSource="{Binding Bancos}" ItemTemplate="{StaticResource Plantilla.Banco}" />
              <StackPanel Visibility="{Binding HayInversiones, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding TextoInversiones}" Style="{StaticResource Subtitulo.Bloque}" Margin="0,14,0,4"
                           ToolTip="Cuentas bancarias marcadas como inversión en «Personalizar…»: no suman en la tesorería operativa ni en su gráfico" />
                <ItemsControl ItemsSource="{Binding Inversiones}" ItemTemplate="{StaticResource Plantilla.Banco}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Ingresos y gastos -->
          <Border Style="{StaticResource Tarjeta.Inicio}" Margin="7,0,0,14" Visibility="{Binding VerIngresos, Converter={StaticResource Visible}}">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Ingresos y gastos" Style="{StaticResource Titulo.Tarjeta}" />
                <TextBlock Text="por mes · la distancia entre las dos líneas es el resultado" Style="{StaticResource Nota.Tarjeta}" />
              </DockPanel>
              <WrapPanel Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                  <Border Width="10" Height="10" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" Background="#2a78d6" />
                  <TextBlock Text="Ingresos (grupo 7)" FontSize="{StaticResource Letra.Normal}" Foreground="{StaticResource Pincel.Texto2}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="10" Height="10" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" Background="#eb6834" />
                  <TextBlock Text="Gastos (grupo 6 sin la 630)" FontSize="{StaticResource Letra.Normal}" Foreground="{StaticResource Pincel.Texto2}" />
                </StackPanel>
              </WrapPanel>
              <TextBlock Text="{Binding SinIngresos}" Style="{StaticResource Vacio.Tarjeta}" Visibility="{Binding SinIngresos, Converter={StaticResource Visible}}" />
              <pc:GraficoLineas Datos="{Binding DatosIngresos}" Height="230" Visibility="{Binding SinIngresos, Converter={StaticResource Visible}, ConverterParameter=invertir}" />
            </StackPanel>
          </Border>

          <!-- Pendiente de cobro -->
          <Border Style="{StaticResource Tarjeta.Inicio}" Margin="0,0,7,14" Visibility="{Binding VerCobros, Converter={StaticResource Visible}}">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Pendiente de cobro" Style="{StaticResource Titulo.Tarjeta}" />
                <TextBlock Text="{Binding TextoCobros}" Style="{StaticResource Nota.Tarjeta}" ToolTip="{Binding TextoCobros}" />
              </DockPanel>
              <TextBlock Text="{Binding SinCobros}" Style="{StaticResource Vacio.Tarjeta}" Visibility="{Binding SinCobros, Converter={StaticResource Visible}}" />
              <StackPanel Visibility="{Binding SinCobros, Converter={StaticResource Visible}, ConverterParameter=invertir}">
                <pc:BarraApilada Tramos="{Binding Tramos}" Height="22" Margin="0,6,0,8" />
                <ItemsControl ItemsSource="{Binding LeyendaTramos}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:LeyendaTramoVM}">
                      <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                        <Border Width="10" Height="10" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" Background="{Binding Color, Converter={StaticResource Pincel}}" />
                        <TextBlock FontSize="{StaticResource Letra.Normal}" Foreground="{StaticResource Pincel.Texto2}">
                          <Run Text="{Binding Texto, Mode=OneWay}" /> <Run Text="{Binding Importe, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Clientes con más saldo" Style="{StaticResource Subtitulo.Bloque}" Margin="0,12,0,4" />
                <pc:TablaProConta x:Name="TablaClientes" ItemsSource="{Binding Clientes}" ClavePreferencias="inicio.clientes" TituloExportacion="Clientes con más saldo pendiente"
                                  IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MouseDoubleClick="TablaClientes_MouseDoubleClick"
                                  ToolTip="Doble clic: abre el Mayor del cliente">
                  <pc:TablaProConta.Columns>
                    <DataGridTextColumn Header="Subcuenta" Binding="{Binding Cuenta}" Width="90" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Nombre}" Width="*" MinWidth="140" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.SiempreVisible="True" />
                    <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo}" Width="120" pc:TablaProConta.RutaExportar="ImporteSaldo" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                    <DataGridTextColumn Header="Más de 30 días" Binding="{Binding MasDe30}" Width="120" pc:TablaProConta.RutaExportar="ImporteMasDe30" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                        pc:TablaProConta.Ayuda="Parte del saldo con más de 30 días desde su vencimiento (o desde la fecha del apunte, si no tiene vencimiento)" />
                  </pc:TablaProConta.Columns>
                </pc:TablaProConta>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Gastos por naturaleza -->
          <Border Style="{StaticResource Tarjeta.Inicio}" Margin="7,0,0,14" Visibility="{Binding VerGastos, Converter={StaticResource Visible}}">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Gastos por naturaleza" Style="{StaticResource Titulo.Tarjeta}" />
                <TextBlock Text="acumulado del ejercicio, por cuenta de 3 dígitos" Style="{StaticResource Nota.Tarjeta}" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Gastos}" ItemTemplate="{StaticResource Plantilla.FilaBarra}" />
              <TextBlock Text="{Binding NotaGastos}" Style="{StaticResource Texto.Apagado}" Visibility="{Binding NotaGastos, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Border>

          <!-- Agenda (fase 4): próximos vencimientos, solo lectura -->
          <Border Style="{StaticResource Tarjeta.Inicio}" Margin="0,0,7,14" Visibility="{Binding VerAgenda, Converter={StaticResource Visible}}">
            <StackPanel DataContext="{Binding Fase4}">
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Agenda" Style="{StaticResource Titulo.Tarjeta}" />
                <TextBlock Text="{Binding TextoAgenda}" Style="{StaticResource Nota.Tarjeta}" ToolTip="{Binding TextoAgenda}" />
              </DockPanel>
              <TextBlock Text="Leyendo la agenda…" Style="{StaticResource Vacio.Tarjeta}" Visibility="{Binding CargandoAgenda, Converter={StaticResource Visible}}" />
              <TextBlock Text="{Binding SinAgenda}" Style="{StaticResource Vacio.Tarjeta}" TextWrapping="Wrap" Visibility="{Binding SinAgenda, Converter={StaticResource Visible}}" />
              <ListBox x:Name="ListaAgenda" ItemsSource="{Binding Agenda}" BorderThickness="0" Background="Transparent" MaxHeight="330"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ListaAgenda_MouseDoubleClick" KeyDown="ListaAgenda_KeyDown"
                       AutomationProperties.Name="Agenda: próximos vencimientos">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="ToolTip" Value="{Binding Ayuda}" />
                    <Setter Property="Padding" Value="4,5" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:EntradaAgendaVM}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Dia}" Foreground="{StaticResource Pincel.Apagado}" FontSize="{StaticResource Letra.Normal}" />
                      <TextBlock Grid.Column="1" Text="{Binding Texto}" TextWrapping="Wrap" FontSize="{StaticResource Letra.Normal}" />
                      <TextBlock Grid.Column="2" Text="{Binding Importe}" Margin="10,0,0,0" FontSize="{StaticResource Letra.Normal}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Verde}"
                                 Visibility="{Binding HayImporte, Converter={StaticResource Visible}}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Plazos fiscales y facturas programadas. Lo que hay que hacer, y si ya está hecho, está en Salud." Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </Border>

          <!-- Ocupación turística (fase 4): solo si la sociedad tiene reservas -->
          <Border Style="{StaticResource Tarjeta.Inicio}" Margin="7,0,0,14" Visibility="{Binding VerOcupacion, Converter={StaticResource Visible}}">
            <StackPanel x:Name="BloqueOcupacion" DataContext="{Binding Fase4}">
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Ocupación turística" Style="{StaticResource Titulo.Tarjeta}" />
                <TextBlock Text="{Binding TextoOcupacion}" Style="{StaticResource Nota.Tarjeta}" ToolTip="{Binding TextoOcupacion}" />
              </DockPanel>
              <TextBlock Text="{Binding ErrorOcupacion}" Style="{StaticResource Vacio.Tarjeta}" TextWrapping="Wrap" Visibility="{Binding ErrorOcupacion, Converter={StaticResource Visible}}" />
              <ItemsControl ItemsSource="{Binding LeyendaOcupacion}" Focusable="False" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:ElementoLeyenda}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                      <Border Width="10" Height="10" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" Background="{Binding Color, Converter={StaticResource Pincel}}" />
                      <TextBlock Text="{Binding Texto}" FontSize="{StaticResource Letra.Normal}" Foreground="{StaticResource Pincel.Texto2}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <pc:GraficoLineas x:Name="GraficoOcupacion" Datos="{Binding DatosOcupacion}" Height="200" />
              <pc:TablaProConta x:Name="TablaOcupacion" ItemsSource="{Binding FilasOcupacion}" ClavePreferencias="inicio.ocupacion" TituloExportacion="Ocupación turística por alojamiento"
                                IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" Margin="0,8,0,0">
                <pc:TablaProConta.Columns>
                  <DataGridTextColumn Header="Alojamiento" Binding="{Binding Alojamiento}" Width="*" MinWidth="130" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.SiempreVisible="True" />
                  <DataGridTextColumn Header="Noches" Binding="{Binding Noches}" Width="70" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                      pc:TablaProConta.Ayuda="Noches ocupadas del 1 de enero a la fecha de corte" />
                  <DataGridTextColumn Header="Ocupación" Binding="{Binding Ocupacion}" Width="85" pc:TablaProConta.RutaExportar="Porcentaje" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                      pc:TablaProConta.Ayuda="Noches ocupadas entre noches disponibles, del 1 de enero a la fecha de corte" />
                  <DataGridTextColumn x:Name="ColumnaComparadoOcupacion" Header="Comparado" Binding="{Binding Comparado}" Width="85" pc:TablaProConta.RutaExportar="PorcentajeComparado"
                                      ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                      pc:TablaProConta.Ayuda="Ocupación del ejercicio comparado en el mismo periodo (del 1 de enero a la misma fecha)" />
                  <DataGridTextColumn Header="Var." Binding="{Binding Variacion}" Width="70" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                      pc:TablaProConta.Ayuda="Diferencia en puntos de ocupación frente al comparado" />
                </pc:TablaProConta.Columns>
              </pc:TablaProConta>
              <TextBlock Text="{Binding NotaOcupacion}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding NotaOcupacion, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Border>
        </UniformGrid>
            <!-- En ancho estrecho, la salud pasa debajo de los bloques. -->
            <ContentControl x:Name="SaludAbajo" Focusable="False" />
          </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="SaludDerecha" Grid.Column="1" Focusable="False" Margin="0,0,16,8">
          <!-- Salud de la contabilidad: columna propia con su desplazamiento -->
          <Border x:Name="PanelSalud" Style="{StaticResource Tarjeta.Inicio}" Padding="6,10,6,0" Margin="0,0,0,6" Visibility="{Binding VerSalud, Converter={StaticResource Visible}}"
                  AutomationProperties.Name="Salud de la contabilidad">
            <Grid DataContext="{Binding Salud}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel Margin="8,0,8,6">
                <Border DockPanel.Dock="Right" Style="{StaticResource Segmentado}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segmento}" Content="Todo" IsChecked="{Binding FiltroTodo}" GroupName="FiltroSalud" ToolTip="Tareas y avisos" />
                    <RadioButton Style="{StaticResource Segmento}" Content="Tareas" IsChecked="{Binding FiltroTareas}" GroupName="FiltroSalud" ToolTip="Solo las tareas con fecha (plazos)" />
                    <RadioButton Style="{StaticResource Segmento}" Content="Avisos" IsChecked="{Binding FiltroAvisos}" GroupName="FiltroSalud" ToolTip="Solo los avisos de cosas a corregir" />
                  </StackPanel>
                </Border>
                <TextBlock Text="Salud de la contabilidad" Style="{StaticResource Titulo.Tarjeta}" TextTrimming="CharacterEllipsis" />
              </DockPanel>

              <!-- Resumen: graves más atención (los avisos informativos no cuentan) -->
              <DockPanel Grid.Row="1" Margin="10,2,10,8" Visibility="{Binding HayContenido, Converter={StaticResource Visible}}">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Numero}" FontFamily="{StaticResource Fuente.Titulo}" FontSize="30" FontWeight="SemiBold" Margin="0,0,12,0"
                           VerticalAlignment="Center" ToolTip="Cosas graves más cosas que requieren atención; los avisos informativos no cuentan">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding TonoResumen}" Value="Grave"><Setter Property="Foreground" Value="{StaticResource Pincel.Rojo}" /></DataTrigger>
                        <DataTrigger Binding="{Binding TonoResumen}" Value="Atencion"><Setter Property="Foreground" Value="{StaticResource Pincel.Ambar}" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding TituloResumen}" FontWeight="SemiBold" />
                  <WrapPanel Margin="0,3,0,0">
                    <Border Background="{StaticResource Pincel.RojoSuave}" CornerRadius="999" Padding="7,0" Margin="0,0,5,0" ToolTip="Cosas graves: hay que resolverlas cuanto antes">
                      <TextBlock Text="{Binding RecuentoGraves}" FontSize="{StaticResource Letra.Pequena}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Rojo}" />
                    </Border>
                    <Border Background="{StaticResource Pincel.AmbarSuave}" CornerRadius="999" Padding="7,0" Margin="0,0,5,0" ToolTip="Cosas que requieren atención">
                      <TextBlock Text="{Binding RecuentoAtencion}" FontSize="{StaticResource Letra.Pequena}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Ambar}" />
                    </Border>
                    <Border Background="{StaticResource Pincel.AzulSuave}" CornerRadius="999" Padding="7,0" ToolTip="Avisos informativos: no cuentan en el número grande">
                      <TextBlock Text="{Binding RecuentoAvisos}" FontSize="{StaticResource Letra.Pequena}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Azul}" />
                    </Border>
                  </WrapPanel>
                </StackPanel>
              </DockPanel>

              <ScrollViewer x:Name="DesplazamientoSalud" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="2,0,2,10">
                  <StackPanel Visibility="{Binding Error, Converter={StaticResource Visible}}" Margin="8,6">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource Pincel.Rojo}" />
                    <Button Content="Reintentar" Command="{Binding ReintentarCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Vuelve a revisar la salud de la contabilidad" />
                  </StackPanel>

                  <!-- Estado de los periodos -->
                  <StackPanel Visibility="{Binding HayPeriodos, Converter={StaticResource Visible}}">
                    <TextBlock Text="ESTADO DE LOS PERIODOS" Style="{StaticResource Seccion.Salud}" Margin="6,2,6,4" />
                    <Grid Margin="6,0,6,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Meses}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding}" FontSize="{StaticResource Letra.Pequena}" Foreground="{StaticResource Pincel.Apagado}" HorizontalAlignment="Center" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Periodos}" Margin="6,0,6,2" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:FilaPeriodoVM}">
                          <Grid Background="Transparent" ToolTip="{Binding Ayuda}">
                            <Grid.InputBindings>
                              <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Abrir}" />
                            </Grid.InputBindings>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="112" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Nombre}" FontSize="{StaticResource Letra.Secundaria}" Foreground="{StaticResource Pincel.Texto2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Celdas}" Focusable="False">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:CeldaPeriodoVM}">
                                  <Border Style="{StaticResource Celda.Periodo}" ToolTip="{Binding Ayuda}">
                                    <TextBlock Text="{Binding Texto}" Style="{StaticResource TextoCelda.Periodo}" />
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Todo al día -->
                  <Border Visibility="{Binding TodoAlDia, Converter={StaticResource Visible}}" Background="{StaticResource Pincel.VerdeSuave}" CornerRadius="10" Padding="14,18" Margin="6,10,6,4">
                    <StackPanel>
                      <TextBlock Text="✓ Todo al día" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Verde}" HorizontalAlignment="Center" />
                      <TextBlock Text="No hay tareas con plazo ni avisos: la contabilidad cuadra, los bancos están al día y no hay facturas pendientes de registrar."
                                 TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Pincel.Verde}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>

                  <!-- Tareas, avisos y hechas: selección simple o múltiple, doble clic o Intro abre la pantalla, clic derecho para más acciones -->
                  <ListBox x:Name="ListaSalud" ItemsSource="{Binding Source={StaticResource ElementosSalud}}" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                           Margin="0,4,0,0" AutomationProperties.Name="Tareas y avisos" SelectionChanged="ListaSalud_SelectionChanged" MouseDoubleClick="ListaSalud_MouseDoubleClick">
                    <ListBox.Template>
                      <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
                    </ListBox.Template>
                    <ListBox.InputBindings>
                      <KeyBinding Key="Enter" Command="{Binding AbrirCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{Binding TextoAbrirSeleccion}" Command="{Binding AbrirCommand}" InputGestureText="Intro"
                                  ToolTip="Abre la pantalla donde se resuelve (solo con un elemento seleccionado y si la pantalla ya existe)" />
                        <MenuItem Header="¿Por qué aparece?" Command="{Binding PorQueCommand}" ToolTip="Qué lo detecta, la condición por la que aparece y cómo se resuelve" />
                        <Separator />
                        <MenuItem Header="Copiar el texto" Command="{Binding CopiarCommand}" ToolTip="Copia al portapapeles el texto de los elementos seleccionados" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.GroupStyle>
                      <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                          <DataTemplate>
                            <TextBlock Style="{StaticResource Seccion.Salud}">
                              <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding ItemCount, Mode=OneWay}" FontWeight="Normal" />
                            </TextBlock>
                          </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                      </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="ToolTip" Value="{Binding Ayuda}" />
                        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Titulo}" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="F" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,2">
                                <ContentPresenter />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="F" Property="Background" Value="{StaticResource Pincel.Fondo}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="F" Property="Background" Value="{StaticResource Pincel.Seleccion}" />
                                  <Setter TargetName="F" Property="BorderBrush" Value="{StaticResource Pincel.AcentoBorde}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:ElementoSaludVM}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Border Style="{StaticResource Icono.Salud}" AutomationProperties.Name="{Binding TextoGravedad}">
                            <TextBlock Text="{Binding Icono}" Style="{StaticResource Texto.Salud}" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="2" Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Hecha}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <Border Grid.Column="3" Style="{StaticResource Plazo.Salud}" ToolTip="{Binding AyudaPlazo}" Visibility="{Binding HayPlazo, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding Plazo}" Style="{StaticResource TextoPlazo.Salud}" />
                          </Border>
                          <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding Explicacion}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Pincel.Texto2}" Margin="0,2,0,0" />
                          <WrapPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,3,0,0">
                            <TextBlock FontSize="12" Foreground="{StaticResource Pincel.Apagado}" TextWrapping="Wrap">
                              <Run Text="{Binding TextoGravedad, Mode=OneWay}" FontWeight="SemiBold" /> · › <Run Text="{Binding Destino, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Tendencia}" ToolTip="{Binding AyudaTendencia}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"
                                       Visibility="{Binding HayTendencia, Converter={StaticResource Visible}}">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding TonoTendencia}" Value="Sube"><Setter Property="Foreground" Value="{StaticResource Pincel.Rojo}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding TonoTendencia}" Value="Baja"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </WrapPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <!-- Comprobaciones correctas (plegable) -->
                  <Expander Header="{Binding TituloCorrectas}" Visibility="{Binding HayCorrectas, Converter={StaticResource Visible}}" Margin="6,10,6,0"
                            ToolTip="Lo que se ha revisado y está bien">
                    <ItemsControl ItemsSource="{Binding Correctas}" Margin="4,6,0,0" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="✓" FontWeight="Bold" Foreground="{StaticResource Pincel.Verde}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource Pincel.Texto2}" FontSize="12.5" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </StackPanel>
              </ScrollViewer>

              <Border Grid.Row="3" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,1,0,0" Padding="10,7">
                <TextBlock FontSize="12" Foreground="{StaticResource Pincel.Apagado}" TextWrapping="Wrap">
                  <Run Text="{Binding TextoPie, Mode=OneWay}" /> · doble clic abre la pantalla que lo resuelve
                </TextBlock>
              </Border>
            </Grid>
          </Border>
        </ContentControl>
      </Grid>
    </Grid>
  </pc:VistaEstado>
</UserControl>
