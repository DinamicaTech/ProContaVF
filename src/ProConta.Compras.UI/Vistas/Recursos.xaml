<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pc="urn:proconta-ui">
  <!-- Composiciones de compras con los tokens de ProConta.UI.Base (sin colores propios). -->
  <pc:VisibleSiConverter x:Key="Visible" />

  <Style x:Key="Etiqueta.Campo" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Letra.Pequena}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Texto2}" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Bloque.Campo" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,12,10" />
  </Style>

  <Style x:Key="Titulo.Tarjeta" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Letra.Destacada}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
    <Setter Property="Margin" Value="0,0,10,10" />
  </Style>

  <Style x:Key="Tarjeta.Compra" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <Style x:Key="Calculado" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Mono}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0" />
  </Style>

  <!-- Confianza de un campo reconocido: verde (alta), ámbar (media), rojo (baja) o azul (manual). -->
  <Style x:Key="Confianza" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radio.Pastilla}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="6,0,0,4" />
    <Setter Property="Height" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Pincel.Fondo2}" />
    <Setter Property="Visibility" Value="{Binding Visible, Converter={StaticResource Visible}}" />
    <Setter Property="ToolTip" Value="{Binding Motivo}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Nivel}" Value="alta"><Setter Property="Background" Value="{StaticResource Pincel.VerdeSuave}" /></DataTrigger>
      <DataTrigger Binding="{Binding Nivel}" Value="media"><Setter Property="Background" Value="{StaticResource Pincel.AmbarSuave}" /></DataTrigger>
      <DataTrigger Binding="{Binding Nivel}" Value="baja"><Setter Property="Background" Value="{StaticResource Pincel.RojoSuave}" /></DataTrigger>
      <DataTrigger Binding="{Binding Nivel}" Value="manual"><Setter Property="Background" Value="{StaticResource Pincel.AzulSuave}" /></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Texto.Confianza" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Letra.Mini}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Text" Value="{Binding Texto}" />
  </Style>

  <!-- Pestaña de la lista (Pendientes / Contabilizadas / Todas): segmento con el aspecto del selector segmentado. -->
  <Style x:Key="Pestana.Lista" TargetType="RadioButton" BasedOn="{StaticResource Segmento}" />
</ResourceDictionary>
