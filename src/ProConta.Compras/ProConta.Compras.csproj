<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compras: factura de compra, reconocimiento de los PDF y contabilización (docs/compras.md). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>ProConta.Compras</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Texto del PDF con la posición de cada palabra (aprobada en compras/reconocimiento 2026-11-05 11:24). -->
    <PackageReference Include="PdfPig" Version="0.1.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProConta.Nucleo\ProConta.Nucleo.csproj" />
    <ProjectReference Include="..\ProConta.Datos.Persistencia\ProConta.Datos.Persistencia.csproj" />
    <ProjectReference Include="..\ProConta.Mantenimiento\ProConta.Mantenimiento.csproj" />
    <ProjectReference Include="..\ProConta.Terceros\ProConta.Terceros.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProConta.Compras.Tests" />
  </ItemGroup>
</Project>
