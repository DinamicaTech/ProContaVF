<UserControl x:Class="ProConta.Contabilidad.UI.Cierre.PantallaCierreEjercicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             Background="White">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <ContextMenu x:Key="Menu.Linea">
      <MenuItem Header="Mayor de la cuenta" Command="{Binding MayorCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTipService.ShowOnDisabled="True" ToolTip="Abre el Mayor de la subcuenta seleccionada para revisar sus apuntes del ejercicio" />
      <MenuItem Header="Ver el asiento grabado" Command="{Binding VerEnDiarioCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre el asiento grabado (solo si el ejercicio está cerrado con ProContaVF)" />
    </ContextMenu>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera: acciones generales -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{Binding TextoCrearSiguiente}" Style="{StaticResource Boton}" Command="{Binding CrearSiguienteCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  ToolTipService.ShowOnDisabled="True"
                  ToolTip="Crea el ejercicio siguiente copiando parámetros, plan de cuentas y series de facturación (solo si aún no existe)" />
          <Button Content="Ver en el Diario" Style="{StaticResource Boton}" Command="{Binding VerEnDiarioCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  ToolTipService.ShowOnDisabled="True" ToolTip="Abre el asiento grabado que se está viendo abajo (solo con el ejercicio cerrado)" />
          <Button Content="Reabrir el ejercicio…" Style="{StaticResource Boton}" Command="{Binding ReabrirCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  ToolTipService.ShowOnDisabled="True"
                  ToolTip="Quita la marca de cerrado y borra la regularización, el cierre y la apertura de este proceso, con motivo (no si el ejercicio siguiente está cerrado)" />
          <Button Content="Actualizar" Style="{StaticResource Boton}" Command="{Binding RefrescarCommand}" VerticalAlignment="Center"
                  ToolTip="Vuelve a leer la situación, la comprobación previa y la propuesta (F5)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Cierre del ejercicio" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Border CornerRadius="{StaticResource Radio.Pastilla}" Padding="8,1" VerticalAlignment="Center" ToolTip="{Binding AyudaEstado}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Pincel.AzulSuave}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ClaseEstado}" Value="CERRADO">
                    <Setter Property="Background" Value="{StaticResource Pincel.VerdeSuave}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ClaseEstado}" Value="SINSIGUIENTE">
                    <Setter Property="Background" Value="{StaticResource Pincel.AvisoSuave}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource Letra.Pequena}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Texto2}" />
          </Border>
          <TextBlock Text="{Binding AyudaEstado}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pie: motivo y cerrar lo que se ve -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding TextoConfirmar}" Style="{StaticResource Boton.Primario}" Command="{Binding ConfirmarCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="{Binding PorQueNoCerrar, TargetNullValue='Graba exactamente la regularización, el cierre y la apertura de la propuesta y marca el ejercicio como cerrado, todo de una vez'}" />
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0" Visibility="{Binding PideMotivo, Converter={StaticResource Visible}}">
          <TextBlock Text="Motivo" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding AyudaMotivo}" />
          <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}" Width="420" MaxLength="255" VerticalAlignment="Center"
                   ToolTip="{Binding AyudaMotivo}" AutomationProperties.Name="Motivo" />
        </StackPanel>
        <TextBlock Text="{Binding PorQueNoCerrar}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
      </DockPanel>
    </Border>

    <pc:VistaEstado Estado="{Binding Estado}" Mensaje="{Binding MensajeEstado}" TextoAccion="Actualizar" ComandoAccion="{Binding RefrescarCommand}">
      <Grid Margin="14,10,14,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="380" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Izquierda: situación y comprobación previa -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{Binding Situacion.Ejercicio, StringFormat='Ejercicio {0}'}" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Ejercicio siguiente" Style="{StaticResource Texto.Apagado}" Margin="0,2" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TextoSiguiente}" Margin="0,2" />
              <TextBlock Grid.Row="1" Text="Cuenta de resultados" Style="{StaticResource Texto.Apagado}" Margin="0,2"
                         ToolTip="Parámetros y tablas › Ejercicios, «Cierre · cuenta de resultados»; vacía, 1290000" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Propuesta.CuentaResultado}" FontFamily="Consolas" Margin="0,2" />
              <TextBlock Grid.Row="2" Text="Resultado" Style="{StaticResource Texto.Apagado}" Margin="0,2" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TextoResultado}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2" />
              <TextBlock Grid.Row="3" Text="Cerrado" Style="{StaticResource Texto.Apagado}" Margin="0,2" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TextoCerrado}" Margin="0,2" />
            </Grid>

            <DockPanel Margin="0,0,0,6">
              <TextBlock DockPanel.Dock="Right" Text="Avisa, no impide cerrar" Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" VerticalAlignment="Center" />
              <TextBlock Text="Comprobación previa" Style="{StaticResource Texto.Seccion}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding FilasComprobacion}" Focusable="False" AutomationProperties.Name="Comprobación previa">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="0,6">
                    <DockPanel>
                      <Border x:Name="Marca" DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="10" Margin="0,0,8,0" VerticalAlignment="Top" Background="{StaticResource Pincel.Fondo}">
                        <TextBlock Text="{Binding Marca}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="{StaticResource Letra.Pequena}" />
                      </Border>
                      <Button DockPanel.Dock="Right" Content="{Binding TextoAccion}" Style="{StaticResource Boton.Enlace}" Command="{Binding Accion}" VerticalAlignment="Top"
                              Margin="8,0,0,0" Visibility="{Binding TieneAccion, Converter={StaticResource Visible}}" />
                      <StackPanel>
                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detalle}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Clase}" Value="OK">
                      <Setter TargetName="Marca" Property="Background" Value="{StaticResource Pincel.VerdeSuave}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Clase}" Value="AVISO">
                      <Setter TargetName="Marca" Property="Background" Value="{StaticResource Pincel.AvisoSuave}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Clase}" Value="BLOQUEO">
                      <Setter TargetName="Marca" Property="Background" Value="{StaticResource Pincel.RojoSuave}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Derecha: propuesta -->
        <Grid Grid.Column="2">
          <TextBlock Text="{Binding TextoSinPropuesta}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                     Visibility="{Binding HayPropuesta, Converter={StaticResource Visible}, ConverterParameter=invertir}" />
          <DockPanel Visibility="{Binding HayPropuesta, Converter={StaticResource Visible}}">
            <TextBlock DockPanel.Dock="Top" Text="Propuesta" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,8" />

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Cifras}" Focusable="False" Margin="0,0,0,8">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,22,6" ToolTip="{Binding Ayuda}">
                    <TextBlock Text="{Binding Etiqueta}" Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" />
                    <TextBlock x:Name="Valor" Text="{Binding Valor}" Style="{StaticResource Texto.Importe}" HorizontalAlignment="Left" />
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Destacada}" Value="True">
                      <Setter TargetName="Valor" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <pc:Nota DockPanel.Dock="Top" Tipo="Aviso" Margin="0,0,0,8" HorizontalAlignment="Left" Visibility="{Binding HayBloqueos, Converter={StaticResource Visible}}">
              <ItemsControl ItemsSource="{Binding Bloqueos}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </pc:Nota>

            <Border DockPanel.Dock="Top" Style="{StaticResource Segmentado}" Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segmento}" Content="{Binding TextoRegularizacion}" IsChecked="{Binding VerRegularizacion, Mode=OneWay}"
                             Command="{Binding VerCommand}" CommandParameter="Regularizacion" ToolTip="Grupos 6 y 7 contra la cuenta de resultados, a 31/12" />
                <RadioButton Style="{StaticResource Segmento}" Content="{Binding TextoCierre}" IsChecked="{Binding VerCierre, Mode=OneWay}"
                             Command="{Binding VerCommand}" CommandParameter="Cierre" ToolTip="Grupos 1 a 5, incluida la cuenta de resultados, a 31/12" />
                <RadioButton Style="{StaticResource Segmento}" Content="{Binding TextoApertura}" IsChecked="{Binding VerApertura, Mode=OneWay}"
                             Command="{Binding VerCommand}" CommandParameter="Apertura" ToolTip="El cierre al revés, a 1/1 del ejercicio siguiente" />
              </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" Text="{Binding TituloVisible}" Style="{StaticResource Texto.Apagado}" Margin="0,0,0,6" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
              <TextBlock Text="Total Debe" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" />
              <TextBlock Text="{Binding TotalDebe}" Style="{StaticResource Texto.Importe}" Margin="0,0,18,0" />
              <TextBlock Text="Total Haber" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" />
              <TextBlock Text="{Binding TotalHaber}" Style="{StaticResource Texto.Importe}" />
            </StackPanel>

            <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding LineasVisibles}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                      RowStyle="{StaticResource Tabla.Fila}" ContextMenu="{StaticResource Menu.Linea}" AutomationProperties.Name="Asiento propuesto"
                      ToolTip="Una línea por subcuenta, sin centro de coste. Clic derecho: Mayor de la cuenta o ver el asiento grabado">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Cuenta" Binding="{Binding Cuenta}" Width="90" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Debe" Binding="{Binding Debe}" Width="130" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="Haber" Binding="{Binding Haber}" Width="130" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Grid>
      </Grid>
    </pc:VistaEstado>
  </DockPanel>
</UserControl>
