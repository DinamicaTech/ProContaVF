<UserControl x:Class="ProConta.Contabilidad.UI.Dividendos.PantallaRepartoDividendos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             Background="White">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <ContextMenu x:Key="Menu.Repartos">
      <MenuItem Header="Ver el asiento" Command="{Binding VerAsientoCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre el asiento grabado del reparto elegido" />
      <MenuItem Header="Mayor de sus cuentas" Command="{Binding MayorCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre el Mayor de la cuenta de reservas y de las 526 y 4751 de los socios del reparto elegido" />
      <MenuItem Header="Generar el acta…" Command="{Binding GenerarActaCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Genera en PDF el acta de la junta que aprueba el reparto elegido (socios, administrador, acuerdo con el importe en letras y firmas), la guarda en la carpeta de documentos de la empresa (&lt;ejercicio&gt;\Actas) y la abre" />
      <Separator />
      <MenuItem Header="Deshacer el reparto…" Command="{Binding DeshacerCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Borra el asiento del reparto elegido y el reparto, con motivo; los pagos a los socios quedan como pagos a cuenta en su 526" />
    </ContextMenu>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
    <KeyBinding Key="F9" Command="{Binding RecalcularCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera: acciones generales -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Nuevo reparto…" Style="{StaticResource Boton.Primario}" Command="{Binding NuevoCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                  ToolTip="Abre la ficha de un reparto nuevo con la fecha de hoy y, como neto de cada socio, lo que ya tiene pagado a cuenta en su 526" />
          <Button Content="Actualizar" Style="{StaticResource Boton}" Command="{Binding RefrescarCommand}" VerticalAlignment="Center"
                  ToolTip="Vuelve a leer los repartos del ejercicio (F5)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Reparto de dividendos" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pie: edición de la ficha -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Descartar" Style="{StaticResource Boton}" Command="{Binding DescartarCommand}" Margin="0,0,8,0"
                  ToolTip="Deshace lo escrito en la ficha: un reparto nuevo se cierra sin grabar; uno guardado vuelve a como está grabado" />
          <Button Content="{Binding TextoConfirmar}" Style="{StaticResource Boton.Primario}" Command="{Binding ConfirmarCommand}" ToolTipService.ShowOnDisabled="True"
                  ToolTip="{Binding PorQueNoConfirmar, TargetNullValue='Graba exactamente el asiento de la propuesta como lote del reparto (corregirlo después lo sustituye sin duplicar)'}" />
        </StackPanel>
        <TextBlock Text="{Binding PorQueNoConfirmar}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PorQueNoConfirmar}" />
      </DockPanel>
    </Border>

    <pc:VistaEstado Estado="{Binding Estado}" Mensaje="{Binding MensajeEstado}" TextoAccion="Actualizar" ComandoAccion="{Binding RefrescarCommand}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Repartos del ejercicio -->
        <DataGrid Grid.Row="0" Style="{StaticResource Tabla}" ItemsSource="{Binding Repartos}" SelectedItem="{Binding Seleccion}" IsReadOnly="True"
                  SelectionMode="Single" AutoGenerateColumns="False" ContextMenu="{StaticResource Menu.Repartos}" Margin="14,10,14,6" MaxHeight="190"
                  RowStyle="{StaticResource Tabla.Fila}" HeadersVisibility="Column" AutomationProperties.Name="Repartos del ejercicio"
                  Visibility="{Binding HayRepartos, Converter={StaticResource Visible}}"
                  ToolTip="Elige un reparto para ver y corregir su ficha. Clic derecho: ver el asiento, Mayor o deshacer">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" SortMemberPath="FechaOrden" Width="90" ElementStyle="{StaticResource Texto.Celda}" />
            <DataGridTextColumn Header="Socios" Binding="{Binding Socios}" Width="260" ElementStyle="{StaticResource Texto.Celda}" />
            <DataGridTextColumn Header="Neto" Binding="{Binding Neto}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTextColumn Header="Retención" Binding="{Binding Retencion}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTextColumn Header="%" Binding="{Binding PorcentajeRetencion}" Width="60" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTextColumn Header="Bruto" Binding="{Binding Bruto}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTextColumn Header="Asiento" Binding="{Binding Asiento}" Width="70" ElementStyle="{StaticResource Texto.Celda.Mono}" />
            <DataGridTextColumn Header="Situación" Binding="{Binding Situacion}" Width="*" ElementStyle="{StaticResource Texto.Celda}" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Ficha del reparto -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,1,0,0" Padding="14,10,14,8">
          <Grid>
            <TextBlock Text="{Binding TextoSinFicha}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                       Visibility="{Binding FichaAbierta, Converter={StaticResource Visible}, ConverterParameter=invertir}" />
            <DockPanel Visibility="{Binding FichaAbierta, Converter={StaticResource Visible}}">
              <TextBlock DockPanel.Dock="Top" Text="{Binding TituloFicha}" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,8" />

              <!-- Fecha y neto total -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Fecha" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding AyudaFecha}" />
                <TextBox Text="{Binding FechaTexto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}" Width="96" VerticalAlignment="Center"
                         ToolTip="{Binding AyudaFecha}" AutomationProperties.Name="Fecha del reparto">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding RecalcularCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Neto total" VerticalAlignment="Center" Margin="22,0,8,0"
                           ToolTip="Lo que perciben entre todos los socios marcados. Escríbelo y pulsa «Repartir» para repartirlo por su participación" />
                <TextBox Text="{Binding NetoTotalTexto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo.Importe}" Width="120" VerticalAlignment="Center"
                         ToolTip="Lo que perciben entre todos los socios marcados. Escríbelo y pulsa «Repartir» (o Intro) para repartirlo por su participación, con el resto al céntimo"
                         AutomationProperties.Name="Neto total">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding RepartirCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <Button Content="Repartir" Style="{StaticResource Boton.Pequeno}" Command="{Binding RepartirCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="Reparte el neto total entre los socios marcados según su % de participación (resto mayor al céntimo) y recalcula el asiento" />
                <Button Content="Volver a calcular" Style="{StaticResource Boton.Enlace}" Command="{Binding RecalcularCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                        ToolTip="Calcula de nuevo la propuesta con la fecha y los netos escritos (F9); si cambia la fecha, vuelve a leer lo pagado de cada socio" />
                <TextBlock Text="{Binding Resumen}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0" />
              </StackPanel>

              <TextBlock DockPanel.Dock="Top" Text="{Binding SinSociosTexto}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,8"
                         Visibility="{Binding SinSocios, Converter={StaticResource Visible}}" />

              <!-- Socios -->
              <DataGrid DockPanel.Dock="Top" Style="{StaticResource Tabla}" ItemsSource="{Binding Socios}" AutoGenerateColumns="False" HeadersVisibility="Column"
                        CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MaxHeight="200" Margin="0,0,0,8" RowStyle="{StaticResource Tabla.Fila}"
                        AutomationProperties.Name="Socios del reparto">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Incluido, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Elegible}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  ToolTip="{Binding Ayuda}" ToolTipService.ShowOnDisabled="True" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Socio" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Nombre}" ToolTip="{Binding Ayuda}" Style="{StaticResource Texto.Celda}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="%" Binding="{Binding Participacion}" IsReadOnly="True" Width="70" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Cuentas" Binding="{Binding Cuentas}" IsReadOnly="True" Width="140" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                  <DataGridTextColumn Header="Pagado a cuenta" Binding="{Binding Pagado}" IsReadOnly="True" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTemplateColumn Header="Neto" Width="130" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding NetoTexto, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo.Importe}" IsEnabled="{Binding Incluido}" Margin="0,1"
                                 ToolTip="Lo que percibe el socio. Por defecto, lo que ya tiene pagado a cuenta (saldo deudor de su 526 a la fecha); al salir del campo se recalcula el asiento" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Bruto" Binding="{Binding Bruto}" IsReadOnly="True" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Retención" Binding="{Binding Retencion}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                </DataGrid.Columns>
              </DataGrid>

              <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorPropuesta}" Foreground="{StaticResource Pincel.RojoError}" TextWrapping="Wrap" Margin="0,0,0,8"
                         Visibility="{Binding HayErrorPropuesta, Converter={StaticResource Visible}}" />

              <pc:Nota DockPanel.Dock="Top" Tipo="Aviso" Margin="0,0,0,8" MaxWidth="1000" HorizontalAlignment="Left" Visibility="{Binding HayAvisos, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Avisos}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </pc:Nota>

              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding EsCorreccion, Converter={StaticResource Visible}}">
                <TextBlock Text="Motivo" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Por qué se corrige el reparto: queda en el asiento y en su historial" />
                <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}" Width="520" MaxLength="255" VerticalAlignment="Center"
                         ToolTip="Por qué se corrige el reparto (por ejemplo «Neto acordado en la junta»): queda en el asiento y en su historial" AutomationProperties.Name="Motivo" />
              </StackPanel>

              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <TextBlock Text="Total Debe" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding TotalDebe}" Style="{StaticResource Texto.Importe}" Margin="0,0,18,0" />
                <TextBlock Text="Total Haber" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding TotalHaber}" Style="{StaticResource Texto.Importe}" />
              </StackPanel>

              <!-- Asiento propuesto -->
              <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding Lineas}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                        RowStyle="{StaticResource Tabla.Fila}" AutomationProperties.Name="Asiento propuesto">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Cuenta" Binding="{Binding Cuenta}" Width="90" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                  <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*" ElementStyle="{StaticResource Texto.Celda}" />
                  <DataGridTextColumn Header="Debe" Binding="{Binding Debe}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Haber" Binding="{Binding Haber}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
    </pc:VistaEstado>
  </DockPanel>
</UserControl>
