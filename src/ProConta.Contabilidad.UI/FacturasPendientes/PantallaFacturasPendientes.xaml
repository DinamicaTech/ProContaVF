<UserControl x:Class="ProConta.Contabilidad.UI.FacturasPendientes.PantallaFacturasPendientes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             Background="White">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <ContextMenu x:Key="Menu.Proveedor">
      <MenuItem Header="Mayor de la subcuenta" Command="{Binding MayorCommand}" ToolTipService.ShowOnDisabled="True"
                CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTip="Abre el Mayor de la subcuenta del proveedor, para ver de dónde sale su saldo deudor" />
    </ContextMenu>
    <ContextMenu x:Key="Menu.Linea">
      <MenuItem Header="Mayor de la cuenta" Command="{Binding MayorCommand}" ToolTipService.ShowOnDisabled="True"
                CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTip="Abre el Mayor de la cuenta de esta línea del asiento" />
    </ContextMenu>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera: acciones generales -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{Binding TextoCrearSiguiente}" Style="{StaticResource Boton}" Command="{Binding CrearSiguienteCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  Visibility="{Binding FaltaSiguiente, Converter={StaticResource Visible}}"
                  ToolTip="Crea el ejercicio siguiente copiando los parámetros y el plan de cuentas de este: recibe la reversión del 1/1" />
          <Button Content="Ver la provisión" Style="{StaticResource Boton}" Command="{Binding VerProvisionCommand}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"
                  ToolTip="Abre el asiento grabado del 31/12 (solo si ya está hecho)" />
          <Button Content="Ver la reversión" Style="{StaticResource Boton}" Command="{Binding VerReversionCommand}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"
                  ToolTip="Abre el asiento grabado del 1/1 del ejercicio siguiente (solo si ya está hecho)" />
          <Button Content="Deshacer…" Style="{StaticResource Boton}" Command="{Binding DeshacerCommand}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"
                  ToolTip="Borra la provisión y su reversión, con motivo (las casillas y bases cambiadas se conservan)" />
          <Button Content="Actualizar" Style="{StaticResource Boton}" Command="{Binding RefrescarCommand}" VerticalAlignment="Center"
                  ToolTip="Vuelve a leer los saldos, los cuadres del Mayor y lo grabado, y recalcula la propuesta (F5). Descarta lo cambiado sin confirmar" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Facturas pendientes de recibir" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Border CornerRadius="{StaticResource Radio.Pastilla}" Padding="8,1" VerticalAlignment="Center" ToolTip="{Binding AyudaEstado}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Pincel.AzulSuave}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ClaseEstado}" Value="HECHO">
                    <Setter Property="Background" Value="{StaticResource Pincel.VerdeSuave}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ClaseEstado}" Value="DESACTUALIZADO">
                    <Setter Property="Background" Value="{StaticResource Pincel.AvisoSuave}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource Letra.Pequena}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Texto2}" />
          </Border>
          <TextBlock Text="{Binding AyudaEstado}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding AyudaEstado}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pie: confirmar lo que se ve -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Descartar cambios" Style="{StaticResource Boton}" Command="{Binding DescartarCommand}" Margin="0,0,8,0"
                  ToolTip="Vuelve a las casillas y bases guardadas y borra el motivo escrito" />
          <Button Content="{Binding TextoConfirmar}" Style="{StaticResource Boton.Primario}" Command="{Binding ConfirmarCommand}" ToolTipService.ShowOnDisabled="True"
                  ToolTip="{Binding AyudaConfirmar}" MinWidth="90" />
        </StackPanel>
        <TextBlock Text="{Binding PorQueNoConfirmar}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PorQueNoConfirmar}" />
      </DockPanel>
    </Border>

    <pc:VistaEstado Estado="{Binding Estado}" Mensaje="{Binding MensajeEstado}" TextoAccion="Actualizar" ComandoAccion="{Binding RefrescarCommand}">
      <Border Padding="14,10,14,8">
        <DockPanel Visibility="{Binding HayPropuesta, Converter={StaticResource Visible}}">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Resumen}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0" />
            <TextBlock Text="{Binding TituloPropuesta}" Style="{StaticResource Texto.Seccion}" VerticalAlignment="Center" />
          </DockPanel>

          <pc:Nota DockPanel.Dock="Top" Tipo="Aviso" Margin="0,0,0,8" MaxWidth="1000" HorizontalAlignment="Left" Visibility="{Binding HayAvisos, Converter={StaticResource Visible}}">
            <ItemsControl ItemsSource="{Binding Avisos}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </pc:Nota>

          <!-- Proveedores -->
          <DataGrid DockPanel.Dock="Top" Style="{StaticResource Tabla}" ItemsSource="{Binding Filas}" AutoGenerateColumns="False" HeadersVisibility="Column"
                    CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MaxHeight="320" Margin="0,0,0,10" RowStyle="{StaticResource Tabla.Fila}"
                    HorizontalAlignment="Left" ContextMenu="{StaticResource Menu.Proveedor}" AutomationProperties.Name="Proveedores con saldo deudor"
                    Visibility="{Binding HayFilas, Converter={StaticResource Visible}}"
                    ToolTip="Proveedores y acreedores cuadrados en el Mayor con saldo deudor a 31/12 (pagado sin factura recibida). Clic derecho: Mayor de la subcuenta">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="34">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Incluido, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip="Marcado: entra en la provisión. Desmárcalo si su saldo no es una factura pendiente (un anticipo, un pago duplicado…); se recuerda al volver a proponer" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Subcuenta" Binding="{Binding Cuenta}" IsReadOnly="True" Width="80" ElementStyle="{StaticResource Texto.Celda.Mono}" />
              <DataGridTextColumn Header="Proveedor" Binding="{Binding Nombre}" IsReadOnly="True" Width="230" ElementStyle="{StaticResource Texto.Celda}" />
              <DataGridTextColumn Header="Saldo deudor" Binding="{Binding Saldo}" IsReadOnly="True" Width="105" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              <DataGridTemplateColumn Header="Proporción" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Origen}" ToolTip="{Binding AyudaOrigen}" Style="{StaticResource Texto.Celda}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Base" Width="110" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBox x:Name="Base" Text="{Binding Base, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo.Importe}" IsEnabled="{Binding Incluido}" Margin="0,1"
                             ToolTip="{Binding AyudaBase}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Base supuesta" />
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Manual}" Value="True">
                        <Setter TargetName="Base" Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Gasto" Width="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding CuentaGasto}" ToolTip="{Binding AyudaGasto}" Style="{StaticResource Texto.Celda.Mono}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Centro de coste" Binding="{Binding Centro}" IsReadOnly="True" Width="170" ElementStyle="{StaticResource Texto.Celda}" />
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding PideMotivo, Converter={StaticResource Visible}}">
            <TextBlock Text="Motivo" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding AyudaMotivo}" />
            <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}" Width="520" MaxLength="255" VerticalAlignment="Center"
                     ToolTip="{Binding AyudaMotivo}" AutomationProperties.Name="Motivo" />
            <TextBlock Text="{Binding AyudaMotivo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="10,0,0,0" />
          </StackPanel>

          <TextBlock DockPanel.Dock="Bottom" Text="{Binding TextoReversion}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,6,0,0" />

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
            <TextBlock Text="Total Debe" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" />
            <TextBlock Text="{Binding TotalDebe}" Style="{StaticResource Texto.Importe}" Margin="0,0,18,0" />
            <TextBlock Text="Total Haber" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" />
            <TextBlock Text="{Binding TotalHaber}" Style="{StaticResource Texto.Importe}" />
          </StackPanel>

          <!-- Asiento resumido de la provisión -->
          <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding Lineas}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" HorizontalAlignment="Left"
                    RowStyle="{StaticResource Tabla.Fila}" ContextMenu="{StaticResource Menu.Linea}" AutomationProperties.Name="Asiento de la provisión"
                    ToolTip="Asiento del 31/12 resumido por cuenta y centro (grabado lleva un par de líneas por proveedor con su nombre). Clic derecho: Mayor de la cuenta">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Cuenta" Binding="{Binding Cuenta}" Width="80" ElementStyle="{StaticResource Texto.Celda.Mono}" />
              <DataGridTextColumn Header="Centro de coste" Binding="{Binding Centro}" Width="170" ElementStyle="{StaticResource Texto.Celda}" />
              <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="340" ElementStyle="{StaticResource Texto.Celda}" />
              <DataGridTextColumn Header="Debe" Binding="{Binding Debe}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              <DataGridTextColumn Header="Haber" Binding="{Binding Haber}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </pc:VistaEstado>
  </DockPanel>
</UserControl>
