<UserControl x:Class="ProConta.Contabilidad.UI.ImpuestoSociedades.PantallaRentaViviendas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             x:Name="Raiz"
             Background="White">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <ContextMenu x:Key="Menu.Partida">
      <MenuItem Header="Mayor de la cuenta" Command="{Binding MayorPartidaCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre el Mayor de la cuenta para ver los apuntes de la partida" />
    </ContextMenu>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
    <KeyBinding Key="F9" Command="{Binding RecalcularCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Renta de viviendas" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Pie: el valor que se aplica -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Renta de viviendas a aplicar" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding AyudaRenta}" />
        <TextBox Text="{Binding RentaAplicar, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo.Importe}" Width="120" VerticalAlignment="Center"
                 ToolTip="{Binding AyudaRenta}" AutomationProperties.Name="Renta de viviendas a aplicar" />
        <Button Content="Usar la calculada" Style="{StaticResource Boton}" Command="{Binding UsarRentaCalculadaCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                ToolTip="Vacía el campo para aplicar la renta calculada" />
        <TextBlock Text="Pulsa Tab al acabar de escribir para recalcular el impuesto." Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>
    </Border>

    <pc:VistaEstado Estado="{Binding Estado}" Mensaje="{Binding MensajeEstado}" TextoAccion="Actualizar" ComandoAccion="{Binding RefrescarCommand}">
      <Grid Margin="14,10,14,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="420" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="Cálculo (art. 49.2 LIS)" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,6" />
          <TextBlock Text="{Binding TextoSinPropuesta}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap"
                     Visibility="{Binding HayPropuesta, Converter={StaticResource Visible}, ConverterParameter=invertir}" />
          <TextBlock Text="{Binding SinActividadBonificada}" Foreground="{StaticResource Pincel.Aviso}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Visibility="{Binding HaySinActividadBonificada, Converter={StaticResource Visible}}" />
          <ItemsControl ItemsSource="{Binding ResumenRenta}" Focusable="False" AutomationProperties.Name="Cálculo de la renta de viviendas">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="0,3" ToolTip="{Binding Ayuda}">
                  <DockPanel>
                    <TextBlock x:Name="Importe" DockPanel.Dock="Right" Text="{Binding Importe}" Style="{StaticResource Texto.Importe}" />
                    <TextBlock x:Name="Concepto" Text="{Binding Concepto}" VerticalAlignment="Center" />
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Destacada}" Value="True">
                    <Setter TargetName="Importe" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Concepto" Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock TextWrapping="Wrap" Style="{StaticResource Texto.Apagado}" Margin="0,10,0,0"
                     Text="Los gastos directos de las viviendas se imputan enteros; los generales (sin actividad o de la actividad general, con los financieros y las amortizaciones) en proporción a los ingresos ordinarios de las viviendas sobre los de toda la sociedad (consulta V0805-06). Las actividades con bonificación se marcan en Catálogos › Actividades." />
        </StackPanel>

        <DockPanel Grid.Column="2">
          <TextBlock DockPanel.Dock="Top" Text="Partidas por centro y cuenta" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,6" />
          <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding Partidas}" SelectedItem="{Binding PartidaSeleccionada}" IsReadOnly="True" AutoGenerateColumns="False"
                    HeadersVisibility="Column" RowStyle="{StaticResource Tabla.Fila}" ContextMenu="{StaticResource Menu.Partida}" AutomationProperties.Name="Partidas de la renta de viviendas"
                    ToolTip="Cada cuenta de cada centro que entra en el cálculo. Clic derecho: Mayor de la cuenta">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Clase" Binding="{Binding Clase}" Width="150" ElementStyle="{StaticResource Texto.Celda}" />
              <DataGridTextColumn Header="Centro" Binding="{Binding Centro}" Width="170" ElementStyle="{StaticResource Texto.Celda}" />
              <DataGridTextColumn Header="Cuenta" Binding="{Binding Cuenta}" Width="84" ElementStyle="{StaticResource Texto.Celda.Mono}" />
              <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" ElementStyle="{StaticResource Texto.Celda}" />
              <DataGridTextColumn Header="Apuntes" Binding="{Binding Apuntes}" Width="70" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              <DataGridTextColumn Header="Importe" Binding="{Binding Importe}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Grid>
    </pc:VistaEstado>
  </DockPanel>
</UserControl>
