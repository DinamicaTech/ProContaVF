<UserControl x:Class="ProConta.Contabilidad.UI.ImpuestoSociedades.PantallaContrasteRetenciones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             x:Name="Raiz"
             Background="White">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <ContextMenu x:Key="Menu.Fila">
      <MenuItem Header="Copiar el dato de Hacienda" Command="{Binding CopiarHaciendaCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Pone como valor para el IS de este pagador lo que dice Hacienda" />
      <MenuItem Header="Copiar el dato de la contabilidad" Command="{Binding CopiarContabilidadCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Pone como valor para el IS de este pagador lo contabilizado; si no es lo de Hacienda, hay que justificarlo" />
      <MenuItem Header="Usar la propuesta" Command="{Binding UsarPropuestoCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Borra el valor escrito: se usa lo propuesto (lo de Hacienda si hay datos fiscales; si no, lo contabilizado)" />
      <Separator />
      <MenuItem Header="Mayor de la cuenta" Command="{Binding MayorContrasteCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre el Mayor de la 473 de este pagador" />
    </ContextMenu>
    <ContextMenu x:Key="Menu.Apunte">
      <MenuItem Header="Ver el asiento" Command="{Binding VerApunteCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre el asiento del apunte para ver su factura o su cobro" />
      <MenuItem Header="Mayor de la cuenta" Command="{Binding MayorApunteCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre el Mayor de la 473 del apunte" />
    </ContextMenu>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
    <KeyBinding Key="F9" Command="{Binding RecalcularCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera: acciones generales -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Abrir la Sede" Style="{StaticResource Boton}" Command="{Binding AbrirSedeCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  ToolTip="Abre la página de la AEAT con el enlace a los datos fiscales del Impuesto sobre Sociedades (con certificado). La dirección está en Parámetros generales" />
          <Button Content="Importar…" Style="{StaticResource Boton}" Command="{Binding ImportarDatosFiscalesCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  ToolTip="Lee el HTML de los datos fiscales guardado desde la Sede (Guardar página como…): pagos fraccionados, retenciones por pagador, bases negativas pendientes y declaración presentada" />
          <Button Content="Quitar los datos" Style="{StaticResource Boton}" Command="{Binding QuitarDatosAeatCommand}" Margin="0,0,16,0" VerticalAlignment="Center"
                  ToolTip="Quita lo importado de Hacienda: se vuelve a proponer lo contabilizado" />
          <Button Content="Copiar Hacienda" Style="{StaticResource Boton}" Command="{Binding CopiarHaciendaTodasCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  ToolTip="Pone en todos los pagadores lo que dice Hacienda como valor para el IS" />
          <Button Content="Copiar contabilidad" Style="{StaticResource Boton}" Command="{Binding CopiarContabilidadTodasCommand}" VerticalAlignment="Center"
                  ToolTip="Pone en todos los pagadores lo contabilizado como valor para el IS; donde no sea lo de Hacienda, hay que justificarlo" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Contraste de retenciones con Hacienda" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pie: totales -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="Hacienda" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TotalAeat}" Style="{StaticResource Texto.Importe}" Margin="0,0,18,0" VerticalAlignment="Center" />
          <TextBlock Text="Contabilidad" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TotalContable}" Style="{StaticResource Texto.Importe}" Margin="0,0,18,0" VerticalAlignment="Center" />
          <TextBlock Text="Para el IS" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TotalRetenciones}" Style="{StaticResource Texto.Importe}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding ResumenContraste}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <pc:VistaEstado Estado="{Binding Estado}" Mensaje="{Binding MensajeEstado}" TextoAccion="Actualizar" ComandoAccion="{Binding RefrescarCommand}">
      <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="2*" MinHeight="160" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="140" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
          <TextBlock Text="{Binding ResumenAeat}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding TextoSinPropuesta}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Visibility="{Binding HayPropuesta, Converter={StaticResource Visible}, ConverterParameter=invertir}" />
          <TextBlock Text="{Binding PorQueNoContraste}" Foreground="{StaticResource Pincel.Aviso}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Visibility="{Binding HayPorQueNoContraste, Converter={StaticResource Visible}}" />
        </StackPanel>

        <!-- Un pagador por fila: Hacienda frente a contabilidad y el valor para el IS -->
        <DataGrid Grid.Row="1" Style="{StaticResource Tabla}" ItemsSource="{Binding Contraste}" SelectedItem="{Binding ContrasteSeleccionado}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowStyle="{StaticResource Tabla.Fila}"
                  ContextMenu="{StaticResource Menu.Fila}" AutomationProperties.Name="Contraste de retenciones"
                  ToolTip="Elige un pagador para ver abajo sus apuntes y lo que dice Hacienda. Valor para el IS vacío: lo propuesto. Clic derecho: copiar Hacienda o contabilidad, usar la propuesta o abrir el Mayor">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Pagador" Width="*" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Pagador}" ToolTip="{Binding Pagador}" Style="{StaticResource Texto.Celda}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="NIF" Binding="{Binding Nif}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource Texto.Celda.Mono}" />
            <DataGridTemplateColumn Header="Cuenta" Width="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid>
                    <TextBlock Text="{Binding Cuenta}" Style="{StaticResource Texto.Celda.Mono}"
                               Visibility="{Binding SoloHacienda, Converter={StaticResource Visible}, ConverterParameter=invertir}" />
                    <ComboBox ItemsSource="{Binding DataContext.Cuentas473, ElementName=Raiz}" SelectedItem="{Binding Cuenta, UpdateSourceTrigger=PropertyChanged}" Margin="0,1"
                              Visibility="{Binding SoloHacienda, Converter={StaticResource Visible}}"
                              ToolTip="Solo lo conoce Hacienda: elige la 473 a la que va su valor" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Hacienda" Binding="{Binding Hacienda}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTextColumn Header="Contabilidad" Binding="{Binding Contable}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTemplateColumn Header="Diferencia" Width="96" IsReadOnly="True" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Diferencia}" Style="{StaticResource Texto.Celda.Importe}" Foreground="{StaticResource Pincel.Aviso}" FontWeight="SemiBold"
                             ToolTip="Hacienda − contabilidad" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Valor para el IS" Width="110" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding Valor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo.Importe}" Margin="0,1"
                           ToolTip="Retención o pago a cuenta que se deduce en el IS. Vacío: lo propuesto. Al salir del campo se recalcula" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Se usa" Binding="{Binding Usado}" Width="96" IsReadOnly="True" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTemplateColumn Header="Justificación" Width="1.3*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox x:Name="Justificacion" Text="{Binding Justificacion, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo}" MaxLength="255" Margin="0,1"
                           ToolTip="Por qué el valor no es el de Hacienda (certificado del pagador, justificante de pago…). Obligatoria si no es el de Hacienda" />
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding FaltaJustificacion}" Value="True">
                      <Setter TargetName="Justificacion" Property="BorderBrush" Value="{StaticResource Pincel.Aviso}" />
                      <Setter TargetName="Justificacion" Property="BorderThickness" Value="2" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding TituloDetalle}" Style="{StaticResource Texto.Seccion}" Margin="0,12,0,6" />

        <!-- Detalle del pagador elegido: apuntes contables y líneas de Hacienda -->
        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Contabilidad: apuntes de la 473" Style="{StaticResource Texto.Apagado}" Margin="0,0,0,4" />
            <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding ContrasteSeleccionado.Apuntes}" SelectedItem="{Binding ApunteSeleccionado}" IsReadOnly="True"
                      AutoGenerateColumns="False" HeadersVisibility="Column" RowStyle="{StaticResource Tabla.Fila}" ContextMenu="{StaticResource Menu.Apunte}"
                      AutomationProperties.Name="Apuntes del pagador" ToolTip="Apuntes que forman lo contabilizado. Clic derecho: ver el asiento o el Mayor">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="84" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Asiento" Binding="{Binding IdAsiento}" Width="70" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                <DataGridTextColumn Header="Cuenta" Binding="{Binding Cuenta}" Width="80" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                <DataGridTextColumn Header="Texto" Binding="{Binding Texto}" Width="*" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Importe" Binding="{Binding Importe}" Width="96" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Hacienda: líneas de los datos fiscales" Style="{StaticResource Texto.Apagado}" Margin="0,0,0,4" />
            <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding ContrasteSeleccionado.LineasHacienda}" IsReadOnly="True" AutoGenerateColumns="False"
                      HeadersVisibility="Column" RowStyle="{StaticResource Tabla.Fila}" AutomationProperties.Name="Líneas de Hacienda del pagador"
                      ToolTip="Lo que declaró el pagador a Hacienda (modelo 202: pagos fraccionados de la sociedad)">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="60" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                <DataGridTextColumn Header="NIF" Binding="{Binding Nif}" Width="90" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Importe" Binding="{Binding Importe}" Width="96" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Grid>

        <!-- Otras cifras de los datos fiscales -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Bases negativas pendientes según Hacienda" VerticalAlignment="Center" Margin="0,0,8,0"
                     ToolTip="Pérdidas fiscales de años anteriores pendientes de compensar según Hacienda; avisa si compensas más. Vacío: sin dato" />
          <TextBox Grid.Column="1" Text="{Binding BasesNegativasAeat, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo.Importe}"
                   AutomationProperties.Name="Bases negativas pendientes según Hacienda" />
          <TextBlock Grid.Column="3" Text="Resultado presentado (casilla 621)" VerticalAlignment="Center" Margin="0,0,8,0"
                     ToolTip="Resultado de la declaración del ejercicio ya presentada (negativo, a devolver); avisa si el cálculo no coincide. Vacío: sin presentar" />
          <TextBox Grid.Column="4" Text="{Binding ResultadoPresentado, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Campo.Importe}"
                   AutomationProperties.Name="Resultado presentado" />
        </Grid>
      </Grid>
    </pc:VistaEstado>
  </DockPanel>
</UserControl>
