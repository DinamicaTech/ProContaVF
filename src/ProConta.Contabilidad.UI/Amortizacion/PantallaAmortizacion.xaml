<UserControl x:Class="ProConta.Contabilidad.UI.Amortizacion.PantallaAmortizacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             Background="White">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <ContextMenu x:Key="Menu.Activo">
      <MenuItem Header="Mayor de la subcuenta de gasto (68)" Command="{Binding MayorGastoCommand}" ToolTipService.ShowOnDisabled="True"
                CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTip="Abre el Mayor de la 68 del activo: lo ya cargado este año, a mano o por este proceso" />
      <MenuItem Header="Mayor de la amortización acumulada (28)" Command="{Binding MayorAcumuladaCommand}" ToolTipService.ShowOnDisabled="True"
                CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTip="Abre el Mayor de la 28 del activo: de ahí sale lo ya amortizado y lo que queda pendiente" />
    </ContextMenu>
    <Style x:Key="Pastilla" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Pincel.AzulSuave}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="HECHO">
          <Setter Property="Background" Value="{StaticResource Pincel.VerdeSuave}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="DESACTUALIZADO">
          <Setter Property="Background" Value="{StaticResource Pincel.AvisoSuave}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera: acciones generales -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Periodicidad…" Style="{StaticResource Boton}" Command="{Binding PeriodicidadCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  ToolTip="Abre Parámetros y tablas › Ejercicios para cambiar la periodicidad de la amortización (anual, trimestral o mensual)" />
          <Button Content="Ver los asientos" Style="{StaticResource Boton}" Command="{Binding VerAsientoCommand}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"
                  ToolTip="Abre el primer asiento grabado del periodo elegido; hay uno por activo (solo si ya está hecho)" />
          <Button Content="Deshacer…" Style="{StaticResource Boton}" Command="{Binding DeshacerCommand}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"
                  ToolTip="Borra los asientos de amortización del periodo elegido, con motivo (las casillas desmarcadas se conservan)" />
          <Button Content="Actualizar" Style="{StaticResource Boton}" Command="{Binding RefrescarCommand}" VerticalAlignment="Center"
                  ToolTip="Vuelve a leer los activos, sus planes y subcuentas y lo contabilizado, y recalcula la propuesta (F5). Descarta lo cambiado sin confirmar" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Amortización de activos" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Text="{Binding TextoPeriodicidad}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding AyudaPeriodicidad}" />
          <Border CornerRadius="{StaticResource Radio.Pastilla}" Padding="8,1" VerticalAlignment="Center" ToolTip="{Binding AyudaEstado}" Style="{StaticResource Pastilla}">
            <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource Letra.Pequena}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Texto2}" />
          </Border>
          <TextBlock Text="{Binding AyudaEstado}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding AyudaEstado}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pie: confirmar lo que se ve -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Descartar cambios" Style="{StaticResource Boton}" Command="{Binding DescartarCommand}" Margin="0,0,8,0"
                  ToolTip="Vuelve a las casillas guardadas y borra el motivo escrito" />
          <Button Content="{Binding TextoConfirmar}" Style="{StaticResource Boton.Primario}" Command="{Binding ConfirmarCommand}" ToolTipService.ShowOnDisabled="True"
                  ToolTip="{Binding AyudaConfirmar}" MinWidth="90" />
        </StackPanel>
        <TextBlock Text="{Binding PorQueNoConfirmar}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PorQueNoConfirmar}" />
      </DockPanel>
    </Border>

    <pc:VistaEstado Estado="{Binding Estado}" Mensaje="{Binding MensajeEstado}" TextoAccion="Actualizar" ComandoAccion="{Binding RefrescarCommand}">
      <DockPanel Margin="14,10,14,8">
        <!-- Periodos del ejercicio -->
        <DataGrid DockPanel.Dock="Top" Style="{StaticResource Tabla}" ItemsSource="{Binding Periodos}" SelectedItem="{Binding Seleccion}" IsReadOnly="True"
                  SelectionMode="Single" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="190" Margin="0,0,0,10" HorizontalAlignment="Left"
                  RowStyle="{StaticResource Tabla.Fila}" AutomationProperties.Name="Periodos del ejercicio"
                  ToolTip="Periodos del ejercicio con su estado: elige uno para ver su propuesta">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Periodo" Binding="{Binding Nombre}" Width="120" ElementStyle="{StaticResource Texto.Celda}" />
            <DataGridTextColumn Header="Asiento del" Binding="{Binding Fecha}" Width="90" ElementStyle="{StaticResource Texto.Celda}" />
            <DataGridTemplateColumn Header="Estado" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border CornerRadius="{StaticResource Radio.Pastilla}" Padding="8,1" HorizontalAlignment="Left" Style="{StaticResource Pastilla}" ToolTip="{Binding Ayuda}">
                    <TextBlock Text="{Binding Estado}" FontSize="{StaticResource Letra.Pequena}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Texto2}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Asiento" Binding="{Binding Asiento}" Width="70" ElementStyle="{StaticResource Texto.Celda.Mono}" />
            <DataGridTextColumn Header="Grabado" Binding="{Binding Grabado}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTextColumn Header="Propuesto" Binding="{Binding Propuesto}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
          </DataGrid.Columns>
        </DataGrid>

        <DockPanel Visibility="{Binding HayPropuesta, Converter={StaticResource Visible}}">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Resumen}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0" />
            <TextBlock Text="{Binding TituloPropuesta}" Style="{StaticResource Texto.Seccion}" VerticalAlignment="Center" />
          </DockPanel>

          <pc:Nota DockPanel.Dock="Top" Tipo="Aviso" Margin="0,0,0,8" MaxWidth="1000" HorizontalAlignment="Left" Visibility="{Binding HayAvisos, Converter={StaticResource Visible}}">
            <ItemsControl ItemsSource="{Binding Avisos}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </pc:Nota>

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding PideMotivo, Converter={StaticResource Visible}}">
            <TextBlock Text="Motivo" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding AyudaMotivo}" />
            <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}" Width="520" MaxLength="255" VerticalAlignment="Center"
                     ToolTip="{Binding AyudaMotivo}" AutomationProperties.Name="Motivo" />
            <TextBlock Text="{Binding AyudaMotivo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="10,0,0,0" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
            <TextBlock Text="Total Debe (68)" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" />
            <TextBlock Text="{Binding TotalDebe}" Style="{StaticResource Texto.Importe}" Margin="0,0,18,0" />
            <TextBlock Text="Total Haber (28)" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" />
            <TextBlock Text="{Binding TotalHaber}" Style="{StaticResource Texto.Importe}" />
          </StackPanel>

          <!-- Activos -->
          <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding Filas}" AutoGenerateColumns="False" HeadersVisibility="Column"
                    CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" RowStyle="{StaticResource Tabla.Fila}"
                    HorizontalAlignment="Left" ContextMenu="{StaticResource Menu.Activo}" AutomationProperties.Name="Activos que se amortizan"
                    ToolTip="Activos amortizables con su cuota del periodo. Pasa el ratón por un activo para ver el cálculo. Clic derecho: Mayor de sus subcuentas">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="34">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Incluido, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Editable}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip="Marcado: se le hace su asiento. Desmárcalo para dejar fuera este activo en el ejercicio; se recuerda al volver a proponer" ToolTipService.ShowOnDisabled="True" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Activo" Width="260">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Texto.Celda}" ToolTip="{Binding AyudaFila}" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Codigo, Mode=OneWay}" FontFamily="Consolas" /> <Run Text="{Binding Nombre, Mode=OneWay}" />
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Centro de coste" Binding="{Binding Centro}" IsReadOnly="True" Width="150" ElementStyle="{StaticResource Texto.Celda}" />
              <DataGridTextColumn Header="Gasto" Binding="{Binding CuentaGasto}" IsReadOnly="True" Width="76" ElementStyle="{StaticResource Texto.Celda.Mono}" />
              <DataGridTextColumn Header="Acumulada" Binding="{Binding CuentaAcumulada}" IsReadOnly="True" Width="80" ElementStyle="{StaticResource Texto.Celda.Mono}" />
              <DataGridTextColumn Header="Base" Binding="{Binding Base}" IsReadOnly="True" Width="105" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              <DataGridTextColumn Header="%" Binding="{Binding Porcentaje}" IsReadOnly="True" Width="56" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              <DataGridTextColumn Header="Días" Binding="{Binding Dias}" IsReadOnly="True" Width="64" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              <DataGridTextColumn Header="Toca en el año" Binding="{Binding HastaFin}" IsReadOnly="True" Width="105" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              <DataGridTextColumn Header="Ya contabilizado" Binding="{Binding Ya}" IsReadOnly="True" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              <DataGridTextColumn Header="Pendiente" Binding="{Binding Pendiente}" IsReadOnly="True" Width="105" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              <DataGridTextColumn Header="Importe" Binding="{Binding Importe}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              <DataGridTemplateColumn Header="Nota" Width="260">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Nota}" Style="{StaticResource Texto.Celda}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nota}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </DockPanel>
    </pc:VistaEstado>
  </DockPanel>
</UserControl>
