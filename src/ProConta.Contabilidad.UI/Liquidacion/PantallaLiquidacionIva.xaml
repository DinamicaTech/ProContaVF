<UserControl x:Class="ProConta.Contabilidad.UI.Liquidacion.PantallaLiquidacionIva"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             Background="White">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <!-- Pastilla del estado del trimestre -->
    <DataTemplate x:Key="Plantilla.Estado">
      <Border x:Name="Pastilla" CornerRadius="{StaticResource Radio.Pastilla}" Padding="8,1" Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center"
              Background="{StaticResource Pincel.Fondo}" ToolTip="{Binding AyudaEstado}">
        <TextBlock x:Name="Texto" Text="{Binding Estado}" FontSize="{StaticResource Letra.Pequena}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Texto2}" />
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="LIQUIDADO">
          <Setter TargetName="Pastilla" Property="Background" Value="{StaticResource Pincel.VerdeSuave}" />
          <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource Pincel.Verde}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="PENDIENTE">
          <Setter TargetName="Pastilla" Property="Background" Value="{StaticResource Pincel.AzulSuave}" />
          <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource Pincel.Azul}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="DESACTUALIZADO">
          <Setter TargetName="Pastilla" Property="Background" Value="{StaticResource Pincel.AvisoSuave}" />
          <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource Pincel.Aviso}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="Fila.Ajuste" TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding EsAjuste}" Value="True">
          <Setter Property="Background" Value="{StaticResource Pincel.AvisoSuave}" />
          <Setter Property="ToolTip" Value="Línea de ajuste: lo que no cuadra entre lo liquidado, los libros de IVA y las cuentas" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <ContextMenu x:Key="Menu.Trimestres">
      <MenuItem Header="Volver a calcular" Command="{Binding RecalcularCommand}" InputGestureText="F9" ToolTipService.ShowOnDisabled="True"
                ToolTip="Vuelve a calcular la propuesta del trimestre elegido con los apuntes de ahora y el importe escrito" />
      <MenuItem Header="Ver el asiento" Command="{Binding VerAsientoCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre el asiento grabado de la liquidación del trimestre elegido (solo si ya está liquidado)" />
      <MenuItem Header="Mayor de sus cuentas de IVA" Command="{Binding MayorCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre el Mayor de las 472 y 477 que salda la propuesta, para revisar sus apuntes" />
      <Separator />
      <MenuItem Header="Deshacer la liquidación…" Command="{Binding DeshacerCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Borra el asiento de la liquidación del trimestre elegido, con motivo; el trimestre activo no cambia" />
    </ContextMenu>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
    <KeyBinding Key="F9" Command="{Binding RecalcularCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Actualizar" Style="{StaticResource Boton}" Command="{Binding RefrescarCommand}" VerticalAlignment="Center"
                ToolTip="Vuelve a leer los trimestres y su estado (F5)" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Liquidación de IVA" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pie: edición de la propuesta -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Descartar cambios" Style="{StaticResource Boton}" Command="{Binding DescartarCommand}" Margin="0,0,8,0"
                  ToolTip="Vuelve al importe calculado y borra el motivo escrito" />
          <Button Content="{Binding TextoConfirmar}" Style="{StaticResource Boton.Primario}" Command="{Binding ConfirmarCommand}" ToolTipService.ShowOnDisabled="True"
                  ToolTip="{Binding PorQueNoConfirmar, TargetNullValue='Graba exactamente el asiento de la propuesta como lote de la liquidación (repetirla lo sustituye) y, si el trimestre era el activo, activa el siguiente'}" />
        </StackPanel>
        <TextBlock Text="{Binding PorQueNoConfirmar}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <pc:VistaEstado Estado="{Binding Estado}" Mensaje="{Binding MensajeEstado}" TextoAccion="Actualizar" ComandoAccion="{Binding RefrescarCommand}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Trimestres -->
        <DataGrid Grid.Row="0" Style="{StaticResource Tabla}" ItemsSource="{Binding Trimestres}" SelectedItem="{Binding Seleccion}" IsReadOnly="True"
                  SelectionMode="Single" AutoGenerateColumns="False" ContextMenu="{StaticResource Menu.Trimestres}" Margin="14,10,14,6" MaxHeight="190"
                  RowStyle="{StaticResource Tabla.Fila}" HeadersVisibility="Column" AutomationProperties.Name="Trimestres del ejercicio"
                  ToolTip="Elige un trimestre para ver su propuesta. Clic derecho: ver el asiento, Mayor o deshacer">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Trimestre" Binding="{Binding Nombre}" Width="120" ElementStyle="{StaticResource Texto.Celda}" />
            <DataGridTextColumn Header="Hasta" Binding="{Binding Fin}" Width="90" ElementStyle="{StaticResource Texto.Celda}" />
            <DataGridTemplateColumn Header="Estado" Width="130" CellTemplate="{StaticResource Plantilla.Estado}" />
            <DataGridTemplateColumn Header="" Width="70">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Cerrado}" ToolTip="{Binding AyudaCerrado}" Style="{StaticResource Texto.Celda}" Foreground="{StaticResource Pincel.Texto2}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="303 calculado" Binding="{Binding Calculado}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTextColumn Header="Liquidado" Binding="{Binding Liquidado}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTextColumn Header="Compensado" Binding="{Binding Compensado}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTextColumn Header="Ajuste" Binding="{Binding Ajuste}" Width="100" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTextColumn Header="Situación" Binding="{Binding AyudaEstado}" Width="*" ElementStyle="{StaticResource Texto.Celda}" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Propuesta -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,1,0,0" Padding="14,10,14,8">
          <Grid>
            <TextBlock Text="{Binding TextoSinPropuesta}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                       Visibility="{Binding HayPropuesta, Converter={StaticResource Visible}, ConverterParameter=invertir}" />
            <DockPanel Visibility="{Binding HayPropuesta, Converter={StaticResource Visible}}">
              <TextBlock DockPanel.Dock="Top" Text="{Binding TituloPropuesta}" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,8" />

              <!-- Resumen e importe -->
              <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding Cifras}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,22,6" ToolTip="{Binding Ayuda}">
                        <TextBlock Text="{Binding Etiqueta}" Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" />
                        <TextBlock x:Name="Valor" Text="{Binding Valor}" Style="{StaticResource Texto.Importe}" HorizontalAlignment="Left" />
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Destacada}" Value="True">
                          <Setter TargetName="Valor" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </WrapPanel>

              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Importe a liquidar" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding AyudaImporte}" />
                <TextBox Text="{Binding Importe, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo.Importe}" Width="120" VerticalAlignment="Center"
                         ToolTip="{Binding AyudaImporte}" AutomationProperties.Name="Importe a liquidar">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding RecalcularCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <Button Content="Volver a calcular" Style="{StaticResource Boton.Pequeno}" Command="{Binding RecalcularCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="Calcula de nuevo la propuesta con los apuntes de ahora y el importe escrito (F9)" />
                <Button Content="Usar el calculado" Style="{StaticResource Boton.Enlace}" Command="{Binding UsarCalculadoCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="Vuelve a poner el resultado calculado desde los libros de IVA y quita el ajuste por el importe" />
                <TextBlock Text="{Binding Resultado}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0" />
              </StackPanel>

              <pc:Nota DockPanel.Dock="Top" Tipo="Aviso" Margin="0,0,0,8" MaxWidth="1000" HorizontalAlignment="Left" Visibility="{Binding HayAvisos, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Avisos}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </pc:Nota>

              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding PideMotivo, Converter={StaticResource Visible}}">
                <TextBlock Text="Motivo" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding AyudaMotivo}" />
                <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}" Width="520" MaxLength="255" VerticalAlignment="Center"
                         ToolTip="{Binding AyudaMotivo}" AutomationProperties.Name="Motivo" />
                <TextBlock Text="{Binding AyudaMotivo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="10,0,0,0" />
              </StackPanel>

              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <TextBlock Text="Total Debe" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding TotalDebe}" Style="{StaticResource Texto.Importe}" Margin="0,0,18,0" />
                <TextBlock Text="Total Haber" Style="{StaticResource Texto.Apagado}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding TotalHaber}" Style="{StaticResource Texto.Importe}" />
              </StackPanel>

              <!-- Asiento propuesto -->
              <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding Lineas}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                        RowStyle="{StaticResource Fila.Ajuste}" ContextMenu="{StaticResource Menu.Trimestres}" AutomationProperties.Name="Asiento propuesto">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Cuenta" Binding="{Binding Cuenta}" Width="90" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                  <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*" ElementStyle="{StaticResource Texto.Celda}" />
                  <DataGridTextColumn Header="Debe" Binding="{Binding Debe}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Haber" Binding="{Binding Haber}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
    </pc:VistaEstado>
  </DockPanel>
</UserControl>
