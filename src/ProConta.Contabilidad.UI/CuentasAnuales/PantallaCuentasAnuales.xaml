<UserControl x:Class="ProConta.Contabilidad.UI.CuentasAnuales.PantallaCuentasAnuales"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             Background="White">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <Style x:Key="Fila.Partida" TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
      <Setter Property="ToolTip" Value="{Binding Ayuda}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding EsTotal}" Value="True">
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Background" Value="{StaticResource Pincel.Fondo}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <ContextMenu x:Key="Menu.Partida">
      <MenuItem Header="Mayor de sus subcuentas" Command="{Binding MayorCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre el Mayor de las subcuentas que forman la partida elegida, en el ejercicio de las cuentas (no en los totales)" />
    </ContextMenu>
    <DataTemplate x:Key="Plantilla.Tabla">
      <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                RowStyle="{StaticResource Fila.Partida}" SelectionMode="Single"
                SelectedItem="{Binding DataContext.Seleccionada, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                ContextMenu="{StaticResource Menu.Partida}"
                AutomationProperties.Name="Partidas del modelo">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Clave" Binding="{Binding Clave}" Width="60" ElementStyle="{StaticResource Texto.Celda.Mono}" />
          <DataGridTextColumn Header="Partida" Binding="{Binding Partida}" Width="*" ElementStyle="{StaticResource Texto.Celda}" />
          <DataGridTextColumn Binding="{Binding Actual}" Width="140" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.ColumnaActual, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding Anterior}" Width="140" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.ColumnaAnterior, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera: ejercicio y acciones generales -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Cierre del ejercicio" Style="{StaticResource Boton}" Command="{Binding CierreCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  ToolTip="Abre Fin de ejercicio › Cierre del ejercicio: las cuentas anuales se formulan con el ejercicio cerrado" />
          <Button Content="Generar PDF…" Style="{StaticResource Boton.Primario}" Command="{Binding PdfCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  ToolTip="{Binding TextoPdf}" ToolTipService.ShowOnDisabled="True" />
          <Button Content="Actualizar" Style="{StaticResource Boton}" Command="{Binding RefrescarCommand}" VerticalAlignment="Center"
                  ToolTip="Vuelve a calcular las cuentas con los apuntes de ahora (F5)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Cuentas anuales" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <ComboBox ItemsSource="{Binding Ejercicios}" SelectedItem="{Binding Ejercicio}" DisplayMemberPath="Texto" Width="120" VerticalAlignment="Center" Margin="0,0,12,0"
                    AutomationProperties.Name="Ejercicio de las cuentas"
                    ToolTip="Ejercicio de las cuentas anuales; la otra columna es el ejercicio anterior. Por defecto, el anterior al de trabajo, que es el que se formula este año" />
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <pc:VistaEstado Estado="{Binding Estado}" Mensaje="{Binding MensajeEstado}" TextoAccion="Actualizar" ComandoAccion="{Binding RefrescarCommand}">
      <DockPanel Margin="14,10,14,8">
        <!-- Comprobaciones del Registro -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding ResumenComprobaciones}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
        <pc:Nota DockPanel.Dock="Top" Tipo="Aviso" Margin="0,0,0,8" MaxWidth="1100" HorizontalAlignment="Left" Visibility="{Binding HayIncidencias, Converter={StaticResource Visible}}">
          <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Incidencias}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,1,0,3">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icono}" Width="18" FontWeight="SemiBold" />
                    <StackPanel>
                      <TextBox Text="{Binding Titulo, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" TextWrapping="Wrap" Padding="0" />
                      <TextBox Text="{Binding Detalle, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Padding="0" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </pc:Nota>

        <!-- Subcuentas de la partida elegida -->
        <DockPanel DockPanel.Dock="Bottom" Height="190" Margin="0,8,0,0" Visibility="{Binding VerSubcuentas, Converter={StaticResource Visible}}">
          <TextBlock DockPanel.Dock="Top" Text="{Binding TituloSubcuentas}" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
          <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding Subcuentas}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                    RowStyle="{StaticResource Tabla.Fila}" ContextMenu="{StaticResource Menu.Partida}" AutomationProperties.Name="Subcuentas de la partida"
                    ToolTip="Subcuentas que forman la partida elegida, con lo que aporta cada una (con el signo de la partida). Clic derecho: Mayor de sus subcuentas">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Subcuenta" Binding="{Binding Cuenta}" Width="90" ElementStyle="{StaticResource Texto.Celda.Mono}" />
              <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" ElementStyle="{StaticResource Texto.Celda}" />
              <DataGridTextColumn Binding="{Binding Actual}" Width="140" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}">
                <DataGridTextColumn.Header>
                  <TextBlock Text="{Binding DataContext.ColumnaActual, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding Anterior}" Width="140" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}">
                <DataGridTextColumn.Header>
                  <TextBlock Text="{Binding DataContext.ColumnaAnterior, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </DataGridTextColumn.Header>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <!-- Los tres estados del modelo -->
        <TabControl SelectedIndex="{Binding Pestana}">
          <TabItem Header="Balance: activo" ToolTip="Página BP1 del modelo: activo no corriente y corriente con las claves oficiales">
            <ContentControl Content="{Binding Activo}" ContentTemplate="{StaticResource Plantilla.Tabla}" Focusable="False" />
          </TabItem>
          <TabItem Header="Balance: patrimonio neto y pasivo" ToolTip="Páginas BP2.1 y BP2.2 del modelo: patrimonio neto, pasivo no corriente y corriente">
            <ContentControl Content="{Binding PatrimonioNetoYPasivo}" ContentTemplate="{StaticResource Plantilla.Tabla}" Focusable="False" />
          </TabItem>
          <TabItem Header="Pérdidas y ganancias" ToolTip="Página PP del modelo: (Debe) en negativo y Haber en positivo, sin la regularización ni el cierre">
            <ContentControl Content="{Binding PerdidasYGanancias}" ContentTemplate="{StaticResource Plantilla.Tabla}" Focusable="False" />
          </TabItem>
          <TabItem Header="Memoria" ToolTip="Los apartados de la memoria del modelo pymes: el texto propuesto se corrige y se guarda por ejercicio; las tablas salen de la contabilidad">
            <DockPanel Margin="0,6,0,0">
              <ListBox DockPanel.Dock="Left" Width="300" ItemsSource="{Binding Memoria}" SelectedItem="{Binding Apartado}" DisplayMemberPath="Encabezado"
                       AutomationProperties.Name="Apartados de la memoria"
                       ToolTip="Apartados de la memoria. «(propuesto)»: aún tiene el texto que propone el programa; «*»: tiene cambios sin guardar" />
              <DockPanel Margin="12,0,0,0" DataContext="{Binding Apartado}">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Apartado.Encabezado}" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,6" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Content="Guardar el apartado" Style="{StaticResource Boton.Primario}" Margin="0,0,8,0"
                          Command="{Binding DataContext.GuardarApartadoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTipService.ShowOnDisabled="True"
                          ToolTip="Guarda el texto de este apartado para este ejercicio (sale en el PDF de las cuentas)" />
                  <Button Content="Volver al texto propuesto" Style="{StaticResource Boton}"
                          Command="{Binding DataContext.PropuestoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTipService.ShowOnDisabled="True"
                          ToolTip="Borra el texto guardado y vuelve al que propone el programa con las cifras de ahora" />
                </StackPanel>
                <TextBox DockPanel.Dock="Bottom" Text="{Binding Tablas, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MaxHeight="230"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,8,0,0" Visibility="{Binding HayTablas, Converter={StaticResource Visible}}"
                         AutomationProperties.Name="Tablas del apartado" ToolTip="Tablas que calcula el programa desde la contabilidad; salen así en el PDF y no se editan" />
                <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Texto del apartado"
                         ToolTip="Texto del apartado. Completa lo que va entre corchetes [ ]; se guarda con «Guardar el apartado»" />
              </DockPanel>
            </DockPanel>
          </TabItem>
        </TabControl>
      </DockPanel>
    </pc:VistaEstado>
  </DockPanel>
</UserControl>
