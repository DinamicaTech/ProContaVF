<Project Sdk="Microsoft.NET.Sdk">
  <!-- Piezas de interfaz de contabilidad reutilizables (docs/contabilidad/cuenta-contable.md): el buscador de cuentas con alta de subcuenta. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>ProConta.Contabilidad.UI</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProConta.UI.Base\ProConta.UI.Base.csproj" />
    <ProjectReference Include="..\ProConta.Contabilidad\ProConta.Contabilidad.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProConta.Compras.UI.Tests" />
  </ItemGroup>
</Project>
