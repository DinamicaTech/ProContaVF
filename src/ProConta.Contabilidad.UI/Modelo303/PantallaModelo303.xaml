<UserControl x:Class="ProConta.Contabilidad.UI.Modelo303.PantallaModelo303"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             Background="White">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <!-- Pastilla del estado del trimestre -->
    <DataTemplate x:Key="Plantilla.Estado">
      <Border x:Name="Pastilla" CornerRadius="{StaticResource Radio.Pastilla}" Padding="8,1" Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center"
              Background="{StaticResource Pincel.Fondo}" ToolTip="{Binding AyudaEstado}">
        <TextBlock x:Name="Texto" Text="{Binding Estado}" FontSize="{StaticResource Letra.Pequena}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Texto2}" />
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="PRESENTADO">
          <Setter TargetName="Pastilla" Property="Background" Value="{StaticResource Pincel.VerdeSuave}" />
          <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource Pincel.Verde}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="COMPLEMENTARIA">
          <Setter TargetName="Pastilla" Property="Background" Value="{StaticResource Pincel.VerdeSuave}" />
          <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource Pincel.Verde}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="SINPRESENTAR">
          <Setter TargetName="Pastilla" Property="Background" Value="{StaticResource Pincel.AzulSuave}" />
          <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource Pincel.Azul}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="DESACTUALIZADO">
          <Setter TargetName="Pastilla" Property="Background" Value="{StaticResource Pincel.AvisoSuave}" />
          <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource Pincel.Aviso}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="Fila.Total" TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Total}" Value="True">
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Background" Value="{StaticResource Pincel.Fondo}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <ContextMenu x:Key="Menu.Trimestres">
      <MenuItem Header="Ver el PDF" Command="{Binding VerPdfCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Pide a la AEAT el PDF oficial del 303 del trimestre elegido con sus casillas (valida el fichero; no presenta nada)" />
      <MenuItem Header="Presentar…" Command="{Binding PresentarCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Valida el 303 del trimestre elegido, enseña el PDF y sus datos para tu conformidad y lo presenta a la AEAT con el certificado de la sociedad (solo si aún no está presentado)" />
      <MenuItem Header="Presentar complementaria…" Command="{Binding ComplementariaCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Presenta una autoliquidación rectificativa del trimestre elegido, con el justificante de la anterior y lo que se ingresó en ella (solo si ya está presentado)" />
      <Separator />
      <MenuItem Header="Abrir el justificante" Command="{Binding JustificanteCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre el PDF justificante de la última presentación del trimestre elegido; si no se pudo archivar, lo vuelve a descargar de la AEAT" />
      <MenuItem Header="Liquidación de IVA del trimestre" Command="{Binding LiquidacionCommand}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre Contabilidad › Liquidación de IVA en el trimestre elegido: al presentar, lo liquidado tiene que ser lo presentado" />
    </ContextMenu>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Actualizar" Style="{StaticResource Boton}" Command="{Binding RefrescarCommand}" VerticalAlignment="Center"
                ToolTip="Vuelve a calcular el 303 de los cuatro trimestres y a leer lo presentado (F5)" />
        <Border DockPanel.Dock="Right" CornerRadius="{StaticResource Radio.Pastilla}" Padding="10,2" Margin="0,0,12,0" VerticalAlignment="Center"
                Background="{StaticResource Pincel.AvisoSuave}" Visibility="{Binding EsPruebas, Converter={StaticResource Visible}}" ToolTip="{Binding AyudaEntorno}">
          <TextBlock Text="PRUEBAS" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Aviso}" />
        </Border>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Modelo 303" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" ToolTip="{Binding AyudaEntorno}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <pc:VistaEstado Estado="{Binding Estado}" Mensaje="{Binding MensajeEstado}" TextoAccion="Actualizar" ComandoAccion="{Binding RefrescarCommand}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Trimestres -->
        <DataGrid Grid.Row="0" Style="{StaticResource Tabla}" ItemsSource="{Binding Trimestres}" SelectedItem="{Binding Seleccion}" IsReadOnly="True"
                  SelectionMode="Single" AutoGenerateColumns="False" ContextMenu="{StaticResource Menu.Trimestres}" Margin="14,10,14,6" MaxHeight="190"
                  RowStyle="{StaticResource Tabla.Fila}" HeadersVisibility="Column" AutomationProperties.Name="Trimestres del ejercicio"
                  ToolTip="Elige un trimestre para ver sus casillas. Clic derecho: ver el PDF, presentar, complementaria o justificante">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Trimestre" Binding="{Binding Nombre}" Width="110" ElementStyle="{StaticResource Texto.Celda}" />
            <DataGridTextColumn Header="Hasta" Binding="{Binding Fin}" Width="86" ElementStyle="{StaticResource Texto.Celda}" />
            <DataGridTemplateColumn Header="Estado" Width="140" CellTemplate="{StaticResource Plantilla.Estado}" />
            <DataGridTextColumn Header="Calculado" Binding="{Binding Calculado}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTextColumn Header="Presentado" Binding="{Binding Presentado}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
            <DataGridTextColumn Header="Forma de pago" Binding="{Binding FormaPago}" Width="120" ElementStyle="{StaticResource Texto.Celda}" />
            <DataGridTextColumn Header="CSV" Binding="{Binding Csv}" Width="150" ElementStyle="{StaticResource Texto.Celda.Mono}" />
            <DataGridTextColumn Header="Justificante" Binding="{Binding Justificante}" Width="120" ElementStyle="{StaticResource Texto.Celda.Mono}" />
            <DataGridTextColumn Header="Presentado el" Binding="{Binding Fecha}" Width="120" ElementStyle="{StaticResource Texto.Celda}" />
            <DataGridTextColumn Header="Situación" Binding="{Binding AyudaEstado}" Width="*" ElementStyle="{StaticResource Texto.Celda}" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Detalle del trimestre -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,1,0,0" Padding="14,10,14,8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding TituloDetalle}" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,8" />
            <pc:Nota DockPanel.Dock="Top" Tipo="Error" Margin="0,0,0,8" MaxWidth="1000" HorizontalAlignment="Left" Visibility="{Binding HayBloqueos, Converter={StaticResource Visible}}">
              <ItemsControl ItemsSource="{Binding Bloqueos}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,1"
                             ToolTip="Lo que impide presentar este trimestre y cómo resolverlo (se puede seleccionar y copiar)" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </pc:Nota>
            <pc:Nota DockPanel.Dock="Top" Tipo="Aviso" Margin="0,0,0,8" MaxWidth="1000" HorizontalAlignment="Left" Visibility="{Binding HayAvisos, Converter={StaticResource Visible}}">
              <ItemsControl ItemsSource="{Binding Avisos}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,1"
                             ToolTip="Aviso para revisar antes de presentar (se puede seleccionar y copiar)" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </pc:Nota>
            <TextBlock DockPanel.Dock="Top" Text="{Binding TextoDetalle}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding Casillas}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" HorizontalAlignment="Left"
                      RowStyle="{StaticResource Fila.Total}" ContextMenu="{StaticResource Menu.Trimestres}" AutomationProperties.Name="Casillas del 303"
                      ToolTip="Casillas del 303 que calcula el programa: son las del PDF de la AEAT («Ver el PDF»)">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Casilla" Binding="{Binding Casilla}" Width="64" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="460" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Importe" Binding="{Binding Importe}" Width="130" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>
    </pc:VistaEstado>
  </DockPanel>
</UserControl>
