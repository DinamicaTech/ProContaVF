<UserControl x:Class="ProConta.Activos.UI.Vistas.VistaAltaActivo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             Width="720">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <Style x:Key="Rotulo" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Letra.Pequena}" />
      <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style x:Key="Campo.Bloque" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,14,10" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{Binding TituloPaso}" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,10" />

    <!-- Paso 1: qué es -->
    <StackPanel Visibility="{Binding EnPaso1, Converter={StaticResource Visible}}">
      <TextBlock Text="Elige la clase de activo. De ella dependen sus subcuentas y las cuentas del plan contable que usa." TextWrapping="Wrap" Margin="0,0,0,8" />
      <ListBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ToolTip="La clase de activo: decide su plantilla de subcuentas" AutomationProperties.Name="Clase de activo">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="190" Margin="2,4">
              <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Cuentas}" Style="{StaticResource Texto.Apagado}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <CheckBox Content="No es de la sociedad, solo quiero guardar su información" IsChecked="{Binding EsAjeno}" Margin="0,10,0,0"
                ToolTip="Un activo ajeno (por ejemplo, el piso particular) no tiene subcuentas, centro de coste ni amortización, y no genera ningún asiento" />
    </StackPanel>

    <!-- Paso 2: la compra -->
    <StackPanel Visibility="{Binding EnPaso2, Converter={StaticResource Visible}}">
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="Datos de la compra. Si es un inmueble, también los del catastro: con ellos se calcula qué parte es construcción." />
      <WrapPanel>
        <StackPanel Style="{StaticResource Campo.Bloque}">
          <TextBlock Text="Nombre" Style="{StaticResource Rotulo}" />
          <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Width="380" MaxLength="255" ToolTip="Nombre completo, por ejemplo «Piso Calle del Roble 14, 2.º 1.ª». Va en el nombre de sus subcuentas" />
        </StackPanel>
        <StackPanel Style="{StaticResource Campo.Bloque}">
          <TextBlock Text="Nombre corto" Style="{StaticResource Rotulo}" />
          <TextBox Text="{Binding NombreCorto, UpdateSourceTrigger=PropertyChanged}" Width="200" MaxLength="100" ToolTip="Para listados, pestañas y el nombre de su centro de coste nuevo" />
        </StackPanel>
        <StackPanel Style="{StaticResource Campo.Bloque}">
          <TextBlock Text="Código" Style="{StaticResource Rotulo}" />
          <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" Width="180" MaxLength="40" ToolTip="Código corto y único en la sociedad; se propone a partir del nombre corto" />
        </StackPanel>
        <StackPanel Style="{StaticResource Campo.Bloque}">
          <TextBlock Text="Fecha de compra" Style="{StaticResource Rotulo}" />
          <TextBox Text="{Binding FechaCompra, UpdateSourceTrigger=PropertyChanged}" Width="110" ToolTip="dd/mm/aaaa. Desde este día empieza a amortizarse" />
        </StackPanel>
        <StackPanel Style="{StaticResource Campo.Bloque}" Visibility="{Binding Propio, Converter={StaticResource Visible}}">
          <TextBlock Text="Coste de compra (€)" Style="{StaticResource Rotulo}" />
          <TextBox Text="{Binding Coste, UpdateSourceTrigger=PropertyChanged}" Width="140" TextAlignment="Right" ToolTip="Precio más gastos de compra (notaría, registro, impuestos)" />
        </StackPanel>
      </WrapPanel>
      <WrapPanel Visibility="{Binding EsInmueble, Converter={StaticResource Visible}}">
        <StackPanel Style="{StaticResource Campo.Bloque}">
          <TextBlock Text="Referencia catastral" Style="{StaticResource Rotulo}" />
          <TextBox Text="{Binding Referencia, UpdateSourceTrigger=PropertyChanged}" Width="200" MaxLength="30" Style="{StaticResource Campo.Mono}" ToolTip="Los 20 caracteres del recibo del IBI" />
        </StackPanel>
        <StackPanel Style="{StaticResource Campo.Bloque}">
          <TextBlock Text="Valor catastral del suelo (€)" Style="{StaticResource Rotulo}" />
          <TextBox Text="{Binding Suelo, UpdateSourceTrigger=LostFocus}" Width="140" TextAlignment="Right" ToolTip="Del recibo del IBI" />
        </StackPanel>
        <StackPanel Style="{StaticResource Campo.Bloque}">
          <TextBlock Text="Valor catastral de la construcción (€)" Style="{StaticResource Rotulo}" />
          <TextBox Text="{Binding Construccion, UpdateSourceTrigger=LostFocus}" Width="140" TextAlignment="Right" ToolTip="Del recibo del IBI" />
        </StackPanel>
        <StackPanel Style="{StaticResource Campo.Bloque}">
          <TextBlock Text="Construcción (%)" Style="{StaticResource Rotulo}" />
          <TextBox Text="{Binding PorcentajeConstruccion, UpdateSourceTrigger=PropertyChanged}" Width="70" TextAlignment="Right"
                   ToolTip="Se calcula solo con los valores catastrales (construcción / total) y se puede corregir" />
        </StackPanel>
      </WrapPanel>
      <StackPanel Visibility="{Binding Propio, Converter={StaticResource Visible}}" Margin="0,4,0,0">
        <TextBlock Text="Centro de coste" Style="{StaticResource Rotulo}" />
        <RadioButton GroupName="Centro" IsChecked="{Binding CentroNuevo}" Margin="0,2" ToolTip="Recomendado: cada activo con su propio centro, para que su cuenta de resultados sea solo suya">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Crear uno nuevo dentro de" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding TextoPadre, Mode=OneWay}" IsReadOnly="True" Width="240" />
            <Button Content="Elegir…" Style="{StaticResource Boton.Pequeno}" Command="{Binding ElegirPadreCommand}" Margin="6,0,0,0" ToolTip="Elige el centro padre (por ejemplo INMUEBLES)" />
          </StackPanel>
        </RadioButton>
        <TextBlock Text="{Binding AyudaCentroNuevo}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" Margin="22,0,0,4" Visibility="{Binding CentroNuevo, Converter={StaticResource Visible}}" />
        <RadioButton GroupName="Centro" IsChecked="{Binding CentroExistente}" Margin="0,2" ToolTip="Usa un centro que ya existe">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Usar uno que ya existe" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding TextoCentro, Mode=OneWay}" IsReadOnly="True" Width="240" />
            <Button Content="Elegir…" Style="{StaticResource Boton.Pequeno}" Command="{Binding ElegirCentroCommand}" Margin="6,0,0,0" ToolTip="Elige el centro de coste entre los activos e imputables" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </StackPanel>

    <!-- Paso 3: la amortización -->
    <StackPanel Visibility="{Binding EnPaso3, Converter={StaticResource Visible}}">
      <TextBlock Text="Un activo ajeno no se amortiza: no hay nada que rellenar en este paso." TextWrapping="Wrap" Visibility="{Binding EsAjeno, Converter={StaticResource Visible}}" />
      <StackPanel Visibility="{Binding Propio, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding TextoHabitual}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <CheckBox Content="Se amortiza cada año" IsChecked="{Binding SeAmortiza}" Margin="0,0,0,10" ToolTip="Desmárcalo si no se amortiza (por ejemplo, un terreno)" />
        <WrapPanel Visibility="{Binding SeAmortiza, Converter={StaticResource Visible}}">
          <StackPanel Style="{StaticResource Campo.Bloque}">
            <TextBlock Text="% anual" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding PorcentajeAnual, UpdateSourceTrigger=PropertyChanged}" Width="70" TextAlignment="Right" ToolTip="Porcentaje de la base que se amortiza cada año" />
          </StackPanel>
          <StackPanel Style="{StaticResource Campo.Bloque}">
            <TextBlock Text="Base que se amortiza (€)" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Base, UpdateSourceTrigger=PropertyChanged}" Width="140" TextAlignment="Right" ToolTip="{Binding TextoBase}" />
          </StackPanel>
          <StackPanel Style="{StaticResource Campo.Bloque}">
            <TextBlock Text="Valor residual (€)" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Residual, UpdateSourceTrigger=PropertyChanged}" Width="110" TextAlignment="Right" ToolTip="Lo que no se amortiza al final (lo normal es 0)" />
          </StackPanel>
        </WrapPanel>
        <TextBlock Text="{Binding TextoBase}" Style="{StaticResource Texto.Apagado}" Visibility="{Binding SeAmortiza, Converter={StaticResource Visible}}" />
        <TextBlock Text="{Binding TextoCuota}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Visibility="{Binding SeAmortiza, Converter={StaticResource Visible}}" />
        <TextBlock Text="El asiento lo hace Contabilidad › Amortización de activos, una vez al año (o cada mes o trimestre si así está configurado)." Style="{StaticResource Texto.Apagado}"
                   TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>

    <!-- Paso 4: repaso -->
    <StackPanel Visibility="{Binding EnPaso4, Converter={StaticResource Visible}}">
      <TextBlock Text="Al pulsar «Crear el activo» el programa hará esto:" Margin="0,0,0,6" />
      <ItemsControl ItemsSource="{Binding Repaso}" Focusable="False" Margin="8,0,0,0">
        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='· {0}'}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <pc:Nota Tipo="Error" Margin="0,10,0,0" Visibility="{Binding HayErrores, Converter={StaticResource Visible}}">
      <TextBox Text="{Binding Errores, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Height="Auto" Padding="0"
               ToolTip="Lo que falta o está mal escrito en este paso. Puedes seleccionarlo y copiarlo" />
    </pc:Nota>
  </StackPanel>
</UserControl>
