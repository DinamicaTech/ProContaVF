<UserControl x:Class="ProConta.Activos.UI.Vistas.VistaFichaActivo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             xmlns:v="clr-namespace:ProConta.Activos.UI.Vistas"
             Background="White">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <Style x:Key="Rotulo" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Letra.Pequena}" />
      <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style x:Key="Campo.Bloque" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,16,10" />
    </Style>
    <Style x:Key="Bloque" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Pincel.Linea}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radio.Panel}" />
      <Setter Property="Padding" Value="14,10,14,4" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="MaxWidth" Value="1100" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Pastilla" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Pincel.VerdeSuave}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radio.Pastilla}" />
      <Setter Property="Padding" Value="8,1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="BAJA"><Setter Property="Background" Value="{StaticResource Pincel.Linea2}" /></DataTrigger>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="AJENO"><Setter Property="Background" Value="{StaticResource Pincel.MoradoSuave}" /></DataTrigger>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="PENDIENTEDECONTABILIZAR"><Setter Property="Background" Value="{StaticResource Pincel.AvisoSuave}" /></DataTrigger>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="PREVISTA"><Setter Property="Background" Value="{StaticResource Pincel.AzulSuave}" /></DataTrigger>
        <DataTrigger Binding="{Binding ClaseEstado}" Value="CALCULADA"><Setter Property="Background" Value="{StaticResource Pincel.Linea2}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FilaCuenta" TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
      <Setter Property="ToolTip" Value="{Binding Ayuda}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Clase}" Value="GRUPO">
          <Setter Property="Background" Value="{StaticResource Pincel.Linea2}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Clase}" Value="TOTAL">
          <Setter Property="Background" Value="{StaticResource Pincel.Fondo2}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Clase}" Value="RESULTADO">
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="BorderBrush" Value="{StaticResource Pincel.Tinta}" />
          <Setter Property="BorderThickness" Value="0,2,0,0" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Clase}" Value="CALCULADA">
          <Setter Property="FontStyle" Value="Italic" />
          <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Celda.ImporteCuenta" TargetType="TextBlock" BasedOn="{StaticResource Texto.Celda.Importe}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Negativo}" Value="True"><Setter Property="Foreground" Value="{StaticResource Pincel.RojoSaldo}" /></DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Activos financieros (los mismos estilos que la cartera) -->
    <v:IgualConverter x:Key="Igual" />
    <Style x:Key="Texto.Tono" TargetType="TextBlock">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="Bueno"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="Malo"><Setter Property="Foreground" Value="{StaticResource Pincel.RojoSaldo}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Celda.Tono" TargetType="TextBlock" BasedOn="{StaticResource Texto.Celda.Importe}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="Bueno"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="Malo"><Setter Property="Foreground" Value="{StaticResource Pincel.RojoSaldo}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Muestra" TargetType="Border">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="3" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <DataTemplate x:Key="Plantilla.Proyeccion">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
          <!-- Proyección (ergonomía de activos 2026-11-26): la conclusión grande arriba, las señales en una tabla compacta con su color y la escala en el
               texto de ayuda -->
          <Border BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" Background="White"
                  HorizontalAlignment="Left" MinWidth="420" Cursor="Help" Visibility="{Binding HaySenales, Converter={StaticResource Visible}}">
            <Border.ToolTip>
              <ToolTip MaxWidth="460"><TextBlock Text="{Binding ExplicacionValoracion}" TextWrapping="Wrap" /></ToolTip>
            </Border.ToolTip>
            <StackPanel>
              <TextBlock Text="Cómo está hoy, según su cotización" Style="{StaticResource Texto.Apagado}" />
              <TextBlock Text="{Binding Valoracion}" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,2">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding TonoValoracion}" Value="Bueno"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
                      <DataTrigger Binding="{Binding TonoValoracion}" Value="Malo"><Setter Property="Foreground" Value="{StaticResource Pincel.RojoSaldo}" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding ResumenSenales}" Foreground="{StaticResource Pincel.Texto2}" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding ExplicacionValoracion}" Style="{StaticResource Texto.Apagado}" Visibility="{Binding HaySenales, Converter={StaticResource Visible}, ConverterParameter=invertir}" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Senales}" Focusable="False" Margin="0,0,0,14" HorizontalAlignment="Left" MaxWidth="1100">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="0,5" ToolTip="{Binding Detalle}" Background="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="12" /><ColumnDefinition Width="230" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{StaticResource Pincel.Linea3}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Tono}" Value="Bueno"><Setter Property="Fill" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tono}" Value="Malo"><Setter Property="Fill" Value="{StaticResource Pincel.RojoSaldo}" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding Titulo}" Foreground="{StaticResource Pincel.Texto2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Lectura}" FontWeight="SemiBold" Style="{StaticResource Texto.Tono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Explicacion}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Visibility="{Binding HayPivotes, Converter={StaticResource Visible}}" Margin="0,0,0,12">
            <TextBlock Text="{Binding TituloPivotes}" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,4"
                       ToolTip="Puntos pivote clásicos con el precio más alto, el más bajo y el último del mes anterior: precios donde es habitual que una subida o una bajada se frene" />
            <ItemsControl ItemsSource="{Binding Pivotes}" Focusable="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" HorizontalAlignment="Left" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12,4" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,1,0" ToolTip="{Binding Ayuda}" Background="Transparent">
                    <StackPanel>
                      <TextBlock Text="{Binding Nombre}" Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding Precio}" HorizontalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers><DataTrigger Binding="{Binding EsPivote}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Text="Qué podría valer la posición (estimación)" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,4" />
          <TextBlock Text="{Binding SinProyeccion}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Visibility="{Binding HayEscenarios, Converter={StaticResource Visible}, ConverterParameter=invertir}" />
          <StackPanel Visibility="{Binding HayEscenarios, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding ExplicacionEscenarios}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <Grid HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" /><ColumnDefinition Width="210" /><ColumnDefinition Width="210" /><ColumnDefinition Width="210" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Escenario" Style="{StaticResource Texto.Apagado}" />
              <TextBlock Grid.Column="1" Text="En 1 año" Style="{StaticResource Texto.Apagado}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="2" Text="En 3 años" Style="{StaticResource Texto.Apagado}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Text="En 5 años" Style="{StaticResource Texto.Apagado}" HorizontalAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Escenarios}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,1,0,0" Padding="0,5" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Nombre}" Width="120" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Ayuda}" />
                      <ItemsControl ItemsSource="{Binding Celdas}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Width="210">
                              <TextBlock Text="{Binding Valor}" Style="{StaticResource Texto.Importe}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Diferencia}" FontSize="{StaticResource Letra.Pequena}" HorizontalAlignment="Right" Style="{StaticResource Texto.Tono}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="El prudente es lo que saldría con una racha mala de las habituales; el optimista, con una buena. Cuanto más largo es el plazo, más se compensan los años buenos con los malos, por eso el rango anual se estrecha. Puede salir peor o mejor que los dos." />
          </StackPanel>
          <TextBlock Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="1100" HorizontalAlignment="Left"
                     Text="Las señales salen de los indicadores habituales del análisis técnico (medias, RSI, MACD, Bandas de Bollinger, ADX…) calculados con las cotizaciones diarias y traducidos a frases. La proyección es una estimación con lo que ha rendido el activo en el pasado; no es una previsión ni una garantía." />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <TextBlock Text="{Binding EstadoCotizaciones}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="0,0,12,0"
                     Visibility="{Binding EsFinanciero, Converter={StaticResource Visible}}" />
          <Button Content="Nueva compra…" Style="{StaticResource Boton.Primario}" Command="{Binding NuevaCompraCommand}" Margin="0,0,8,0"
                  Visibility="{Binding EsFinanciero, Converter={StaticResource Visible}}" ToolTipService.ShowOnDisabled="True"
                  ToolTip="Anota otra compra de participaciones: fecha (hoy por defecto) y participaciones; el precio del día se consulta solo" />
          <Button Content="Vender…" Style="{StaticResource Boton}" Command="{Binding VenderCommand}" Margin="0,0,8,0"
                  Visibility="{Binding EsFinanciero, Converter={StaticResource Visible}}" ToolTipService.ShowOnDisabled="True"
                  ToolTip="Anota una venta de participaciones: participaciones, fecha (hoy por defecto) e importe total (opcional; si no, con el precio del día). Si no le quedan, el activo pasa a inactivo" />
          <Button Content="Ver el Mayor" Style="{StaticResource Boton}" Command="{Binding MayorCommand}" Margin="0,0,8,0" Visibility="{Binding Propio, Converter={StaticResource Visible}}"
                  ToolTip="Abre el Mayor con todas las subcuentas del activo en el ejercicio de trabajo" />
          <Button Content="Actualizar" Style="{StaticResource Boton}" Command="{Binding RefrescarCommand}"
                  ToolTip="Vuelve a leer el activo, sus cifras y sus subcuentas (F5); en un activo financiero, también sus cotizaciones. Si hay cambios sin guardar, pregunta antes" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{Binding Nombre}" Style="{StaticResource Texto.TituloPantalla}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nombre}" />
          <WrapPanel Margin="0,4,0,0">
            <TextBlock Text="{Binding Codigo}" Style="{StaticResource Texto.Mono}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Código del activo" />
            <TextBlock Text="{Binding TipoTexto}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Tipo de activo" />
            <Border Style="{StaticResource Pastilla}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="En uso, inactivo (con fecha de baja) o ajeno a la sociedad">
              <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource Letra.Pequena}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Texto2}" />
            </Border>
            <TextBlock Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding Propio, Converter={StaticResource Visible}}"
                       ToolTip="Centro de coste del activo: en él se apuntan sus gastos e ingresos">
              <Run Text="Centro:" /> <Run Text="{Binding CentroTexto, Mode=OneWay}" Foreground="{StaticResource Pincel.Tinta}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Visibility="{Binding Propio, Converter={StaticResource Visible}}"
                       ToolTip="Actividad de IVA, heredada de su centro de coste">
              <Run Text="Actividad:" /> <Run Text="{Binding ActividadTexto, Mode=OneWay}" Foreground="{StaticResource Pincel.Tinta}" />
            </TextBlock>
          </WrapPanel>
          <TextBlock Text="{Binding MetaFinanciero}" Style="{StaticResource Texto.Apagado}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                     Visibility="{Binding MetaFinanciero, Converter={StaticResource Visible}}" ToolTip="Clase, ISIN, símbolo con el que se consulta la cotización y bolsa" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Indicadores del ejercicio de trabajo -->
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Indicadores}" Margin="14,10,14,0" Focusable="False" Visibility="{Binding Propio, Converter={StaticResource Visible}}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="1" CornerRadius="{StaticResource Radio.Panel}" Padding="12,7" Margin="0,0,10,6" MinWidth="170"
                  ToolTip="{Binding Tip}">
            <StackPanel>
              <TextBlock Text="{Binding Titulo}" Style="{StaticResource Rotulo}" />
              <TextBlock Text="{Binding Valor}" FontSize="{StaticResource Letra.Subtitulo}" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Negativo}" Value="True"><Setter Property="Foreground" Value="{StaticResource Pincel.RojoSaldo}" /></DataTrigger>
                      <DataTrigger Binding="{Binding Positivo}" Value="True"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding Detalle}" Style="{StaticResource Rotulo}" Margin="0,2,0,0" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Avisos al actualizar las cotizaciones de un activo financiero -->
    <pc:Nota DockPanel.Dock="Top" Tipo="Aviso" Margin="14,6,14,0" Visibility="{Binding HayAvisosCotizaciones, Converter={StaticResource Visible}}">
      <TextBlock Text="{Binding TextoAvisosCotizaciones}" TextWrapping="Wrap" />
    </pc:Nota>

    <!-- Pie: guardar o cancelar los datos -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}" Visibility="{Binding EnDatos, Converter={StaticResource Visible}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Cancelar" Style="{StaticResource Boton}" Command="{Binding CancelarCommand}" Margin="0,0,8,0" MinWidth="80"
                  ToolTip="Deshace los cambios que no has guardado y vuelve a lo guardado" />
          <Button Content="Guardar" Style="{StaticResource Boton.Primario}" Command="{Binding GuardarCommand}" MinWidth="80"
                  ToolTip="Guarda los datos del activo (Ctrl+G). Si cambias el tipo o la marca de ajeno, antes te enseña qué pasará con sus subcuentas" />
        </StackPanel>
        <TextBlock Text="{Binding PieDatos}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PieDatos}" />
      </DockPanel>
    </Border>

    <pc:VistaEstado Estado="{Binding Estado}" Mensaje="{Binding MensajeEstado}" TextoAccion="Actualizar" ComandoAccion="{Binding RefrescarCommand}">
      <TabControl SelectedIndex="{Binding IndiceApartado}" Margin="14,10,14,8">
        <!-- ========== Activos financieros (ergonomía de activos 2026-11-26): su análisis vive en su ficha ========== -->
        <TabItem Header="Cotización" Visibility="{Binding VerCotizacion, Converter={StaticResource Visible}}"
                 ToolTip="Cotización histórica en euros con el precio medio de compra y las compras y ventas">
          <DockPanel Margin="0,10,0,0" DataContext="{Binding Analisis}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <Border DockPanel.Dock="Right" Style="{StaticResource Segmentado}" ToolTip="Periodo que se ve en el gráfico">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource Segmento}" Content="6M" GroupName="FPer" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=6M}" ToolTip="Últimos 6 meses" />
                  <RadioButton Style="{StaticResource Segmento}" Content="1A" GroupName="FPer" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=1A}" ToolTip="Último año" />
                  <RadioButton Style="{StaticResource Segmento}" Content="3A" GroupName="FPer" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=3A}" ToolTip="Últimos 3 años" />
                  <RadioButton Style="{StaticResource Segmento}" Content="5A" GroupName="FPer" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=5A}" ToolTip="Últimos 5 años" />
                  <RadioButton Style="{StaticResource Segmento}" Content="Máx." GroupName="FPer" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=Máx.}" ToolTip="Todo el histórico guardado" />
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding ExplicacionCotizacion}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
              <Border Style="{StaticResource Muestra}" Background="#2a78d6" /><TextBlock Text="{Binding NombrePrecio}" Style="{StaticResource Texto.Apagado}" Margin="0,0,14,0" />
              <Border Style="{StaticResource Muestra}" Background="#802a78d6" Height="1.5" /><TextBlock Text="Sin participaciones" Style="{StaticResource Texto.Apagado}" Margin="0,0,14,0" />
              <Border Style="{StaticResource Muestra}" Background="#eb6834" /><TextBlock Text="Precio medio de compra" Style="{StaticResource Texto.Apagado}" Margin="0,0,14,0" />
              <TextBlock Text="▲ Compra   ▼ Venta · Pasa el ratón para ver el precio de cada día" Style="{StaticResource Texto.Apagado}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding OrigenCotizacion}" Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <pc:GraficoTemporal Datos="{Binding DatosCotizacion}" FormatoEje="{Binding FormatoEje}" MinHeight="200" />
          </DockPanel>
        </TabItem>

        <TabItem Header="Lotes" Visibility="{Binding EsFinanciero, Converter={StaticResource Visible}}"
                 ToolTip="Cada compra es un lote; cada venta reduce todos los lotes en la misma proporción (coste medio ponderado)">
          <DockPanel Margin="0,10,0,0" DataContext="{Binding Analisis}">
            <TextBlock DockPanel.Dock="Top" Text="Cada compra es un lote. Al vender, el coste de lo vendido es el coste medio ponderado (el de la contabilidad): cada venta reduce todos los lotes en la misma proporción." Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <pc:TablaProConta ItemsSource="{Binding Lotes}" ClavePreferencias="activos.ficha.lotes" TituloExportacion="Lotes" IsReadOnly="True" AutomationProperties.Name="Lotes del activo"
                              HorizontalAlignment="Left">
              <pc:TablaProConta.Columns>
                <DataGridTextColumn Header="Comprado" Binding="{Binding Comprado}" Width="SizeToCells" MinWidth="96" ElementStyle="{StaticResource Texto.Celda.Mono}" pc:TablaProConta.Clave="comprado" />
                <DataGridTextColumn Header="Compradas" Binding="{Binding Compradas}" Width="100" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="compradas" />
                <DataGridTextColumn Header="Quedan" Binding="{Binding Quedan}" Width="90" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="quedan" />
                <DataGridTextColumn Header="Precio (con comisión)" Binding="{Binding Precio}" Width="140" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="precio"
                                    pc:TablaProConta.Ayuda="Coste del lote entre sus participaciones" />
                <DataGridTextColumn Header="Coste" Binding="{Binding Coste}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="coste" />
                <DataGridTextColumn Header="Valor hoy" Binding="{Binding Valor}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="valor" />
                <DataGridTextColumn Header="Plusvalía" Binding="{Binding Plusvalia}" Width="110" ElementStyle="{StaticResource Celda.Tono}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="plusvalia" />
                <DataGridTextColumn Header="%" Binding="{Binding Porcentaje}" Width="72" ElementStyle="{StaticResource Celda.Tono}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="porcentaje" />
                <DataGridTextColumn Header="Anual" Binding="{Binding Anual}" Width="72" ElementStyle="{StaticResource Celda.Tono}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="anual"
                                    pc:TablaProConta.Ayuda="Rentabilidad anual del lote (TIR); «—» con menos de un año" />
                <DataGridTextColumn Header="Tiempo en cartera" Binding="{Binding Tiempo}" Width="150" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="tiempo" />
              </pc:TablaProConta.Columns>
            </pc:TablaProConta>
          </DockPanel>
        </TabItem>

        <TabItem Header="Operaciones" Visibility="{Binding EsFinanciero, Converter={StaticResource Visible}}"
                 ToolTip="Las compras y ventas de participaciones, con el coste de cada lote y el resultado de cada venta. Se anotan con «Nueva compra…» y «Vender…» de la cabecera">
          <DockPanel Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="{Binding TotalOperaciones}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding TextoInstrumento}" />
              <Border Width="17" Height="17" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource Pincel.Linea3}" Margin="10,0,0,0" Cursor="Help" VerticalAlignment="Center"
                      ToolTip="El precio es el de cierre que dio el proveedor (orientativo). Cuando el bróker te confirme el importe, cámbialo con doble clic o con el menú contextual. No se graba ningún asiento: el de la compra o la venta se genera desde su movimiento en Líneas N43 («Compra de activo…» o «Venta de activo…»), que pone el importe del banco y la deja conciliada. Las ventas se llevan el coste medio de lo vendido.">
                <TextBlock Text="i" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Apagado}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
            <DataGrid x:Name="TablaOperaciones" Style="{StaticResource Tabla}" ItemsSource="{Binding FilasOperaciones}" SelectedItem="{Binding OperacionElegida}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" SelectionMode="Single" HorizontalAlignment="Left" MouseDoubleClick="Abrible_MouseDoubleClick" AutomationProperties.Name="Operaciones del activo financiero">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Cambiar el importe…" Command="{Binding CambiarCosteCommand}" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Pone el importe total que te ha confirmado el bróker para la compra o venta marcada; el coste del activo se recalcula (no en las ya conciliadas con el banco)" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}"><Setter Property="ToolTip" Value="{Binding Ayuda}" /></Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="SizeToCells" MinWidth="96" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                <DataGridTextColumn Header="Operación" Binding="{Binding Tipo}" Width="80" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Participaciones" Binding="{Binding Participaciones}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn x:Name="ColPrecio" Header="Precio" Binding="{Binding Precio}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn x:Name="ColCambio" Header="Cambio" Binding="{Binding Cambio}" Width="80" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn x:Name="ColPrecioEur" Header="Precio real (€)" Binding="{Binding PrecioEur}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="Importe" Binding="{Binding Coste}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="Resultado" Binding="{Binding Resultado}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="Banco" Binding="{Binding Banco}" Width="100" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Origen del precio" Binding="{Binding Notas}" Width="340" ElementStyle="{StaticResource Texto.Celda}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <TabItem Header="Proyección" Visibility="{Binding VerCotizacion, Converter={StaticResource Visible}}"
                 ToolTip="Cómo está hoy según el análisis técnico y qué podría valer la posición (estimación)">
          <ContentControl Content="{Binding Analisis}" ContentTemplate="{StaticResource Plantilla.Proyeccion}" Margin="0,10,0,0" Focusable="False" />
        </TabItem>

        <!-- ========== Datos ========== -->
        <TabItem Header="Datos" ToolTip="Identificación, compra, datos del inmueble y amortización del activo">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,0">
            <StackPanel>
              <pc:Nota Tipo="Info" Margin="0,0,0,12" MaxWidth="1100" HorizontalAlignment="Left" Visibility="{Binding EsAjeno, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding AvisoAjeno}" TextWrapping="Wrap" />
              </pc:Nota>

              <Border Style="{StaticResource Bloque}">
                <StackPanel>
                  <TextBlock Text="Identificación" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,8" />
                  <WrapPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Código" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding CodigoActivo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="180" MaxLength="40"
                               ToolTip="Código corto del activo, único en la sociedad (por ejemplo GavaPoveda). Sirve para buscarlo" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Nombre" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding NombreActivo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="380" MaxLength="255"
                               ToolTip="Nombre completo del activo. Se usa en el nombre de sus subcuentas (si lo cambias, «Generar las que falten…» las renombra)" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Nombre corto" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding NombreCorto, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="200" MaxLength="100"
                               ToolTip="Nombre abreviado para listados y pestañas" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tipo" Style="{StaticResource Rotulo}" />
                        <!-- Candado en lugar del aviso amarillo (ergonomía de activos 2026-11-26): el motivo, al pasar el ratón -->
                        <Border Background="Transparent" Margin="6,0,0,3" VerticalAlignment="Center" ToolTip="{Binding MotivoBloqueo}"
                                Visibility="{Binding MotivoBloqueo, Converter={StaticResource Visible}}">
                          <Path Data="M3,7 L3,5 A3.5,3.5 0 0 1 10,5 L10,7 M1.5,7 H11.5 V14 H1.5 Z" Stroke="{StaticResource Pincel.Apagado}" StrokeThickness="1.4"
                                Width="13" Height="15" Stretch="Uniform" />
                        </Border>
                      </StackPanel>
                      <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo, ValidatesOnNotifyDataErrors=True}" DisplayMemberPath="Nombre" Width="200"
                                IsEnabled="{Binding TipoCambiable}" ToolTipService.ShowOnDisabled="True"
                                ToolTip="El tipo decide la plantilla de subcuentas y las cuentas del plan contable que usa. Solo se puede cambiar si sus subcuentas no tienen apuntes en los últimos cinco ejercicios" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}" VerticalAlignment="Bottom">
                      <CheckBox Content="Es ajeno a la sociedad" IsChecked="{Binding EsAjeno}" IsEnabled="{Binding TipoCambiable}" Margin="0,0,0,6" ToolTipService.ShowOnDisabled="True"
                                ToolTip="Márcalo si el activo no es de la sociedad y solo quieres guardar su información (por ejemplo, el piso particular): no tendrá subcuentas, centro ni amortización" />
                    </StackPanel>
                  </WrapPanel>
                  <StackPanel Style="{StaticResource Campo.Bloque}">
                    <TextBlock Text="Notas" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo.Multilinea}" Width="800" HorizontalAlignment="Left" MinHeight="48"
                             ToolTip="Texto libre sobre el activo" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Bloque}">
                <StackPanel>
                  <TextBlock Text="Compra" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,8" />
                  <pc:Nota Tipo="Info" Margin="0,0,0,10" Visibility="{Binding EsFinanciero, Converter={StaticResource Visible}}">
                    <TextBlock TextWrapping="Wrap" Text="En un activo financiero, la fecha de compra es la del primer lote y el coste es la suma del coste de sus lotes: se cambian en el apartado Operaciones." />
                  </pc:Nota>
                  <WrapPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Fecha de compra" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding FechaCompra, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="110" IsReadOnly="{Binding EsFinanciero}"
                               ToolTip="dd/mm/aaaa. Normalmente desde este día se amortiza (en un activo financiero, la del primer lote)" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}" Visibility="{Binding VerCompraPropia, Converter={StaticResource Visible}}">
                      <TextBlock Text="Coste de compra (€)" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding Coste, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="140" TextAlignment="Right" IsReadOnly="{Binding EsFinanciero}"
                               ToolTip="Precio más gastos de compra (notaría, registro, impuestos). Es el importe de alta del activo (en un activo financiero, la suma de sus lotes)" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}" Visibility="{Binding VerCompraPropia, Converter={StaticResource Visible}}">
                      <TextBlock Text="Centro de coste" Style="{StaticResource Rotulo}" />
                      <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Centro, Mode=OneWay, ValidatesOnNotifyDataErrors=True}" IsReadOnly="True" Width="260"
                                 ToolTip="Centro de coste del activo: en él se apuntan sus gastos e ingresos y de él hereda la actividad de IVA" />
                        <Button Content="Elegir…" Style="{StaticResource Boton}" Command="{Binding ElegirCentroCommand}" Margin="6,0,0,0"
                                ToolTip="Elige el centro de coste del activo entre los centros activos e imputables de la sociedad" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}" Visibility="{Binding VerCompraPropia, Converter={StaticResource Visible}}">
                      <TextBlock Text="Actividad de IVA" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding ActividadTexto, Mode=OneWay}" IsReadOnly="True" Width="220" ToolTip="La hereda de su centro de coste; se cambia en el árbol de centros de coste" />
                    </StackPanel>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Bloque}" Visibility="{Binding VerInmueble, Converter={StaticResource Visible}}">
                <StackPanel>
                  <TextBlock Text="Datos del inmueble" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,2" />
                  <TextBlock Text="El % de construcción sale de los valores catastrales y decide qué parte del coste se amortiza: el suelo no se amortiza." Style="{StaticResource Texto.Apagado}"
                             Margin="0,0,0,8" TextWrapping="Wrap" />
                  <WrapPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Referencia catastral" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding Referencia, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="200" MaxLength="30" Style="{StaticResource Campo.Mono}"
                               ToolTip="Los 20 caracteres de la referencia catastral del recibo del IBI" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Valor catastral del suelo (€)" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding Suelo, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}" Width="140" TextAlignment="Right" ToolTip="Del recibo del IBI" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Valor catastral de la construcción (€)" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding Construccion, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}" Width="140" TextAlignment="Right" ToolTip="Del recibo del IBI" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Construcción (%)" Style="{StaticResource Rotulo}" />
                      <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding PorcentajeConstruccion, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="70" TextAlignment="Right"
                                 ToolTip="Valor de la construcción sobre el total catastral. Se calcula solo al cambiar los valores catastrales y se puede corregir" />
                        <Button Content="Calcular" Style="{StaticResource Boton.Pequeno}" Command="{Binding CalcularConstruccionCommand}" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="Vuelve a calcular el % con los valores catastrales (construcción / suelo + construcción)" />
                      </StackPanel>
                    </StackPanel>
                  </WrapPanel>
                  <WrapPanel Visibility="{Binding VerCompraPropia, Converter={StaticResource Visible}}">
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Alquiler mensual (€)" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding Alquiler, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="120" TextAlignment="Right" ToolTip="Renta mensual del contrato en vigor" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Inicio del alquiler" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding InicioAlquiler, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="110" ToolTip="dd/mm/aaaa: inicio del contrato en vigor" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Tributo metropolitano (€)" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding Tributo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="120" TextAlignment="Right" ToolTip="Importe anual del tributo metropolitano" />
                    </StackPanel>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Bloque}" Visibility="{Binding VerAmortizacion, Converter={StaticResource Visible}}">
                <StackPanel>
                  <TextBlock Text="Amortización" Style="{StaticResource Texto.Seccion}" Margin="0,0,0,8" />
                  <CheckBox Content="Se amortiza cada año" IsChecked="{Binding SeAmortiza}" Margin="0,0,0,10"
                            ToolTip="Desmárcalo si el activo no se amortiza (un terreno, por ejemplo): el proceso de amortización lo dejará fuera" />
                  <WrapPanel Visibility="{Binding VerPlan, Converter={StaticResource Visible}}">
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Desde" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding InicioAmortizacion, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="110"
                               ToolTip="dd/mm/aaaa: desde qué día se amortiza (normalmente, la fecha de compra). El primer año cuenta solo los días desde esa fecha" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Base que se amortiza (€)" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding Base, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="140" TextAlignment="Right"
                               ToolTip="Coste por el % de construcción en un inmueble (el suelo no se amortiza); el coste entero en los demás" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Valor residual (€)" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding Residual, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="120" TextAlignment="Right"
                               ToolTip="Lo que no se amortiza al final de su vida (lo normal es 0)" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="% anual" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding PorcentajeAnual, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Width="70" TextAlignment="Right"
                               ToolTip="Porcentaje de la base que se amortiza cada año (3 en inmuebles, 16 en vehículos…)" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo.Bloque}">
                      <TextBlock Text="Cuota de un año completo" Style="{StaticResource Rotulo}" />
                      <TextBox Text="{Binding CuotaAnual, Mode=OneWay}" IsReadOnly="True" Width="140" TextAlignment="Right" ToolTip="Base × % anual: lo que se amortiza en un año entero" />
                    </StackPanel>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ========== Cuenta de resultados ========== -->
        <TabItem Header="Cuenta de resultados" Visibility="{Binding VerNoFinanciero, Converter={StaticResource Visible}}"
                 ToolTip="Ingresos y gastos del activo por subcuenta, en resumen o por meses, con su resultado">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,10,0,0">
          <StackPanel>
            <WrapPanel Margin="0,0,0,8">
              <TextBlock Text="Ejercicio" VerticalAlignment="Center" Margin="0,0,6,4" />
              <ComboBox ItemsSource="{Binding Ejercicios}" SelectedItem="{Binding EjercicioCuenta}" Width="80" Margin="0,0,14,4" VerticalAlignment="Center"
                        ToolTip="Ejercicio de la cuenta de resultados (cualquiera de la sociedad)" />
              <Border Style="{StaticResource Segmentado}" Margin="0,0,14,4" VerticalAlignment="Center" ToolTip="Una columna por año o una por mes">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource Segmento}" Content="Resumen" GroupName="Vista" IsChecked="{Binding EnResumen}" ToolTip="Una columna con el año, la comparación y el % sobre los ingresos" />
                  <RadioButton Style="{StaticResource Segmento}" Content="Por meses" GroupName="Vista" IsChecked="{Binding PorMeses}" ToolTip="Una columna por mes" />
                </StackPanel>
              </Border>
              <CheckBox Content="{Binding TextoComparar}" IsChecked="{Binding Comparar}" VerticalAlignment="Center" Margin="0,0,14,4"
                        ToolTip="Añade el importe del ejercicio anterior y la diferencia (en la vista Resumen)" />
              <CheckBox Content="Añadir su parte de gastos generales" IsChecked="{Binding AnadirGenerales}" VerticalAlignment="Center" Margin="0,0,14,4" ToolTip="{Binding AyudaGenerales}" />
              <Button Content="Exportar a Excel" Style="{StaticResource Boton}" Command="{Binding ExportarCuentaCommand}" VerticalAlignment="Center" Margin="0,0,0,4"
                      ToolTip="Guarda en Excel la cuenta de resultados que se ve, con los doce meses, el año y la comparación" />
            </WrapPanel>
            <pc:Nota Tipo="Info" Margin="0,0,0,8" MaxWidth="1100" HorizontalAlignment="Left" Visibility="{Binding AvisoCuenta, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding AvisoCuenta}" TextWrapping="Wrap" />
            </pc:Nota>
            <TextBlock Text="{Binding TextoGenerales}" Style="{StaticResource Texto.Apagado}" TextWrapping="Wrap" Margin="0,0,0,8" MaxWidth="1100" HorizontalAlignment="Left"
                       Visibility="{Binding HayTextoGenerales, Converter={StaticResource Visible}}" />
            <Grid>
              <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding FilasCuenta}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                        RowStyle="{StaticResource FilaCuenta}" HorizontalAlignment="Left" VerticalScrollBarVisibility="Disabled" Visibility="{Binding EnResumen, Converter={StaticResource Visible}}"
                        MouseDoubleClick="Cuenta_MouseDoubleClick" AutomationProperties.Name="Cuenta de resultados del activo">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Subcuenta" Binding="{Binding Cuenta}" Width="90" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                  <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="360" ElementStyle="{StaticResource Texto.Celda}" />
                  <DataGridTextColumn x:Name="ColAnio" Header="Año" Binding="{Binding Importe}" Width="120" ElementStyle="{StaticResource Celda.ImporteCuenta}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn x:Name="ColAnterior" Header="Año anterior" Binding="{Binding Anterior}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn x:Name="ColDiferencia" Header="Diferencia" Binding="{Binding Diferencia}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="% de ingresos" Binding="{Binding Porcentaje}" Width="100" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                </DataGrid.Columns>
              </DataGrid>
              <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding FilasCuenta}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                        RowStyle="{StaticResource FilaCuenta}" HorizontalAlignment="Left" VerticalScrollBarVisibility="Disabled" Visibility="{Binding PorMeses, Converter={StaticResource Visible}}" HorizontalScrollBarVisibility="Auto"
                        MouseDoubleClick="Cuenta_MouseDoubleClick" AutomationProperties.Name="Cuenta de resultados del activo por meses">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Subcuenta" Binding="{Binding Cuenta}" Width="80" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                  <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="230" ElementStyle="{StaticResource Texto.Celda}" />
                  <DataGridTextColumn Header="Ene" Binding="{Binding M1}" Width="74" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Feb" Binding="{Binding M2}" Width="74" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Mar" Binding="{Binding M3}" Width="74" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Abr" Binding="{Binding M4}" Width="74" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="May" Binding="{Binding M5}" Width="74" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Jun" Binding="{Binding M6}" Width="74" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Jul" Binding="{Binding M7}" Width="74" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Ago" Binding="{Binding M8}" Width="74" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Sep" Binding="{Binding M9}" Width="74" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Oct" Binding="{Binding M10}" Width="74" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Nov" Binding="{Binding M11}" Width="74" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn Header="Dic" Binding="{Binding M12}" Width="74" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                  <DataGridTextColumn x:Name="ColAnioMeses" Header="Año" Binding="{Binding Importe}" Width="110" ElementStyle="{StaticResource Celda.ImporteCuenta}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
            <StackPanel Margin="0,10,0,0" Visibility="{Binding Grafico, Converter={StaticResource Visible}}">
              <TextBlock Style="{StaticResource Texto.Seccion}"><Run Text="Ingresos y gastos de " /><Run Text="{Binding EjercicioCuenta, Mode=OneWay}" /><Run Text=", mes a mes" /></TextBlock>
              <TextBlock Text="Sin la amortización, que se contabiliza de una vez. Pasa el ratón por un mes para ver sus cifras." Style="{StaticResource Texto.Apagado}" Margin="0,0,0,4" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Rectangle Width="10" Height="10" Fill="#2a78d6" Margin="0,0,5,0" VerticalAlignment="Center" /><TextBlock Text="Ingresos" Margin="0,0,14,0" />
                <Rectangle Width="10" Height="10" Fill="#eb6834" Margin="0,0,5,0" VerticalAlignment="Center" /><TextBlock Text="Gastos" />
              </StackPanel>
              <pc:GraficoBarras Datos="{Binding Grafico}" Height="200" MaxWidth="1100" HorizontalAlignment="Left" Width="900" />
            </StackPanel>
          </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ========== Facturas ========== -->
        <TabItem Header="Facturas" Visibility="{Binding VerNoFinanciero, Converter={StaticResource Visible}}"
                 ToolTip="Las facturas de compra del activo: por su cuenta de gasto o por su centro de coste (solo consulta)">
          <DockPanel Margin="0,10,0,0">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="Ejercicio" VerticalAlignment="Center" Margin="0,0,6,4" />
              <ComboBox ItemsSource="{Binding EjerciciosEnlaces}" SelectedItem="{Binding EjercicioEnlaces}" DisplayMemberPath="Texto" Width="80" Margin="0,0,14,4" VerticalAlignment="Center"
                        ToolTip="Ejercicio de las facturas (el de trabajo por defecto); «Todos» enseña las de todos los ejercicios" />
              <TextBlock Text="{Binding ExplicacionCompras}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="900" Margin="0,0,0,4" />
            </WrapPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding TotalCompras}" FontWeight="SemiBold" Margin="0,8,0,0" />
            <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding FilasCompras}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                      HorizontalAlignment="Left" MouseDoubleClick="Abrible_MouseDoubleClick" AutomationProperties.Name="Facturas de compra del activo"
                      Visibility="{Binding SinCompras, Converter={StaticResource Visible}, ConverterParameter=invertir}">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}"><Setter Property="ToolTip" Value="{Binding Ayuda}" /></Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="SizeToCells" MinWidth="96" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="130" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="220" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="260" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Base" Binding="{Binding Base}" Width="100" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="IVA" Binding="{Binding Iva}" Width="90" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="170" ElementStyle="{StaticResource Texto.Celda}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- ========== Ventas ========== -->
        <TabItem Header="Ventas" Visibility="{Binding VerNoFinanciero, Converter={StaticResource Visible}}"
                 ToolTip="Las facturas programadas y las facturas emitidas con alguna línea de este activo (solo consulta)">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,10,0,0">
          <StackPanel>
            <WrapPanel Margin="0,0,0,8">
              <TextBlock Text="Ejercicio" VerticalAlignment="Center" Margin="0,0,6,4" />
              <ComboBox ItemsSource="{Binding EjerciciosEnlaces}" SelectedItem="{Binding EjercicioEnlaces}" DisplayMemberPath="Texto" Width="80" Margin="0,0,14,4" VerticalAlignment="Center"
                        ToolTip="Ejercicio de las ventas (el de trabajo por defecto); «Todos» enseña las de todos los ejercicios. Las programadas salen si emiten en ese año" />
              <TextBlock Text="Los importes del activo son la base de las líneas que llevan este activo; el total es el de toda la factura." Style="{StaticResource Texto.Apagado}"
                         VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="900" Margin="0,0,0,4" />
            </WrapPanel>
            <TextBlock Text="Facturas programadas" Style="{StaticResource Texto.Seccion}" />
            <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding FilasProgramadas}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                      HorizontalAlignment="Left" VerticalScrollBarVisibility="Disabled" MouseDoubleClick="Abrible_MouseDoubleClick" AutomationProperties.Name="Facturas programadas del activo"
                      Visibility="{Binding SinProgramadas, Converter={StaticResource Visible}, ConverterParameter=invertir}">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}"><Setter Property="ToolTip" Value="{Binding Ayuda}" /></Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Programada" Binding="{Binding Rotulo}" Width="90" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="260" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Periodicidad" Binding="{Binding Periodicidad}" Width="110" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Próxima" Binding="{Binding Proxima}" Width="86" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Importe del activo" Binding="{Binding Importe}" Width="130" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="Activa" Binding="{Binding Activa}" Width="60" ElementStyle="{StaticResource Texto.Celda}" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding TotalProgramadas}" FontWeight="SemiBold" Margin="0,6,0,14" />
            <TextBlock Text="Facturas emitidas y borradores" Style="{StaticResource Texto.Seccion}" />
            <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding FilasVentas}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                      HorizontalAlignment="Left" VerticalScrollBarVisibility="Disabled" MouseDoubleClick="Abrible_MouseDoubleClick" AutomationProperties.Name="Facturas de venta del activo"
                      Visibility="{Binding SinVentas, Converter={StaticResource Visible}, ConverterParameter=invertir}">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}"><Setter Property="ToolTip" Value="{Binding Ayuda}" /></Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="SizeToCells" MinWidth="96" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="120" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="260" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Base del activo" Binding="{Binding BaseActivo}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="Total factura" Binding="{Binding Total}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="170" ElementStyle="{StaticResource Texto.Celda}" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding TotalVentas}" FontWeight="SemiBold" Margin="0,6,0,0" />
          </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ========== Subcuentas ========== -->
        <TabItem Header="Subcuentas" Visibility="{Binding Propio, Converter={StaticResource Visible}}" ToolTip="Las subcuentas del activo según la plantilla de su tipo, con su papel y su saldo">
          <DockPanel Margin="0,10,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Generar las que falten…" Style="{StaticResource Boton}" Command="{Binding GenerarSubcuentasCommand}" VerticalAlignment="Center"
                      ToolTipService.ShowOnDisabled="True"
                      ToolTip="Propone las subcuentas de su plantilla que le faltan en el ejercicio de trabajo (o con otro nombre) y las crea al confirmar" />
              <TextBlock Text="{Binding TextoPlantilla}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <pc:Nota DockPanel.Dock="Top" Tipo="Aviso" Margin="0,0,0,8" MaxWidth="1100" HorizontalAlignment="Left" Visibility="{Binding HayQueFaltan, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="{Binding TextoQueFaltan}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding QueFaltan}" Focusable="False" Margin="8,2,0,2">
                  <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='· {0}'}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Pulsa «Generar las que falten…» para crearlas." />
              </StackPanel>
            </pc:Nota>
            <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding Subcuentas}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                      HorizontalAlignment="Left" MouseDoubleClick="Subcuentas_MouseDoubleClick" AutomationProperties.Name="Subcuentas del activo">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}"><Setter Property="ToolTip" Value="{Binding Ayuda}" /></Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Subcuenta" Binding="{Binding Codigo}" Width="90" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="430" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Papel" Binding="{Binding Papel}" Width="300" ElementStyle="{StaticResource Texto.Celda}" />
                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo}" Width="130" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- ========== Amortización ========== -->
        <TabItem Header="Amortización" Visibility="{Binding VerNoFinanciero, Converter={StaticResource Visible}}" ToolTip="El plan de amortización del activo y lo amortizado y previsto por ejercicio (solo consulta)">
          <DockPanel Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Top" Text="{Binding FrasePlan}" TextWrapping="Wrap" Margin="0,0,0,8" MaxWidth="1100" HorizontalAlignment="Left" />
            <pc:Nota DockPanel.Dock="Top" Tipo="Info" Margin="0,0,0,8" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="La amortización se calcula y se contabiliza desde Contabilidad › Amortización de activos. El primer año y el último cuentan los días reales y la cuota nunca supera lo pendiente."
                           TextWrapping="Wrap" MaxWidth="760" VerticalAlignment="Center" />
                <Button Content="Abrir Amortización de activos" Style="{StaticResource Boton.Enlace}" Command="{Binding AbrirAmortizacionCommand}" Margin="10,0,0,0" VerticalAlignment="Center"
                        ToolTip="Abre la pantalla del proceso de amortización de todos los activos" />
              </StackPanel>
            </pc:Nota>
            <DataGrid x:Name="TablaAmortizacion" Style="{StaticResource Tabla}" ItemsSource="{Binding FilasAmortizacion}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                      HorizontalAlignment="Left" AutomationProperties.Name="Amortización por ejercicio">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding EsActual}" Value="True">
                      <Setter Property="Background" Value="{StaticResource Pincel.AcentoSuave}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                      <Setter Property="ToolTip" Value="El ejercicio en el que estás trabajando" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Ejercicio" Binding="{Binding Ejercicio}" Width="80" ElementStyle="{StaticResource Texto.Celda.Mono}" />
                <DataGridTextColumn Header="Días" Binding="{Binding Dias}" Width="90" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="Cuota" Binding="{Binding Cuota}" Width="120" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="Acumulado" Binding="{Binding Acumulado}" Width="130" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTextColumn Header="Pendiente" Binding="{Binding Pendiente}" Width="130" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" />
                <DataGridTemplateColumn Header="Estado" Width="190">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Pastilla}" HorizontalAlignment="Left" ToolTip="{Binding Ayuda}">
                        <TextBlock Text="{Binding Estado}" FontSize="{StaticResource Letra.Pequena}" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Texto2}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- Documentos (documentos 2026-11-18): escrituras, contratos, pólizas… vinculados al activo -->
        <TabItem Header="Documentos" Visibility="{Binding HayDocumentos, Converter={StaticResource Visible}}"
                 ToolTip="Documentos del activo en el gestor documental (escrituras, contratos de alquiler, pólizas…); arrastra aquí ficheros para archivarlos y vincularlos">
          <ContentControl Content="{Binding PanelDocumentos}" Margin="0,10,0,0" />
        </TabItem>

      </TabControl>
    </pc:VistaEstado>
  </DockPanel>
</UserControl>
