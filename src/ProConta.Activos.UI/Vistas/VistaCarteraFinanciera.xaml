<UserControl x:Class="ProConta.Activos.UI.Vistas.VistaCarteraFinanciera"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             xmlns:v="clr-namespace:ProConta.Activos.UI.Vistas"
             Background="{StaticResource Pincel.Fondo}">
  <UserControl.Resources>
    <pc:VisibleSiConverter x:Key="Visible" />
    <v:IgualConverter x:Key="Igual" />
    <v:PincelDeColorConverter x:Key="PincelColor" />

    <Style x:Key="Tarjeta.Cartera" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <!-- Verde si gana, rojo si pierde. -->
    <Style x:Key="Texto.Tono" TargetType="TextBlock">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="Bueno"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="Malo"><Setter Property="Foreground" Value="{StaticResource Pincel.RojoSaldo}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Celda.Tono" TargetType="TextBlock" BasedOn="{StaticResource Texto.Celda.Importe}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="Bueno"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="Malo"><Setter Property="Foreground" Value="{StaticResource Pincel.RojoSaldo}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Celda.TonoAnual" TargetType="TextBlock" BasedOn="{StaticResource Texto.Celda.Importe}">
      <Setter Property="ToolTip" Value="{Binding AyudaAnual}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding TonoAnual}" Value="Bueno"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
        <DataTrigger Binding="{Binding TonoAnual}" Value="Malo"><Setter Property="Foreground" Value="{StaticResource Pincel.RojoSaldo}" /></DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Una cifra del resumen. -->
    <DataTemplate x:Key="Plantilla.Cifra">
      <Border BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,1,0" Padding="14,4,18,4" ToolTip="{Binding Ayuda}" Background="Transparent">
        <StackPanel>
          <TextBlock Text="{Binding Titulo}" Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" />
          <TextBlock Text="{Binding Valor}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Tinta}" Margin="0,2,0,1">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Tono}" Value="Bueno"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
                  <DataTrigger Binding="{Binding Tono}" Value="Malo"><Setter Property="Foreground" Value="{StaticResource Pincel.RojoSaldo}" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Nota}" Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="Panel.Cifras"><WrapPanel /></ItemsPanelTemplate>

    <Style x:Key="Muestra" TargetType="Border">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="3" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Fila.Cartera" TargetType="DataGridRow" BasedOn="{StaticResource Tabla.Fila}">
      <Setter Property="ToolTip" Value="{Binding AyudaFila}" />
      <!-- Dos líneas por fila (nombre y detalle): el alto de fila general es de una línea. -->
      <Setter Property="Height" Value="42" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding EsLote}" Value="True">
          <Setter Property="Background" Value="{StaticResource Pincel.Fondo2}" />
          <Setter Property="Foreground" Value="{StaticResource Pincel.Texto2}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Vendido}" Value="True"><Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" /></DataTrigger>
      </Style.Triggers>
    </Style>

    <ContextMenu x:Key="Menu.Cartera">
      <MenuItem Header="Abrir su ficha" Command="{Binding AbrirFichaCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTip="Abre la ficha del activo en su pestaña: cotización, lotes, operaciones, proyección y sus datos (también con doble clic)" />
      <Separator />
      <MenuItem Header="Nueva compra…" Command="{Binding NuevaCompraCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTipService.ShowOnDisabled="True" ToolTip="Anota otra compra de participaciones de este activo; el precio del día se consulta solo (no para activos de baja)" />
      <MenuItem Header="Vender…" Command="{Binding VenderCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTipService.ShowOnDisabled="True" ToolTip="Anota una venta de participaciones de este activo; si no le quedan, pasa a inactivo (no para activos vendidos o de baja)" />
    </ContextMenu>
  </UserControl.Resources>

  <DockPanel>
    <!-- Cabecera -->
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="{Binding EstadoCotizaciones}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button Content="Nuevo activo financiero…" Style="{StaticResource Boton.Primario}" Command="{Binding NuevoActivoCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  ToolTip="Da de alta un ETF, un fondo o unas acciones por su ISIN, con su primera compra" />
          <Button Content="Actualizar cotizaciones" Style="{StaticResource Boton}" Command="{Binding ActualizarCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                  ToolTip="Completa el histórico con Yahoo Finance y pide la cotización del momento. La primera vez del día, el precio sale de EODHD y se guarda; después, de Yahoo. También se hace al abrir la pantalla" />
          <Button Content="Listado de activos" Style="{StaticResource Boton}" Command="{Binding AbrirListadoCommand}" VerticalAlignment="Center"
                  ToolTip="Abre Datos maestros › Activos, con todos los activos de la sociedad" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Activos financieros" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Avisos de la actualización -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Pincel.AvisoSuave}" BorderBrush="{StaticResource Pincel.AvisoBorde}" BorderThickness="0,0,0,1" Padding="14,6"
            Visibility="{Binding HayAvisos, Converter={StaticResource Visible}}" ToolTip="{Binding AyudaAvisos}">
      <TextBlock Text="{Binding TextoAvisos}" TextWrapping="Wrap" Foreground="{StaticResource Pincel.Texto2}" />
    </Border>

    <pc:VistaEstado Estado="{Binding Estado}" Mensaje="{Binding MensajeEstado}" TextoAccion="Abrir el listado de activos" ComandoAccion="{Binding AbrirListadoCommand}">
      <Grid>
        <!-- ===================== CARTERA ===================== -->
        <!-- La tabla ocupa lo que piden sus filas (como mucho, algo más de la mitad: VistaCarteraFinanciera.xaml.cs) y los gráficos el resto. -->
        <Grid x:Name="Rejilla" Margin="14,10,14,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="230" />
            <RowDefinition x:Name="FilaTabla" Height="Auto" MinHeight="150" />
          </Grid.RowDefinitions>

          <Border Style="{StaticResource Tarjeta.Cartera}" Padding="0,8">
            <ItemsControl ItemsSource="{Binding Cifras}" ItemTemplate="{StaticResource Plantilla.Cifra}" ItemsPanel="{StaticResource Panel.Cifras}" Focusable="False" />
          </Border>

          <!-- Gráficos en dos pestañas -->
          <Border Grid.Row="1" Style="{StaticResource Tarjeta.Cartera}" Padding="10,4,10,8">
            <TabControl SelectedIndex="{Binding PestanaGrafico}" BorderThickness="0" Padding="0,6,0,0">
              <TabItem Header="Revalorización de la cartera" ToolTip="Valor de mercado de la cartera, sumando cada lote desde su fecha de compra">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Border Style="{StaticResource Segmentado}" Margin="0,0,10,0" ToolTip="Euros: cuánto vale la cartera cada día. Porcentaje: la plusvalía sobre lo invertido en cada momento">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton Style="{StaticResource Segmento}" Content="Euros" GroupName="Modo" IsChecked="{Binding ModoEuros}" />
                          <RadioButton Style="{StaticResource Segmento}" Content="% sobre lo invertido" GroupName="Modo" IsChecked="{Binding ModoPorcentaje}" />
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource Segmentado}" ToolTip="Periodo que se ve en el gráfico">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton Style="{StaticResource Segmento}" Content="1A" GroupName="Per" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=1A}" ToolTip="Último año" />
                          <RadioButton Style="{StaticResource Segmento}" Content="3A" GroupName="Per" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=3A}" ToolTip="Últimos 3 años" />
                          <RadioButton Style="{StaticResource Segmento}" Content="5A" GroupName="Per" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=5A}" ToolTip="Últimos 5 años" />
                          <RadioButton Style="{StaticResource Segmento}" Content="Máx." GroupName="Per" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=Máx.}" ToolTip="Desde la primera compra" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="17" Height="17" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource Pincel.Linea3}" Margin="0,0,8,0" Cursor="Help"
                              ToolTip="Cada lote cuenta desde el día en que se compró y deja de contar al venderse. En porcentaje, la plusvalía de cada día compara lo que había en cartera ese día con lo que costó. Lo invertido frente al valor está en la pestaña «Invertido y valor». Solo entran los activos que cotizan. Rueda del ratón: acercar o alejar; arrastrar: ampliar una zona; doble clic: ver todo.">
                        <TextBlock Text="i" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Apagado}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding Alcance}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2" Visibility="{Binding ModoEuros, Converter={StaticResource Visible}}">
                    <Border Style="{StaticResource Muestra}" Background="#2a78d6" /><TextBlock Text="Valor de mercado" Style="{StaticResource Texto.Apagado}" Margin="0,0,14,0" />
                    <TextBlock Text="▲ Compra   ▼ Venta" Style="{StaticResource Texto.Apagado}" />
                  </StackPanel>
                  <pc:GraficoTemporal Datos="{Binding DatosRevalorizacion}" FormatoEje="{Binding FormatoEjeRevalorizacion}" MinHeight="140" />
                </DockPanel>
              </TabItem>
              <TabItem Header="Comparativa de los activos" ToolTip="Variación en porcentaje de la cotización de cada activo, para compararlos entre sí">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Border DockPanel.Dock="Right" Style="{StaticResource Segmentado}" ToolTip="Periodo que se compara. Todos los activos empiezan en 0 % el primer día">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segmento}" Content="1M" GroupName="CPer" IsChecked="{Binding PeriodoComparativa, Converter={StaticResource Igual}, ConverterParameter=1M}" ToolTip="Último mes" />
                        <RadioButton Style="{StaticResource Segmento}" Content="3M" GroupName="CPer" IsChecked="{Binding PeriodoComparativa, Converter={StaticResource Igual}, ConverterParameter=3M}" ToolTip="Últimos 3 meses" />
                        <RadioButton Style="{StaticResource Segmento}" Content="6M" GroupName="CPer" IsChecked="{Binding PeriodoComparativa, Converter={StaticResource Igual}, ConverterParameter=6M}" ToolTip="Últimos 6 meses" />
                        <RadioButton Style="{StaticResource Segmento}" Content="Año" GroupName="CPer" IsChecked="{Binding PeriodoComparativa, Converter={StaticResource Igual}, ConverterParameter=Año}" ToolTip="Desde el 1 de enero" />
                        <RadioButton Style="{StaticResource Segmento}" Content="1A" GroupName="CPer" IsChecked="{Binding PeriodoComparativa, Converter={StaticResource Igual}, ConverterParameter=1A}" ToolTip="Último año" />
                        <RadioButton Style="{StaticResource Segmento}" Content="3A" GroupName="CPer" IsChecked="{Binding PeriodoComparativa, Converter={StaticResource Igual}, ConverterParameter=3A}" ToolTip="Últimos 3 años" />
                        <RadioButton Style="{StaticResource Segmento}" Content="5A" GroupName="CPer" IsChecked="{Binding PeriodoComparativa, Converter={StaticResource Igual}, ConverterParameter=5A}" ToolTip="Últimos 5 años" />
                      </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="17" Height="17" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource Pincel.Linea3}" Margin="0,0,8,0" Cursor="Help"
                              ToolTip="Compara cómo se ha movido el mercado de cada activo, tanto si había participaciones como si no: los días sin participaciones, su línea va punteada y tenue. Como los precios son muy distintos, cada línea muestra cuánto ha subido o bajado en porcentaje desde el primer día del periodo. Pasa el ratón por la leyenda para resaltar un activo. Se ven los activos marcados en la tabla. Rueda del ratón: acercar o alejar; arrastrar: ampliar una zona; doble clic: ver todo.">
                        <TextBlock Text="i" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Apagado}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="Variación acumulada de la cotización desde el primer día del periodo" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>
                  <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Leyenda}" Margin="0,0,0,2" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,2" Background="Transparent" ToolTip="{Binding Nombre}"
                                    MouseEnter="Leyenda_MouseEnter" MouseLeave="Leyenda_MouseLeave">
                          <Border Style="{StaticResource Muestra}" Background="{Binding Color, Converter={StaticResource PincelColor}}" />
                          <TextBlock Text="{Binding Codigo}" Margin="0,0,5,0" />
                          <TextBlock Text="{Binding Variacion}" FontWeight="SemiBold" Style="{StaticResource Texto.Tono}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <pc:GraficoTemporal Datos="{Binding DatosComparativa}" SerieResaltada="{Binding SerieResaltada}" FormatoEje="{Binding FormatoEjeComparativa}" MinHeight="140" />
                </DockPanel>
              </TabItem>
              <TabItem Header="Invertido y valor" ToolTip="Histórico del total invertido frente al valor total de la cartera (invertido más plusvalía)">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Border DockPanel.Dock="Right" Style="{StaticResource Segmentado}" ToolTip="Periodo que se ve en el gráfico">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segmento}" Content="1A" GroupName="IPer" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=1A}" ToolTip="Último año" />
                        <RadioButton Style="{StaticResource Segmento}" Content="3A" GroupName="IPer" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=3A}" ToolTip="Últimos 3 años" />
                        <RadioButton Style="{StaticResource Segmento}" Content="5A" GroupName="IPer" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=5A}" ToolTip="Últimos 5 años" />
                        <RadioButton Style="{StaticResource Segmento}" Content="Máx." GroupName="IPer" IsChecked="{Binding Periodo, Converter={StaticResource Igual}, ConverterParameter=Máx.}" ToolTip="Desde la primera compra" />
                      </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="17" Height="17" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource Pincel.Linea3}" Margin="0,0,8,0" Cursor="Help"
                              ToolTip="El total invertido sube con cada compra y baja con cada venta (por el coste medio de lo vendido): por eso va en escalones. El valor total es lo que valía ese día lo que había en cartera, es decir, lo invertido más la plusvalía. La parte sombreada es la plusvalía latente (verde) o la minusvalía (rojo). Solo entran los activos que cotizan. Rueda del ratón: acercar o alejar; arrastrar: ampliar una zona; doble clic: ver todo.">
                        <TextBlock Text="i" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Pincel.Apagado}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding Alcance}" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                    <Border Style="{StaticResource Muestra}" Background="#2a78d6" /><TextBlock Text="Valor total (invertido + plusvalía)" Style="{StaticResource Texto.Apagado}" Margin="0,0,14,0" />
                    <Border Style="{StaticResource Muestra}" Background="#7A8090" /><TextBlock Text="Total invertido" Style="{StaticResource Texto.Apagado}" Margin="0,0,14,0" />
                    <Border Style="{StaticResource Muestra}" Background="#331E8E5A" Height="10" /><TextBlock Text="Plusvalía latente" Style="{StaticResource Texto.Apagado}" Margin="0,0,14,0" />
                    <TextBlock Text="▲ Compra   ▼ Venta" Style="{StaticResource Texto.Apagado}" />
                  </StackPanel>
                  <pc:GraficoTemporal Datos="{Binding DatosInvertido}" FormatoEje="{Binding FormatoEjeInvertido}" MinHeight="140" />
                </DockPanel>
              </TabItem>
            </TabControl>
          </Border>

          <!-- Rentabilidad por activo -->
          <Border Grid.Row="2" Style="{StaticResource Tarjeta.Cartera}" Margin="0" Padding="0">
            <DockPanel>
              <WrapPanel DockPanel.Dock="Top" Margin="14,8,14,6">
                <TextBlock Text="Rentabilidad por activo" Style="{StaticResource Texto.Titulo}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Border Style="{StaticResource Segmentado}" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Filtra por clase de activo financiero">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segmento}" Content="Todos" GroupName="Tipo" IsChecked="{Binding Tipo, Converter={StaticResource Igual}, ConverterParameter=Todos}" />
                    <RadioButton Style="{StaticResource Segmento}" Content="ETF" GroupName="Tipo" IsChecked="{Binding Tipo, Converter={StaticResource Igual}, ConverterParameter=ETF}" ToolTip="Fondos cotizados en bolsa" />
                    <RadioButton Style="{StaticResource Segmento}" Content="Fondos" GroupName="Tipo" IsChecked="{Binding Tipo, Converter={StaticResource Igual}, ConverterParameter=Fondos}" ToolTip="Fondos de inversión (un valor liquidativo al día)" />
                    <RadioButton Style="{StaticResource Segmento}" Content="Otros" GroupName="Tipo" IsChecked="{Binding Tipo, Converter={StaticResource Igual}, ConverterParameter=Otros}" ToolTip="Acciones y participaciones que no cotizan" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Segmentado}" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Filtra por estado del activo">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segmento}" Content="Activos" GroupName="EstadoCartera" IsChecked="{Binding FiltroEstado, Converter={StaticResource Igual}, ConverterParameter=Activos}" ToolTip="Los que no tienen fecha de baja" />
                    <RadioButton Style="{StaticResource Segmento}" Content="Inactivos" GroupName="EstadoCartera" IsChecked="{Binding FiltroEstado, Converter={StaticResource Igual}, ConverterParameter=Inactivos}" ToolTip="Los vendidos del todo o dados de baja, con su resultado" />
                    <RadioButton Style="{StaticResource Segmento}" Content="Todos" GroupName="EstadoCartera" IsChecked="{Binding FiltroEstado, Converter={StaticResource Igual}, ConverterParameter=Todos}" ToolTip="Activos e inactivos" />
                  </StackPanel>
                </Border>
                <TextBlock Text="Varios lotes del mismo activo se suman en una fila · ▸ muestra sus lotes" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" />
              </WrapPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}" CornerRadius="0,0,6,6">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" ToolTip="Suma de los activos con participaciones que se ven">
                    <TextBlock Text="{Binding TextoTotales}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <TextBlock Text="Coste " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalCoste}" Style="{StaticResource Texto.Importe}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <TextBlock Text="Valor " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalValor}" Style="{StaticResource Texto.Importe}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <TextBlock Text="Plusvalía " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalPlusvalia}" FontWeight="SemiBold" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Importe}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding TonoTotal}" Value="Bueno"><Setter Property="Foreground" Value="{StaticResource Pincel.Verde}" /></DataTrigger>
                            <DataTrigger Binding="{Binding TonoTotal}" Value="Malo"><Setter Property="Foreground" Value="{StaticResource Pincel.RojoSaldo}" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <TextBlock VerticalAlignment="Center" Text="Clic: ver u ocultar en los gráficos · Doble clic: abrir su ficha · Clic en un título: ordenar · Clic derecho: acciones" />
                </DockPanel>
              </Border>
              <Grid>
                <pc:TablaProConta x:Name="Tabla" ItemsSource="{Binding Filas}" ClavePreferencias="activos.financieros" TituloExportacion="Activos financieros"
                                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="True" Sorting="Tabla_Sorting" AutomationProperties.Name="Rentabilidad por activo"
                                  HorizontalScrollBarVisibility="Auto" ContextMenu="{StaticResource Menu.Cartera}" RowStyle="{StaticResource Fila.Cartera}" BorderThickness="0" RowHeight="42"
                                  PreviewMouseLeftButtonDown="Tabla_PreviewMouseLeftButtonDown" MouseDoubleClick="Tabla_MouseDoubleClick" PreviewKeyDown="Tabla_PreviewKeyDown">
                  <pc:TablaProConta.Columns>
                    <DataGridTemplateColumn Width="34" pc:TablaProConta.Clave="marca" pc:TablaProConta.SiempreVisible="True" CanUserSort="False">
                      <DataGridTemplateColumn.Header>
                        <CheckBox IsChecked="{Binding DataContext.TodosMarcados, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  ToolTip="Marca o desmarca todos. Los marcados son los que se ven en los gráficos de arriba" />
                      </DataGridTemplateColumn.Header>
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Grid Visibility="{Binding EsActivo, Converter={StaticResource Visible}}">
                            <CheckBox IsChecked="{Binding Marcado, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PuedeMarcarse}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ToolTip="{Binding AyudaMarca}" ToolTipService.ShowOnDisabled="True" BorderBrush="{Binding Color, Converter={StaticResource PincelColor}}" BorderThickness="2" />
                          </Grid>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="34" pc:TablaProConta.Clave="lotes_desplegar" pc:TablaProConta.SiempreVisible="True" CanUserSort="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource Boton.Fantasma}" Padding="0" BorderThickness="0" Width="24" Height="24" MinWidth="0" MinHeight="0" HorizontalAlignment="Center" Click="Desplegar_Click" ToolTip="{Binding AyudaFlecha}"
                                  Visibility="{Binding Desplegable, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding AyudaFlecha}">
                            <!-- Triángulo dibujado (no un carácter de la fuente): apunta a la derecha cerrado y hacia abajo abierto. -->
                            <Path Data="M0,0 L6,5 L0,10 Z" Fill="{StaticResource Pincel.Texto2}" Width="6" Height="10" Stretch="None" RenderTransformOrigin="0.5,0.5">
                              <Path.Style>
                                <Style TargetType="Path">
                                  <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Abierto}" Value="True">
                                      <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Path.Style>
                            </Path>
                          </Button>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Activo" Width="*" MinWidth="260" SortMemberPath="Nombre" pc:TablaProConta.Clave="activo" pc:TablaProConta.RutaExportar="Nombre">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Margin="4,2">
                            <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsLote}" Value="True">
                                      <Setter Property="FontWeight" Value="Normal" />
                                      <Setter Property="Margin" Value="14,0,0,0" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Detalle}" Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Clase}" Width="100" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="tipo" />
                    <DataGridTextColumn Header="Lotes" Binding="{Binding Lotes}" Width="54" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                        pc:TablaProConta.Clave="lotes" pc:TablaProConta.Ayuda="Número de compras que siguen vivas, total o parcialmente" />
                    <DataGridTextColumn Header="Participaciones" Binding="{Binding Participaciones}" Width="112" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                        pc:TablaProConta.Clave="participaciones" />
                    <DataGridTextColumn Header="Precio medio" Binding="{Binding PrecioMedio}" Width="100" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                        pc:TablaProConta.Clave="precio_medio" pc:TablaProConta.Ayuda="Coste medio por participación de lo que queda en cartera, comisiones incluidas" />
                    <DataGridTextColumn Header="Coste" Binding="{Binding Coste}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                        pc:TablaProConta.Clave="coste" pc:TablaProConta.Ayuda="Lo que costó lo que queda en cartera" />
                    <DataGridTemplateColumn Header="Cotización" Width="96" SortMemberPath="Cotizacion" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}" pc:TablaProConta.Clave="cotizacion" pc:TablaProConta.RutaExportar="Cotizacion"
                                            pc:TablaProConta.Ayuda="Último precio en euros (pasa el ratón para ver su fecha y origen)">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding Cotizacion}" Style="{StaticResource Texto.Celda.Importe}" ToolTip="{Binding AyudaCotizacion}" /></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="110" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                        pc:TablaProConta.Clave="valor" pc:TablaProConta.Ayuda="Participaciones por la última cotización; sin cotización, a coste" />
                    <DataGridTextColumn Header="Plusvalía" Binding="{Binding Plusvalia}" Width="118" ElementStyle="{StaticResource Celda.Tono}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                        pc:TablaProConta.Clave="plusvalia" pc:TablaProConta.Ayuda="Valor menos coste de lo que queda en cartera; en los vendidos, el resultado de las ventas" />
                    <DataGridTextColumn Header="%" Binding="{Binding Porcentaje}" Width="72" ElementStyle="{StaticResource Celda.Tono}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                        pc:TablaProConta.Clave="porcentaje" pc:TablaProConta.Ayuda="Plusvalía sobre el coste" />
                    <DataGridTextColumn Header="Anual" Binding="{Binding Anual}" Width="72" ElementStyle="{StaticResource Celda.TonoAnual}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                        pc:TablaProConta.Clave="anual" pc:TablaProConta.Ayuda="Rentabilidad media por año, teniendo en cuenta cuándo entró y salió cada euro (TIR); «—» con menos de un año" />
                    <DataGridTextColumn Header="Peso" Binding="{Binding Peso}" Width="66" ElementStyle="{StaticResource Texto.Celda.Importe}" HeaderStyle="{StaticResource Tabla.Cabecera.Derecha}"
                                        pc:TablaProConta.Clave="peso" pc:TablaProConta.Ayuda="Parte del valor de la cartera" />
                  </pc:TablaProConta.Columns>
                </pc:TablaProConta>
                <TextBlock Text="Ningún activo cumple los filtros. Cambia el tipo o el estado (Activos, Inactivos, Todos)." Style="{StaticResource Texto.Apagado}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SinResultados, Converter={StaticResource Visible}}" />
              </Grid>
            </DockPanel>
          </Border>
        </Grid>

      </Grid>
    </pc:VistaEstado>
  </DockPanel>
</UserControl>
