<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pantalla genérica de mantenimiento (plataforma/mantenimiento): «Configuración › Parámetros y tablas» del contenedor. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>ProConta.Mantenimiento.UI</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProConta.UI.Base\ProConta.UI.Base.csproj" />
    <ProjectReference Include="..\ProConta.Mantenimiento\ProConta.Mantenimiento.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProConta.Mantenimiento.UI.Tests" />
  </ItemGroup>
</Project>
