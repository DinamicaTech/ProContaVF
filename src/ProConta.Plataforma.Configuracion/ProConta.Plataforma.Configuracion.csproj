<Project Sdk="Microsoft.NET.Sdk">
  <!-- Resolutor único de la ubicación de datos y comprobación del esquema al arrancar (docs/plataforma/configuracion.md). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>ProConta.Plataforma.Configuracion</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProConta.Nucleo\ProConta.Nucleo.csproj" />
    <ProjectReference Include="..\ProConta.Datos.Persistencia\ProConta.Datos.Persistencia.csproj" />
    <ProjectReference Include="..\ProConta.Datos.Esquema\ProConta.Datos.Esquema.csproj" />
  </ItemGroup>
</Project>
