<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pc="urn:proconta-ui">
  <!-- Composiciones de Terceros con los tokens de ProConta.UI.Base (sin colores propios). -->

  <pc:VisibleSiConverter x:Key="Visible" />
  <pc:FechaConverter x:Key="Fecha" />

  <!-- Insignia de rol (Cli 4300, Prov 31, Cont 9): pequeña, sin recortar. -->
  <Style x:Key="Insignia" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radio.Pastilla}" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Pincel.Fondo2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.Linea}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style x:Key="Insignia.Cliente" TargetType="Border" BasedOn="{StaticResource Insignia}">
    <Setter Property="Background" Value="{StaticResource Pincel.VerdeSuave}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.VerdeBorde}" />
  </Style>
  <Style x:Key="Insignia.Proveedor" TargetType="Border" BasedOn="{StaticResource Insignia}">
    <Setter Property="Background" Value="{StaticResource Pincel.AcentoSuave}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.AcentoBorde}" />
  </Style>
  <Style x:Key="Insignia.Contacto" TargetType="Border" BasedOn="{StaticResource Insignia}">
    <Setter Property="Background" Value="{StaticResource Pincel.AzulSuave}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.Linea}" />
  </Style>
  <Style x:Key="Insignia.Empleado" TargetType="Border" BasedOn="{StaticResource Insignia}">
    <Setter Property="Background" Value="{StaticResource Pincel.MoradoSuave}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.Linea}" />
  </Style>
  <Style x:Key="Texto.Insignia" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Letra.Mini}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
  </Style>

  <!-- Avatar con iniciales. -->
  <Style x:Key="Avatar" TargetType="Border">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{StaticResource Pincel.Marino}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Texto.Avatar" TargetType="TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Mini}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Etiqueta de campo de formulario. -->
  <Style x:Key="Etiqueta.Campo" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Letra.Pequena}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Texto2}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- Encabezado de sección de la ficha. -->
  <Style x:Key="Seccion.Ficha" TargetType="TextBlock" BasedOn="{StaticResource Texto.Seccion}">
    <Setter Property="FontSize" Value="{StaticResource Letra.Destacada}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
