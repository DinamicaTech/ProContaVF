<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pc="clr-namespace:ProConta.UI.Base.Controles"
                    xmlns:pt="clr-namespace:ProConta.UI.Base.Tablas">
  <!--
    Estilos de los controles estándar con el aspecto de las maquetas validadas.
    Reglas comunes (docs/plataforma/ui-base.md): todo control lleva tooltip descriptivo (también deshabilitado, para decir por qué);
    los campos miden lo que su contenido; nada en mayúsculas; errores de campo con borde rojo, icono y mensaje en el tooltip.
  -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ProConta.UI.Base;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="/ProConta.UI.Base;component/Themes/Iconos.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ===================== Iconos de trazo (lienzo 24×24) ===================== -->
  <Style x:Key="Icono.Trazo" TargetType="Path">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
    <Setter Property="SnapsToDevicePixels" Value="False" />
    <Setter Property="LayoutTransform">
      <Setter.Value><ScaleTransform ScaleX="0.625" ScaleY="0.625" /></Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Icono.Trazo12" TargetType="Path" BasedOn="{StaticResource Icono.Trazo}">
    <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.5" ScaleY="0.5" /></Setter.Value></Setter>
    <Setter Property="StrokeThickness" Value="2.2" />
  </Style>
  <Style x:Key="Icono.Trazo14" TargetType="Path" BasedOn="{StaticResource Icono.Trazo}">
    <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.5833" ScaleY="0.5833" /></Setter.Value></Setter>
  </Style>
  <Style x:Key="Icono.Trazo18" TargetType="Path" BasedOn="{StaticResource Icono.Trazo}">
    <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.75" ScaleY="0.75" /></Setter.Value></Setter>
    <Setter Property="StrokeThickness" Value="1.6" />
  </Style>
  <Style x:Key="Icono.Trazo32" TargetType="Path" BasedOn="{StaticResource Icono.Trazo}">
    <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="1.3333" ScaleY="1.3333" /></Setter.Value></Setter>
    <Setter Property="StrokeThickness" Value="1.4" />
  </Style>

  <!-- ===================== Ventana y textos ===================== -->
  <Style x:Key="Ventana.ProConta" TargetType="Window">
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Normal}" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
    <Setter Property="Background" Value="{StaticResource Pincel.Fondo}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <Style x:Key="Texto.TituloPantalla" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Titulo}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.TituloPantalla}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Marino}" />
  </Style>
  <Style x:Key="Texto.Titulo" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Letra.Subtitulo}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
  </Style>
  <Style x:Key="Texto.Seccion" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Letra.Secundaria}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style x:Key="Texto.Apagado" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Letra.Secundaria}" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Texto.Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Normal}" />
  </Style>
  <!-- Importes: alineados a la derecha y con cifras de ancho fijo -->
  <Style x:Key="Texto.Importe" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <Style x:Key="Texto.Saldo" TargetType="TextBlock" BasedOn="{StaticResource Texto.Importe}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Texto largo en una celda: inicio con «…» y el texto completo en el tooltip -->
  <Style x:Key="Texto.Celda" TargetType="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    <Style.Triggers>
      <Trigger Property="Text" Value="">
        <Setter Property="ToolTip" Value="{x:Null}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Texto.Celda.Mono" TargetType="TextBlock" BasedOn="{StaticResource Texto.Celda}">
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Mono}" />
  </Style>
  <Style x:Key="Texto.Celda.Importe" TargetType="TextBlock" BasedOn="{StaticResource Texto.Importe}">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===================== Tarjetas y separadores ===================== -->
  <Style x:Key="Tarjeta" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Pincel.Blanco}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radio.Panel}" />
  </Style>
  <Style x:Key="Barra.Pie" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Pincel.Fondo2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.Linea}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="TextElement.FontSize" Value="{StaticResource Letra.Pequena}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Pincel.Apagado}" />
  </Style>
  <Style x:Key="Barra.Seleccion" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Pincel.Blanco}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.Linea3}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radio.Menu}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Effect" Value="{StaticResource Sombra.Flotante}" />
  </Style>
  <Style TargetType="Separator">
    <Setter Property="Background" Value="{StaticResource Pincel.Linea}" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Tooltips ===================== -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Pincel.Marino}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Secundaria}" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="MaxWidth" Value="460" />
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,0,8,8" Effect="{StaticResource Sombra.Flotante}">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Foco ===================== -->
  <Style x:Key="Foco.Anillo">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" BorderBrush="{StaticResource Pincel.Foco}" BorderThickness="3" CornerRadius="10" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Botones ===================== -->
  <Style x:Key="Boton" TargetType="ButtonBase">
    <Setter Property="Height" Value="{StaticResource Alto.Boton}" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="Background" Value="{StaticResource Pincel.Blanco}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.Linea3}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Normal}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Foco.Anillo}" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
    <Setter Property="pc:Iconos.Icono" Value="{x:Null}" />
    <Setter Property="Tag" Value="8" />
    <Setter Property="pc:Aspecto.FondoEncima" Value="{StaticResource Pincel.Hover}" />
    <Setter Property="pc:Aspecto.BordeEncima" Value="{StaticResource Pincel.HoverBorde}" />
    <Setter Property="pc:Aspecto.FondoPulsado" Value="{StaticResource Pincel.Fondo}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radio.Boton}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Path x:Name="Ico" Style="{StaticResource Icono.Trazo14}" Data="{TemplateBinding pc:Iconos.Icono}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <ContentPresenter x:Name="Contenido" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="pc:Iconos.Icono" Value="{x:Null}">
              <Setter TargetName="Ico" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Ico" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="Content" Value="">
              <Setter TargetName="Ico" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{Binding (pc:Aspecto.FondoEncima), RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{Binding (pc:Aspecto.BordeEncima), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{Binding (pc:Aspecto.FondoPulsado), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Boton}" />
  <Style TargetType="RepeatButton" BasedOn="{StaticResource Boton}" />

  <Style x:Key="Boton.Primario" TargetType="Button" BasedOn="{StaticResource Boton}">
    <Setter Property="Background" Value="{StaticResource Pincel.Marino}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.Marino}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="pc:Aspecto.FondoEncima" Value="{StaticResource Pincel.Marino2}" />
    <Setter Property="pc:Aspecto.BordeEncima" Value="{StaticResource Pincel.Marino2}" />
    <Setter Property="pc:Aspecto.FondoPulsado" Value="{StaticResource Pincel.Marino}" />
  </Style>
  <Style x:Key="Boton.Peligro" TargetType="Button" BasedOn="{StaticResource Boton}">
    <Setter Property="Foreground" Value="{StaticResource Pincel.Rojo}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.RojoBorde}" />
  </Style>
  <Style x:Key="Boton.Pequeno" TargetType="Button" BasedOn="{StaticResource Boton}">
    <Setter Property="Height" Value="{StaticResource Alto.BotonPequeno}" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Secundaria}" />
  </Style>
  <Style x:Key="Boton.Fantasma" TargetType="Button" BasedOn="{StaticResource Boton.Pequeno}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style x:Key="Boton.Icono" TargetType="Button" BasedOn="{StaticResource Boton}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Pincel.Marino}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Boton.Enlace" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Pincel.Azul}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Secundaria}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Foco.Anillo}" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="T" Background="Transparent"><ContentPresenter RecognizesAccessKey="True" /></TextBlock>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Aspa pequeña (quitar de una lista o etiqueta) -->
  <Style x:Key="Boton.Aspa" TargetType="Button" BasedOn="{StaticResource Boton.Icono}">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="pc:Iconos.Icono" Value="{StaticResource Icono.x}" />
  </Style>

  <!-- ===================== Campos de texto ===================== -->
  <ControlTemplate x:Key="Plantilla.ErrorCampo">
    <!-- El campo no cambia de tamaño: borde rojo e icono; el mensaje va en el tooltip y en el resumen superior. -->
    <Grid>
      <Border BorderBrush="{StaticResource Pincel.RojoError}" BorderThickness="1" CornerRadius="{StaticResource Radio.Campo}" SnapsToDevicePixels="True">
        <AdornedElementPlaceholder />
      </Border>
      <Path Data="{StaticResource Icono.info}" Style="{StaticResource Icono.Trazo14}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
            TextElement.Foreground="{StaticResource Pincel.RojoError}" IsHitTestVisible="False" />
    </Grid>
  </ControlTemplate>

  <Style x:Key="Campo" TargetType="TextBox">
    <Setter Property="Height" Value="{StaticResource Alto.Campo}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="{StaticResource Pincel.CampoFondo}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.CampoBorde}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Normal}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{StaticResource Pincel.Marino}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Pincel.Acento}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Plantilla.ErrorCampo}" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBoxBase">
          <Grid>
            <Border x:Name="Anillo" Margin="-3" CornerRadius="10" BorderThickness="3" BorderBrush="{StaticResource Pincel.Foco}" Visibility="Collapsed" />
            <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radio.Campo}" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="White" />
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.Marino}" />
              <Setter TargetName="Anillo" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.RojoCampo}" />
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.RojoError}" />
              <Setter Property="Padding" Value="6,0,26,0" />
              <Setter Property="ToolTip" Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Fondo2}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource Campo}" />
  <Style x:Key="Campo.Importe" TargetType="TextBox" BasedOn="{StaticResource Campo}">
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="pc:CampoImporte.Activo" Value="True" />
  </Style>
  <Style x:Key="Campo.Mono" TargetType="TextBox" BasedOn="{StaticResource Campo}">
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Mono}" />
  </Style>
  <Style x:Key="Campo.Multilinea" TargetType="TextBox" BasedOn="{StaticResource Campo}">
    <Setter Property="Height" Value="Auto" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <!-- ===================== Casillas y opciones ===================== -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Normal}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Foco.Anillo}" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Caja" Width="15" Height="15" CornerRadius="4" BorderThickness="1" BorderBrush="#B9B3A4" Background="White" VerticalAlignment="Center" SnapsToDevicePixels="True">
              <Path x:Name="Marca" Data="{StaticResource Icono.check}" Style="{StaticResource Icono.Trazo12}" TextElement.Foreground="White" StrokeThickness="3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ContentPresenter x:Name="Texto" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Caja" Property="Background" Value="{StaticResource Pincel.Marino}" />
              <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource Pincel.Marino}" />
              <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Caja" Property="Background" Value="{StaticResource Pincel.Marino}" />
              <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource Pincel.Marino}" />
              <Setter TargetName="Marca" Property="Data" Value="{StaticResource Icono.dash}" />
              <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource Pincel.Marino}" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Texto" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Normal}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Foco.Anillo}" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="15" Height="15" VerticalAlignment="Center">
              <Ellipse x:Name="Aro" Stroke="#B9B3A4" StrokeThickness="1" Fill="White" />
              <Ellipse x:Name="Punto" Width="7" Height="7" Fill="{StaticResource Pincel.Marino}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Aro" Property="Stroke" Value="{StaticResource Pincel.Marino}" />
              <Setter TargetName="Punto" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Aro" Property="Stroke" Value="{StaticResource Pincel.Marino}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Selector segmentado (Normal · Compacto · …): un Border «Segmentado» con RadioButton «Segmento» -->
  <Style x:Key="Segmentado" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Pincel.Fondo}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radio.Boton}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style x:Key="Segmento" TargetType="RadioButton">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Secundaria}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="#555B69" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Foco.Anillo}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="F" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Pincel.Marino}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="F" Property="Background" Value="White" />
              <Setter TargetName="F" Property="Effect">
                <Setter.Value><DropShadowEffect Color="#14213A" Opacity="0.12" BlurRadius="3" ShadowDepth="1" Direction="270" /></Setter.Value>
              </Setter>
              <Setter Property="Foreground" Value="{StaticResource Pincel.Marino}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Barras de desplazamiento finas ===================== -->
  <Style x:Key="Barra.Pulgar" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="P" CornerRadius="4" Background="#D6D1C4" Margin="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="P" Property="Background" Value="#B9B3A4" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="P" Property="Background" Value="#9E978A" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Barra.Zona" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Barra.Zona}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Barra.Zona}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource Barra.Pulgar}" /></Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Barra.Zona}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Barra.Zona}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource Barra.Pulgar}" /></Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===================== Desplegables ===================== -->
  <Style x:Key="Combo.Boton" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <Path Data="{StaticResource Icono.chev}" Style="{StaticResource Icono.Trazo14}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
                  TextElement.Foreground="{StaticResource Pincel.Apagado}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Height" Value="{StaticResource Alto.Campo}" />
    <Setter Property="Padding" Value="8,0,28,0" />
    <Setter Property="Background" Value="{StaticResource Pincel.CampoFondo}" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.CampoBorde}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Normal}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Plantilla.ErrorCampo}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Anillo" Margin="-3" CornerRadius="10" BorderThickness="3" BorderBrush="{StaticResource Pincel.Foco}" Visibility="Collapsed" />
            <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radio.Campo}" />
            <ContentPresenter x:Name="Contenido" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="2,0,24,0" BorderThickness="0" Background="Transparent" IsReadOnly="{TemplateBinding IsReadOnly}" />
            <ToggleButton Style="{StaticResource Combo.Boton}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                   IsOpen="{TemplateBinding IsDropDownOpen}" MinWidth="{TemplateBinding ActualWidth}">
              <Border Background="White" BorderBrush="{StaticResource Pincel.Linea3}" BorderThickness="1" CornerRadius="{StaticResource Radio.Menu}" Padding="4" Margin="0,0,12,14"
                      Effect="{StaticResource Sombra.Menu}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.Marino}" />
              <Setter TargetName="Fondo" Property="Background" Value="White" />
              <Setter TargetName="Anillo" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.HoverBorde}" />
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="Contenido" Property="Visibility" Value="Hidden" />
              <Setter Property="Cursor" Value="IBeam" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.RojoCampo}" />
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Pincel.RojoError}" />
              <Setter Property="ToolTip" Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="F" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="F" Property="Background" Value="{StaticResource Pincel.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="F" Property="Background" Value="{StaticResource Pincel.Seleccion}" />
              <Setter Property="FontWeight" Value="Medium" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Menús contextuales ===================== -->
  <Style TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource Fuente.Texto}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Normal}" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Grid.IsSharedSizeScope" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="White" BorderBrush="{StaticResource Pincel.Linea3}" BorderThickness="1" CornerRadius="{StaticResource Radio.Menu}" Padding="4" Margin="0,0,14,16"
                  MinWidth="230" Effect="{StaticResource Sombra.Menu}">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Height" Value="30" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="F" CornerRadius="6" Background="Transparent" Padding="8,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Atajo" />
                <ColumnDefinition Width="14" />
              </Grid.ColumnDefinitions>
              <ContentPresenter x:Name="Ico" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left" />
              <Path x:Name="Marca" Data="{StaticResource Icono.check}" Style="{StaticResource Icono.Trazo14}" Visibility="Collapsed" VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Pincel.Apagado}" FontSize="{StaticResource Letra.Pequena}" />
              <Path x:Name="Flecha" Grid.Column="3" Data="{StaticResource Icono.chevr}" Style="{StaticResource Icono.Trazo12}" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right" />
              <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-5" AllowsTransparency="True" Focusable="False"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
                <Border Background="White" BorderBrush="{StaticResource Pincel.Linea3}" BorderThickness="1" CornerRadius="{StaticResource Radio.Menu}" Padding="4" Margin="0,0,14,16" MinWidth="200" Effect="{StaticResource Sombra.Menu}">
                  <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="F" Property="Background" Value="{StaticResource Pincel.Hover}" />
              <Setter Property="Foreground" Value="{StaticResource Pincel.Marino}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
              <Setter TargetName="Ico" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="Flecha" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Pestañas (fichas) ===================== -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1">
              <StackPanel IsItemsHost="True" Orientation="Horizontal" Margin="12,0" />
            </Border>
            <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource Pincel.Texto2}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Destacada}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Foco.Anillo}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid Margin="0,0,24,0" Background="Transparent">
            <ContentPresenter ContentSource="Header" Margin="0,11,0,11" VerticalAlignment="Center" />
            <Border x:Name="Subrayado" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-1" Background="Transparent" CornerRadius="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Pincel.Marino}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Pincel.Marino}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Subrayado" Property="Background" Value="{StaticResource Pincel.Acento2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Listas ===================== -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="F" Background="Transparent" BorderBrush="{StaticResource Pincel.Linea2}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="F" Property="Background" Value="{StaticResource Pincel.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="F" Property="Background" Value="{StaticResource Pincel.Seleccion}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="F" Property="BorderBrush" Value="{StaticResource Pincel.Marino}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Tablas ===================== -->
  <Style x:Key="Tabla.Pinza" TargetType="Thumb">
    <Setter Property="Width" Value="8" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="P" Background="Transparent">
            <Border x:Name="L" Width="2" HorizontalAlignment="Center" Background="Transparent" Margin="0,5" CornerRadius="1" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="L" Property="Background" Value="{StaticResource Pincel.Acento2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Tabla.Cabecera" TargetType="DataGridColumnHeader">
    <Setter Property="Height" Value="{StaticResource Alto.Cabecera}" />
    <Setter Property="Background" Value="{StaticResource Pincel.Fondo2}" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Apagado}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Secundaria}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTip">
      <Setter.Value>
        <TextBlock>
          <Run Text="{Binding Column.Header, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Mode=OneWay}" /><Run Text=": clic para ordenar (otra vez: descendente; otra: orden de fábrica) · arrastra para mover la columna · borde: ancho, doble clic ajusta · clic derecho: columnas" />
        </TextBlock>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border x:Name="F" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                <ContentPresenter VerticalAlignment="Center">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <TextBlock x:Name="Flecha" Margin="4,0,0,0" FontSize="9" VerticalAlignment="Center" Foreground="{StaticResource Pincel.Marino}" />
              </StackPanel>
            </Border>
            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Margin="-4,0,0,0" Style="{StaticResource Tabla.Pinza}" />
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Margin="0,0,-4,0" Style="{StaticResource Tabla.Pinza}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Pincel.Marino}" />
            </Trigger>
            <Trigger Property="SortDirection" Value="Ascending">
              <Setter TargetName="Flecha" Property="Text" Value="▲" />
              <Setter Property="Foreground" Value="{StaticResource Pincel.Marino}" />
            </Trigger>
            <Trigger Property="SortDirection" Value="Descending">
              <Setter TargetName="Flecha" Property="Text" Value="▼" />
              <Setter Property="Foreground" Value="{StaticResource Pincel.Marino}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="F" Property="Background" Value="{StaticResource Pincel.AcentoSuave}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Cabecera de una columna de importes: título a la derecha -->
  <Style x:Key="Tabla.Cabecera.Derecha" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Tabla.Cabecera}">
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>
  <Style x:Key="Tabla.Fila" TargetType="DataGridRow">
    <Setter Property="Height" Value="{StaticResource Alto.Fila}" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource Pincel.Linea2}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Pincel.Hover}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource Pincel.Seleccion}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSelected" Value="True" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{StaticResource Pincel.SeleccionHover}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Tabla.Celda" TargetType="DataGridCell">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border x:Name="F" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="F" Property="Background" Value="{StaticResource Pincel.Activa}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
        <Setter Property="Background" Value="Transparent" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Tabla" TargetType="DataGrid">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Tinta}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Normal}" />
    <Setter Property="RowHeight" Value="{StaticResource Alto.Fila}" />
    <Setter Property="ColumnHeaderHeight" Value="{StaticResource Alto.Cabecera}" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="SelectionMode" Value="Extended" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource Tabla.Cabecera}" />
    <Setter Property="RowStyle" Value="{StaticResource Tabla.Fila}" />
    <Setter Property="CellStyle" Value="{StaticResource Tabla.Celda}" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
  </Style>
  <Style TargetType="DataGrid" BasedOn="{StaticResource Tabla}" />
  <Style TargetType="pt:TablaProConta" BasedOn="{StaticResource Tabla}" />

  <!-- ===================== Separador arrastrable ===================== -->
  <Style x:Key="Separador" TargetType="Thumb">
    <Setter Property="Width" Value="8" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent">
            <Border x:Name="L" Width="2" HorizontalAlignment="Center" CornerRadius="1" Background="Transparent" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="L" Property="Background" Value="{StaticResource Pincel.Acento2}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="L" Property="Background" Value="{StaticResource Pincel.Acento2}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="L" Property="Background" Value="{StaticResource Pincel.Acento3}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="GridSplitter">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Border Background="Transparent">
            <Border x:Name="L" Width="2" HorizontalAlignment="Center" CornerRadius="1" Background="Transparent" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="L" Property="Background" Value="{StaticResource Pincel.Acento2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Barra de progreso ===================== -->
