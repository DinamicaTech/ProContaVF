<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    Tokens visuales de las maquetas HTML validadas (sources/maquetas/Contenedor, variables CSS de :root).
    Las pantallas usan siempre estas claves; ningún color, fuente o radio se escribe a mano en una pantalla.
    Diseño a 2560×1440 con la escala de Windows al 100 % (docs/plataforma/ui-base.md).
  -->

  <!-- Fuentes (OFL), incluidas en el ensamblado -->
  <FontFamily x:Key="Fuente.Texto">pack://application:,,,/ProConta.UI.Base;component/Fonts/#IBM Plex Sans</FontFamily>
  <FontFamily x:Key="Fuente.Mono">pack://application:,,,/ProConta.UI.Base;component/Fonts/#IBM Plex Mono</FontFamily>
  <FontFamily x:Key="Fuente.Titulo">pack://application:,,,/ProConta.UI.Base;component/Fonts/#Bricolage Grotesque</FontFamily>

  <!-- Tamaños de letra (px) -->
  <sys:Double x:Key="Letra.Mini">11</sys:Double>
  <sys:Double x:Key="Letra.Pequena">11.5</sys:Double>
  <sys:Double x:Key="Letra.Secundaria">12</sys:Double>
  <sys:Double x:Key="Letra.Normal">12.5</sys:Double>
  <sys:Double x:Key="Letra.Destacada">13</sys:Double>
  <sys:Double x:Key="Letra.Subtitulo">14</sys:Double>
  <sys:Double x:Key="Letra.Titulo">18</sys:Double>
  <sys:Double x:Key="Letra.TituloPantalla">20</sys:Double>

  <!-- Colores base -->
  <Color x:Key="Color.Marino">#14213A</Color>
  <Color x:Key="Color.Marino2">#22314F</Color>
  <Color x:Key="Color.Tinta">#16213A</Color>
  <Color x:Key="Color.Texto2">#3B4252</Color>
  <Color x:Key="Color.Apagado">#646A78</Color>
  <Color x:Key="Color.Apagado2">#7A8090</Color>
  <Color x:Key="Color.Fondo">#F1EEE7</Color>
  <Color x:Key="Color.Fondo2">#FBFAF7</Color>
  <Color x:Key="Color.Blanco">#FFFFFF</Color>
  <Color x:Key="Color.Linea">#ECE8DE</Color>
  <Color x:Key="Color.Linea2">#F3F0E9</Color>
  <Color x:Key="Color.Linea3">#E1DDD2</Color>
  <Color x:Key="Color.Hover">#FBFAF6</Color>
  <Color x:Key="Color.HoverBorde">#CFC9BA</Color>
  <Color x:Key="Color.CampoBorde">#E4E1D8</Color>
  <Color x:Key="Color.CampoFondo">#FAF9F6</Color>
  <Color x:Key="Color.Acento">#F4A259</Color>
  <Color x:Key="Color.Acento2">#D9622B</Color>
  <Color x:Key="Color.Acento3">#B4481F</Color>
  <Color x:Key="Color.AcentoSuave">#FFF3E6</Color>
  <Color x:Key="Color.AcentoBorde">#F2C9A3</Color>
  <Color x:Key="Color.AcentoTexto">#8A4410</Color>
  <Color x:Key="Color.Seleccion">#E8F0F9</Color>
  <Color x:Key="Color.SeleccionHover">#DFEAF6</Color>
  <Color x:Key="Color.Activa">#FFF3E6</Color>
  <Color x:Key="Color.Azul">#1D5C8C</Color>
  <Color x:Key="Color.AzulSuave">#E8F0F8</Color>
  <Color x:Key="Color.Verde">#1E6B45</Color>
  <Color x:Key="Color.VerdeSuave">#E2F0E8</Color>
  <Color x:Key="Color.VerdeBorde">#A9D2BB</Color>
  <Color x:Key="Color.Rojo">#B42318</Color>
  <Color x:Key="Color.RojoSaldo">#B3261E</Color>
  <Color x:Key="Color.RojoError">#C23B2A</Color>
  <Color x:Key="Color.RojoSuave">#FDF1EF</Color>
  <Color x:Key="Color.RojoCampo">#FFF7F6</Color>
  <Color x:Key="Color.RojoBorde">#EBC7C0</Color>
  <Color x:Key="Color.Ambar">#8A4410</Color>
  <Color x:Key="Color.AmbarSuave">#FFEBD6</Color>
  <Color x:Key="Color.Aviso">#7A5A00</Color>
  <Color x:Key="Color.AvisoSuave">#FFF6E0</Color>
  <Color x:Key="Color.AvisoBorde">#E2CF8F</Color>
  <Color x:Key="Color.Morado">#5B3F86</Color>
  <Color x:Key="Color.MoradoSuave">#ECE6F3</Color>
  <Color x:Key="Color.Nota">#F6F4EF</Color>
  <Color x:Key="Color.Sombra">#14213A</Color>

  <!-- Pinceles -->
  <SolidColorBrush x:Key="Pincel.Marino" Color="{StaticResource Color.Marino}" />
  <SolidColorBrush x:Key="Pincel.Marino2" Color="{StaticResource Color.Marino2}" />
  <SolidColorBrush x:Key="Pincel.Tinta" Color="{StaticResource Color.Tinta}" />
  <SolidColorBrush x:Key="Pincel.Texto2" Color="{StaticResource Color.Texto2}" />
  <SolidColorBrush x:Key="Pincel.Apagado" Color="{StaticResource Color.Apagado}" />
  <SolidColorBrush x:Key="Pincel.Apagado2" Color="{StaticResource Color.Apagado2}" />
  <SolidColorBrush x:Key="Pincel.Fondo" Color="{StaticResource Color.Fondo}" />
  <SolidColorBrush x:Key="Pincel.Fondo2" Color="{StaticResource Color.Fondo2}" />
  <SolidColorBrush x:Key="Pincel.Blanco" Color="{StaticResource Color.Blanco}" />
  <SolidColorBrush x:Key="Pincel.Linea" Color="{StaticResource Color.Linea}" />
  <SolidColorBrush x:Key="Pincel.Linea2" Color="{StaticResource Color.Linea2}" />
  <SolidColorBrush x:Key="Pincel.Linea3" Color="{StaticResource Color.Linea3}" />
  <SolidColorBrush x:Key="Pincel.Hover" Color="{StaticResource Color.Hover}" />
  <SolidColorBrush x:Key="Pincel.HoverBorde" Color="{StaticResource Color.HoverBorde}" />
  <SolidColorBrush x:Key="Pincel.CampoBorde" Color="{StaticResource Color.CampoBorde}" />
  <SolidColorBrush x:Key="Pincel.CampoFondo" Color="{StaticResource Color.CampoFondo}" />
  <SolidColorBrush x:Key="Pincel.Acento" Color="{StaticResource Color.Acento}" />
  <SolidColorBrush x:Key="Pincel.Acento2" Color="{StaticResource Color.Acento2}" />
  <SolidColorBrush x:Key="Pincel.Acento3" Color="{StaticResource Color.Acento3}" />
  <SolidColorBrush x:Key="Pincel.AcentoSuave" Color="{StaticResource Color.AcentoSuave}" />
  <SolidColorBrush x:Key="Pincel.AcentoBorde" Color="{StaticResource Color.AcentoBorde}" />
  <SolidColorBrush x:Key="Pincel.AcentoTexto" Color="{StaticResource Color.AcentoTexto}" />
  <SolidColorBrush x:Key="Pincel.Seleccion" Color="{StaticResource Color.Seleccion}" />
  <SolidColorBrush x:Key="Pincel.SeleccionHover" Color="{StaticResource Color.SeleccionHover}" />
  <SolidColorBrush x:Key="Pincel.Activa" Color="{StaticResource Color.Activa}" />
  <SolidColorBrush x:Key="Pincel.Azul" Color="{StaticResource Color.Azul}" />
  <SolidColorBrush x:Key="Pincel.AzulSuave" Color="{StaticResource Color.AzulSuave}" />
  <SolidColorBrush x:Key="Pincel.Verde" Color="{StaticResource Color.Verde}" />
  <SolidColorBrush x:Key="Pincel.VerdeSuave" Color="{StaticResource Color.VerdeSuave}" />
  <SolidColorBrush x:Key="Pincel.VerdeBorde" Color="{StaticResource Color.VerdeBorde}" />
  <SolidColorBrush x:Key="Pincel.Rojo" Color="{StaticResource Color.Rojo}" />
  <SolidColorBrush x:Key="Pincel.RojoSaldo" Color="{StaticResource Color.RojoSaldo}" />
  <SolidColorBrush x:Key="Pincel.RojoError" Color="{StaticResource Color.RojoError}" />
  <SolidColorBrush x:Key="Pincel.RojoSuave" Color="{StaticResource Color.RojoSuave}" />
  <SolidColorBrush x:Key="Pincel.RojoCampo" Color="{StaticResource Color.RojoCampo}" />
  <SolidColorBrush x:Key="Pincel.RojoBorde" Color="{StaticResource Color.RojoBorde}" />
  <SolidColorBrush x:Key="Pincel.Ambar" Color="{StaticResource Color.Ambar}" />
  <SolidColorBrush x:Key="Pincel.AmbarSuave" Color="{StaticResource Color.AmbarSuave}" />
  <SolidColorBrush x:Key="Pincel.Aviso" Color="{StaticResource Color.Aviso}" />
  <SolidColorBrush x:Key="Pincel.AvisoSuave" Color="{StaticResource Color.AvisoSuave}" />
  <SolidColorBrush x:Key="Pincel.AvisoBorde" Color="{StaticResource Color.AvisoBorde}" />
  <SolidColorBrush x:Key="Pincel.Morado" Color="{StaticResource Color.Morado}" />
  <SolidColorBrush x:Key="Pincel.MoradoSuave" Color="{StaticResource Color.MoradoSuave}" />
  <SolidColorBrush x:Key="Pincel.Nota" Color="{StaticResource Color.Nota}" />
  <SolidColorBrush x:Key="Pincel.Transparente" Color="Transparent" />
  <!-- Anillo de foco: acento al 35 % -->
  <SolidColorBrush x:Key="Pincel.Foco" Color="#59F4A259" />

  <!-- Radios -->
  <CornerRadius x:Key="Radio.Pequeno">5</CornerRadius>
  <CornerRadius x:Key="Radio.Campo">7</CornerRadius>
  <CornerRadius x:Key="Radio.Boton">8</CornerRadius>
  <CornerRadius x:Key="Radio.Menu">10</CornerRadius>
  <CornerRadius x:Key="Radio.Panel">12</CornerRadius>
  <CornerRadius x:Key="Radio.Dialogo">14</CornerRadius>
  <CornerRadius x:Key="Radio.Pastilla">999</CornerRadius>

  <!-- Alturas (px) -->
  <sys:Double x:Key="Alto.Boton">30</sys:Double>
  <sys:Double x:Key="Alto.BotonPequeno">26</sys:Double>
  <sys:Double x:Key="Alto.Campo">28</sys:Double>
  <sys:Double x:Key="Alto.Fila">30</sys:Double>
  <sys:Double x:Key="Alto.Cabecera">28</sys:Double>
  <sys:Double x:Key="Alto.Etiqueta">24</sys:Double>

  <!-- Sombras -->
  <DropShadowEffect x:Key="Sombra.Menu" Color="{StaticResource Color.Sombra}" Opacity="0.22" BlurRadius="30" ShadowDepth="10" Direction="270" />
  <DropShadowEffect x:Key="Sombra.Dialogo" Color="{StaticResource Color.Sombra}" Opacity="0.35" BlurRadius="60" ShadowDepth="20" Direction="270" />
  <DropShadowEffect x:Key="Sombra.Flotante" Color="{StaticResource Color.Sombra}" Opacity="0.18" BlurRadius="24" ShadowDepth="8" Direction="270" />
</ResourceDictionary>
