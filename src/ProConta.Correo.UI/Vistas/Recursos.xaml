<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pc="urn:proconta-ui">
  <!-- Composiciones de correo con los tokens de ProConta.UI.Base (sin colores propios). -->
  <pc:VisibleSiConverter x:Key="Visible" />

  <Style x:Key="Etiqueta.Campo" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Letra.Pequena}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Pincel.Texto2}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="Error.Campo" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Pincel.RojoError}" />
    <Setter Property="FontSize" Value="{StaticResource Letra.Pequena}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <Style x:Key="Tarjeta.Correo" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
</ResourceDictionary>
