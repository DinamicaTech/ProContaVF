<UserControl x:Class="ProConta.Correo.UI.Vistas.VistaRegistroCorreo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pc="urn:proconta-ui"
             Background="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Recursos.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding EnfocarBusquedaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    <KeyBinding Key="F5" Command="{Binding RefrescarCommand}" />
  </UserControl.InputBindings>

  <DockPanel>
    <!-- Cabecera: título, búsqueda y filtro de estado -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Pincel.Linea}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Boton.Enlace}" Content="Limpiar filtros" Command="{Binding LimpiarFiltrosCommand}" VerticalAlignment="Center"
                Visibility="{Binding HayFiltros, Converter={StaticResource Visible}}" ToolTip="Vacía la búsqueda y quita el filtro de estado" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Titulo}" Style="{StaticResource Texto.TituloPantalla}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <Grid Width="360" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBox x:Name="CajaBusqueda" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="28,0,6,0"
                     ToolTip="Busca en el asunto, los destinatarios y el origen (Ctrl+F)" AutomationProperties.Name="Buscar correo" />
            <Path Style="{StaticResource Icono.Trazo14}" Data="{StaticResource Icono.search}" HorizontalAlignment="Left" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
          <ComboBox Width="170" ItemsSource="{Binding OpcionesEstado}" SelectedItem="{Binding FiltroEstado}" VerticalAlignment="Center"
                    ToolTip="Estado del envío: en la cola, aceptado por el servidor, fallido, incierto o cancelado" />
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Margin="14,8,14,0">
      <pc:Nota Tipo="Info" Margin="0,0,0,6" Visibility="{Binding TituloFiltro, Converter={StaticResource Visible}}">
        <TextBlock TextWrapping="Wrap"><Run Text="{Binding TituloFiltro, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Cerrar esta ventana no cancela los envíos que sigan en la cola." /></TextBlock>
      </pc:Nota>
      <pc:Nota Tipo="Error" Margin="0,0,0,6" Visibility="{Binding HayNoPreparados, Converter={StaticResource Visible}}">
        <StackPanel>
          <TextBlock Text="No se han enviado porque no se han podido preparar:" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding NoPreparados}">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </pc:Nota>
      <pc:Nota Tipo="Aviso" Margin="0,0,0,6" Visibility="{Binding Desvio, Converter={StaticResource Visible}}">
        <TextBlock TextWrapping="Wrap"><Run Text="Correo de pruebas: todo lo que se envía sale solo a " /><Run Text="{Binding Desvio, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" (Parámetros y tablas › Configuración general)." /></TextBlock>
      </pc:Nota>
    </StackPanel>

    <!-- Pie -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Barra.Pie}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="Clic derecho: acciones · Ctrl o Mayús: seleccionar varios" Style="{StaticResource Texto.Apagado}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Resumen}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="480" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <pc:VistaEstado Estado="{Binding Estado}" Titulo="{Binding TituloEstado}" Mensaje="{Binding MensajeEstado}" TextoAccion="Actualizar" ComandoAccion="{Binding RefrescarCommand}">
        <pc:VistaEstado.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding TextoReintentar}" Command="{Binding ReintentarCommand}"
                      ToolTip="Vuelve a enviar ya los fallidos seleccionados, como otro intento del mismo mensaje (consta que no salieron)" />
            <MenuItem Header="{Binding TextoReenviar}" Command="{Binding ReenviarCommand}"
                      ToolTip="Envía otra vez los aceptados seleccionados como mensajes nuevos, enlazados al original: el destinatario los recibirá de nuevo" />
            <Separator />
            <MenuItem Header="Dar por enviado…" Command="{Binding DarPorEnviadoCommand}"
                      ToolTip="Para un incierto que sabes que llegó: lo marca como aceptado, con tu nombre y el motivo (solo con uno seleccionado)" />
            <MenuItem Header="Volver a enviar…" Command="{Binding VolverAEnviarCommand}"
                      ToolTip="Para un incierto que no llegó: lo envía otra vez, aceptando que podría llegar dos veces (solo con uno seleccionado)" />
            <Separator />
            <MenuItem Header="{Binding TextoCancelar}" Command="{Binding CancelarEnvioCommand}"
                      ToolTip="Saca de la cola los pendientes seleccionados que aún no se han empezado a enviar; los que ya se están enviando no se pueden detener" />
            <MenuItem Header="Abrir el origen" Command="{Binding AbrirOrigenCommand}" ToolTip="Abre la factura (u otro documento) de la que salió el mensaje (solo con uno seleccionado)" />
            <Separator />
            <MenuItem Header="Actualizar" Command="{Binding RefrescarCommand}" InputGestureText="F5" ToolTip="Vuelve a leer el registro de correo" />
          </ContextMenu>
        </pc:VistaEstado.ContextMenu>
        <pc:TablaProConta x:Name="Tabla" ItemsSource="{Binding Filas}" SelectedItem="{Binding Activa}" ClavePreferencias="correo.enviado" TituloExportacion="Correo enviado"
                          IsReadOnly="True" SelectionMode="Extended" SelectionChanged="Tabla_SelectionChanged" PreviewMouseRightButtonDown="Tabla_PreviewMouseRightButtonDown"
                          AutomationProperties.Name="Correo enviado">
          <pc:TablaProConta.Columns>
            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" SortMemberPath="FechaOrden" Width="118" ElementStyle="{StaticResource Texto.Celda.Mono}" pc:TablaProConta.Clave="fecha" />
            <DataGridTemplateColumn Header="Estado" Width="160" SortMemberPath="Estado" pc:TablaProConta.Clave="estado">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Estado}" ToolTip="{Binding AyudaEstado}" Style="{StaticResource Texto.Celda}">
                    <TextBlock.Resources>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Celda}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ConIncidencia}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Pincel.RojoError}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Resources>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Para" Binding="{Binding Para}" Width="220" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="para" />
            <DataGridTextColumn Header="Asunto" Binding="{Binding Asunto}" Width="*" MinWidth="160" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="asunto" />
            <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="180" ElementStyle="{StaticResource Texto.Celda}" pc:TablaProConta.Clave="origen" />
            <DataGridTextColumn Header="Intentos" Binding="{Binding Intentos}" Width="70" ElementStyle="{StaticResource Texto.Celda.Importe}" pc:TablaProConta.Clave="intentos" pc:TablaProConta.OcultaDeFabrica="True" />
            <DataGridTextColumn Header="Adj." Binding="{Binding Adjuntos}" Width="46" ElementStyle="{StaticResource Texto.Celda.Importe}" pc:TablaProConta.Clave="adjuntos" />
          </pc:TablaProConta.Columns>
        </pc:TablaProConta>
      </pc:VistaEstado>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource Pincel.Linea}" ResizeBehavior="PreviousAndNext"
                    ToolTip="Arrastra para repartir el ancho entre el registro y el detalle" />

      <!-- Detalle de solo lectura del mensaje activo -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{StaticResource Pincel.Fondo}">
        <StackPanel Margin="16,14">
          <TextBlock Text="Elige un mensaje para ver su detalle." Style="{StaticResource Texto.Apagado}" Visibility="{Binding HayDetalle, Converter={StaticResource Visible}, ConverterParameter=invertir}" />
          <StackPanel Visibility="{Binding HayDetalle, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Detalle.Asunto}" Style="{StaticResource Texto.Titulo}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DetalleEstado}" FontWeight="SemiBold" Margin="0,4,0,0" />
            <pc:Nota Tipo="Aviso" Margin="0,8,0,0" Visibility="{Binding DetalleError, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding DetalleError}" TextWrapping="Wrap" />
            </pc:Nota>
            <TextBlock Text="Contenido tal como se preparó (solo lectura)" Style="{StaticResource Texto.Apagado}" Margin="0,8,0,10" />

            <Border Style="{StaticResource Tarjeta.Correo}">
              <StackPanel>
                <TextBlock Text="De" Style="{StaticResource Etiqueta.Campo}" />
                <TextBlock Text="{Binding DetalleDe}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="Destinatarios" Style="{StaticResource Etiqueta.Campo}" />
                <ItemsControl ItemsSource="{Binding DetalleDestinatarios}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta.Correo}">
              <StackPanel>
                <TextBlock Text="Texto" Style="{StaticResource Etiqueta.Campo}" />
                <TextBox Text="{Binding DetalleCuerpo, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MaxHeight="260"
                         VerticalScrollBarVisibility="Auto" ToolTip="Texto que se envió; se puede seleccionar y copiar" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta.Correo}" Visibility="{Binding HayAdjuntos, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="Adjuntos enviados" Style="{StaticResource Etiqueta.Campo}" />
                <ItemsControl ItemsSource="{Binding DetalleAdjuntos}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Content="Abrir" Style="{StaticResource Boton.Enlace}"
                                Command="{Binding DataContext.AbrirAdjuntoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                ToolTip="Abre la copia exacta que se envió, con el programa predeterminado de Windows" />
                        <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Huella, StringFormat=Huella SHA-256: {0}}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta.Correo}">
              <StackPanel>
                <TextBlock Text="Intentos" Style="{StaticResource Etiqueta.Campo}" />
                <ItemsControl ItemsSource="{Binding DetalleIntentos}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="{StaticResource Letra.Pequena}" Margin="0,2" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding DetalleDatos}" Style="{StaticResource Texto.Apagado}" FontSize="{StaticResource Letra.Pequena}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
